    "# ============================================================\n",
    "# CELL 23 — PAIRED EVIT-CONCAT VS EVIT-CAF STATISTICAL TEST\n",
    "# ============================================================\n",
    "\n",
    "paired_comparison = {\n",
    "    'available': False,\n",
    "    'interpretation': (\n",
    "        'The paired test is descriptive for the held-out test set. '\n",
    "        'Model development and checkpoint selection remain validation-only.'\n",
    "    ),\n",
    "}\n",
    "\n",
    "comparison_seed = EXPERIMENT_SEEDS[0]\n",
    "\n",
    "concat_predictions_path = (\n",
    "    MODEL_DIR\n",
    "    / clean_model_name('EVit-Concat')\n",
    "    / f'seed_{comparison_seed}'\n",
    "    / 'testing_predictions.csv'\n",
    ")\n",
    "\n",
    "caf_predictions_path = (\n",
    "    MODEL_DIR\n",
    "    / clean_model_name('EVit-CAF-D2AF')\n",
    "    / f'seed_{comparison_seed}'\n",
    "    / 'testing_predictions.csv'\n",
    ")\n",
    "\n",
    "if concat_predictions_path.exists() and caf_predictions_path.exists():\n",
    "    concat_predictions = pd.read_csv(concat_predictions_path)\n",
    "    caf_predictions = pd.read_csv(caf_predictions_path)\n",
    "\n",
    "    if not np.array_equal(\n",
    "        concat_predictions['filepath'].to_numpy(),\n",
    "        caf_predictions['filepath'].to_numpy(),\n",
    "    ):\n",
    "        raise ValueError(\n",
    "            'EVit-Concat and EVit-CAF-D2AF prediction rows are not aligned.'\n",
    "        )\n",
    "\n",
    "    true_labels = concat_predictions['true_label'].to_numpy()\n",
    "    concat_labels = concat_predictions['predicted_label'].to_numpy()\n",
    "    caf_labels = caf_predictions['predicted_label'].to_numpy()\n",
    "\n",
    "    concat_correct = concat_labels == true_labels\n",
    "    caf_correct = caf_labels == true_labels\n",
    "\n",
    "    concat_only_correct = int(\n",
    "        np.sum(concat_correct & ~caf_correct)\n",
    "    )\n",
    "\n",
    "    caf_only_correct = int(\n",
    "        np.sum(~concat_correct & caf_correct)\n",
    "    )\n",
    "\n",
    "    discordant_pairs = concat_only_correct + caf_only_correct\n",
    "\n",
    "    if discordant_pairs > 0:\n",
    "        exact_test = binomtest(\n",
    "            min(concat_only_correct, caf_only_correct),\n",
    "            n=discordant_pairs,\n",
    "            p=0.5,\n",
    "            alternative='two-sided',\n",
    "        )\n",
    "        p_value = float(exact_test.pvalue)\n",
    "    else:\n",
    "        p_value = 1.0\n",
    "\n",
    "    rng = np.random.default_rng(SEED)\n",
    "    bootstrap_differences = []\n",
    "    sample_count = len(true_labels)\n",
    "\n",
    "    for _ in range(5000):\n",
    "        indices = rng.integers(0, sample_count, size=sample_count)\n",
    "\n",
    "        concat_accuracy = np.mean(\n",
    "            concat_labels[indices] == true_labels[indices]\n",
    "        )\n",
    "\n",
    "        caf_accuracy = np.mean(\n",
    "            caf_labels[indices] == true_labels[indices]\n",
    "        )\n",
    "\n",
    "        bootstrap_differences.append(\n",
    "            caf_accuracy - concat_accuracy\n",
    "        )\n",
    "\n",
    "    confidence_interval = np.percentile(\n",
    "        bootstrap_differences,\n",
    "        [2.5, 97.5],\n",
    "    )\n",
    "\n",
    "    paired_comparison.update(\n",
    "        {\n",
    "            'available': True,\n",
    "            'seed': comparison_seed,\n",
    "            'test_samples': sample_count,\n",
    "            'concat_correct_caf_wrong': concat_only_correct,\n",
    "            'caf_correct_concat_wrong': caf_only_correct,\n",
    "            'discordant_pairs': discordant_pairs,\n",
    "            'exact_mcnemar_p_value': p_value,\n",
    "            'caf_minus_concat_accuracy': float(\n",
    "                np.mean(caf_correct) - np.mean(concat_correct)\n",
    "            ),\n",
    "            'bootstrap_95_percent_ci_for_accuracy_difference': [\n",
    "                float(confidence_interval[0]),\n",
    "                float(confidence_interval[1]),\n",
    "            ],\n",
    "        }\n",
    "    )\n",
    "\n",
    "with open(\n",
    "    TABLE_DIR / 'evit_concat_vs_evit_caf_paired_comparison.json',\n",
    "    'w',\n",
    "    encoding='utf-8',\n",
    ") as file:\n",
    "    json.dump(paired_comparison, file, indent=2)\n",
    "\n",
    "print(json.dumps(paired_comparison, indent=2))\n",
    "\n",
    "save_cell_summary(\n",
    "    'cell_22_paired_statistical_test',\n",
    "    paired_comparison,\n",
    ")"
   ]
