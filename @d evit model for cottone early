     expected_shape = (1, NUM_CLASSES)\n","\n","        if tuple(predictions.shape) != expected_shape:\n","            raise ValueError(\n","                f\"Incorrect output shape: \"\n","                f\"{predictions.shape}; \"\n","                f\"expected {expected_shape}\"\n","            )\n","\n","        if not np.all(np.isfinite(prediction_values)):\n","            raise ValueError(\n","                \"Model predictions contain NaN or Inf.\"\n","            )\n","\n","        if not np.allclose(\n","            prediction_values.sum(axis=1),\n","            1.0,\n","            atol=1e-4,\n","        ):\n","            raise ValueError(\n","                \"Softmax probabilities do not sum to 1.\"\n","            )\n","\n","        # ----------------------------------------------------\n","        # STEP 5 — SAVE ARCHITECTURE\n","        # ----------------------------------------------------\n","\n","        print(\"[5/5] Saving architecture...\", flush=True)\n","\n","        architecture_directory = (\n","            MODEL_DIR / clean_model_name(model_name)\n","        )\n","\n","        architecture_directory.mkdir(\n","            parents=True,\n","            exist_ok=True,\n","        )\n","\n","        summary_path = (\n","            architecture_directory\n","            / \"architecture_summary.txt\"\n","        )\n","\n","        with open(\n","            summary_path,\n","            \"w\",\n","            encoding=\"utf-8\",\n","        ) as file:\n","\n","            model.summary(\n","                print_fn=lambda line: file.write(\n","                    line + \"\\n\"\n","                )\n","            )\n","\n","        RUNNABLE_MODEL_NAMES.add(model_name)\n","\n","        architecture_rows.append({\n","            \"model\": model_name,\n","            \"status\": \"passed\",\n","            \"parameters\": parameter_count,\n","            \"pretrained_loaded\": bool(pretrained),\n","            \"output_shape\": str(predictions.shape),\n","            \"error_type\": None,\n","            \"error_message\": None,\n","        })\n","\n","        print(\n","            f\"SUCCESS: {model_name} passed all checks.\",\n","            flush=True,\n","        )\n","\n","    except Exception as error:\n","\n","        error_type = type(error).__name__\n","        error_message = str(error)\n","\n","        full_traceback = traceback.format_exc()\n","\n","        architecture_rows.append({\n","            \"model\": model_name,\n","            \"status\": \"failed\",\n","            \"parameters\": np.nan,\n","            \"pretrained_loaded\": False,\n","            \"output_shape\": None,\n","            \"error_type\": error_type,\n","            \"error_message\": error_message,\n","        })\n","\n","        print(\"\\nMODEL FAILED\")\n","        print(\"Model:\", model_name)\n","        print(\"Error type:\", error_type)\n","        print(\"Error message:\", error_message)\n","        print(\"\\nFULL TRACEBACK:\")\n","        print(full_traceback, flush=True)\n","\n","        failure_directory = (\n","            MODEL_DIR / clean_model_name(model_name)\n","        )\n","\n","        failure_directory.mkdir(\n","            parents=True,\n","            exist_ok=True,\n","        )\n","\n","        with open(\n","            failure_directory / \"smoke_test_failure.txt\",\n","            \"w\",\n","            encoding=\"utf-8\",\n","        ) as file:\n","            file.write(full_traceback)\n","\n","    finally:\n","\n","        if model is not None:\n","            del model\n","\n","        if backbone is not None:\n","            del backbone\n","\n","        tf.keras.backend.clear_session()\n","        gc.collect()\n","\n","\n","# ============================================================\n","# SUMMARY TABLE\n","# ============================================================\n","\n","architecture_df = pd.DataFrame(\n","    architecture_rows\n",")\n","\n","architecture_df.to_csv