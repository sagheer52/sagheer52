    "# ============================================================\n",
    "# CELL 18 — OPTIONAL POST-TRAINING LATENCY BENCHMARK\n",
    "# ============================================================\n",
    "\n",
    "latency_rows = []\n",
    "\n",
    "if RUN_LATENCY_BENCHMARK:\n",
    "    configuration_by_name = {\n",
    "        item['name']: item\n",
    "        for item in MODEL_CONFIGS\n",
    "    }\n",
    "\n",
    "    for result_index, result_row in results_df.iterrows():\n",
    "        model_name = result_row['model']\n",
    "        seed = int(result_row['seed'])\n",
    "        run_directory = (\n",
    "            MODEL_DIR\n",
    "            / clean_model_name(model_name)\n",
    "            / f'seed_{seed}'\n",
    "        )\n",
    "        weights_path = run_directory / 'best_model.weights.h5'\n",
    "        metrics_path = run_directory / 'complete_metrics.json'\n",
    "\n",
    "        if not weights_path.exists():\n",
    "            print(\n",
    "                f'Latency skipped for {model_name}: weights missing.',\n",
    "                flush=True,\n",
    "            )\n",
    "            continue\n",
    "\n",
    "        model = None\n",
    "        backbone = None\n",
    "\n",
    "        try:\n",
    "            show_progress(f'{model_name}: post-training latency benchmark')\n",
    "            (\n",
    "                model,\n",
    "                backbone,\n",
    "                _,\n",
    "            ) = build_model_for_weight_recovery(\n",
    "                configuration_by_name[model_name]['builder']\n",
    "            )\n",
    "            model.load_weights(weights_path)\n",
    "\n",
    "            latency_value = measure_inference_latency_safe(\n",
    "                model,\n",
    "                test_ds,\n",
    "                number_of_images=min(LATENCY_IMAGES, len(test_df)),\n",
    "                warmup_batches=LATENCY_WARMUP_BATCHES,\n",
    "                repetitions=LATENCY_REPETITIONS,\n",
    "            )\n",
    "\n",
    "            results_df.loc[\n",
    "                result_index,\n",
    "                'latency_ms_per_image',\n",
    "            ] = latency_value\n",
    "\n",
    "            with open(metrics_path, 'r', encoding='utf-8') as file:\n",
    "                saved_metrics = json.load(file)\n",
    "            saved_metrics['latency_ms_per_image'] = latency_value\n",
    "            with open(metrics_path, 'w', encoding='utf-8') as file:\n",
    "                json.dump(\n",
    "                    make_json_serializable(saved_metrics),\n",
    "                    file,\n",
    "                    indent=2,\n",
    "                )\n",
    "\n",
    "            latency_rows.append(\n",
    "                {\n",
    "                    'model': model_name,\n",
    "                    'seed': seed,\n",
    "                    'latency_ms_per_image': latency_value,\n",
    "                }\n",
    "            )\n",
    "\n",
    "        except Exception as error:\n",
    "            print(\n",
    "                f'Latency benchmark failed for {model_name}; continuing: '\n",
    "                f'{error!r}',\n",
    "                flush=True,\n",
    "            )\n",
    "            latency_rows.append(\n",
    "                {\n",
    "                    'model': model_name,\n",
    "                    'seed': seed,\n",
    "                    'latency_ms_per_image': float('nan'),\n",
    "                    'error': repr(error),\n",
    "                }\n",
    "            )\n",
    "\n",
    "        finally:\n",
    "            if model is not None:\n",
    "                del model\n",
    "            if backbone is not None:\n",
    "                del backbone\n",
    "            gc.collect()\n",
    "            tf.keras.backend.clear_session()\n",
    "\n",
    "    results_df.to_csv(\n",
    "        TABLE_DIR / 'all_run_results_with_latency.csv',\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "    latency_df = pd.DataFrame(latency_rows)\n",
    "    latency_df.to_csv(\n",
    "        TABLE_DIR / 'latency_benchmark.csv',\n",
    "        index=False,\n",
    "    )\n",
    "    display(latency_df)\n",
    "else:\n",
    "    print(\n",
    "        'Latency benchmark disabled. Classification tables and figures '\n",
    "        'will still be generated.',\n",
    "        flush=True,\n",
    "    )\n",
    "\n",
    "save_cell_summary(\n",
    "    'cell_18_optional_latency',\n",
    "    {\n",
    "        'enabled': RUN_LATENCY_BENCHMARK,\n",
    "        'benchmarked_runs': len(latency_rows),\n",
    "        'failure_is_non_fatal': True,\n",
    "        'table': TABLE_DIR / 'latency_benchmark.csv',\n",
    "    },\n",
    ")"
