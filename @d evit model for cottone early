    "\n",
    "# LOAD TRAIN AND OFFICIAL TEST DATA\n",
    "\n",
    "IMAGE_EXTENSIONS = {'.jpg', '.jpeg', '.png', '.bmp', '.webp'}\n",
    "\n",
    "\n",
    "def class_directories_with_images(folder_path: Path) -> List[Path]:\n",
    "    directories = []\n",
    "\n",
    "    for directory in folder_path.iterdir():\n",
    "        if not directory.is_dir():\n",
    "            continue\n",
    "\n",
    "        has_image = any(\n",
    "            path.is_file()\n",
    "            and path.suffix.lower() in IMAGE_EXTENSIONS\n",
    "            for path in directory.rglob('*')\n",
    "        )\n",
    "\n",
    "        if has_image:\n",
    "            directories.append(directory)\n",
    "\n",
    "    return sorted(directories, key=lambda directory: directory.name)\n",
    "\n",
    "\n",
    "def build_dataframe_from_folder(\n",
    "    folder_path: Path,\n",
    "    class_to_index: Optional[Dict[str, int]] = None,\n",
    ") -> Tuple[pd.DataFrame, List[str], Dict[str, int]]:\n",
    "    if not folder_path.exists():\n",
    "        raise FileNotFoundError(f'Folder not found: {folder_path}')\n",
    "\n",
    "    class_directories = class_directories_with_images(folder_path)\n",
    "    class_names = [directory.name for directory in class_directories]\n",
    "\n",
    "    if len(class_names) < 2:\n",
    "        raise ValueError(\n",
    "            f'At least two image class folders are required in {folder_path}'\n",
    "        )\n",
    "\n",
    "    if class_to_index is None:\n",
    "        class_to_index = {\n",
    "            class_name: class_index\n",
    "            for class_index, class_name in enumerate(class_names)\n",
    "        }\n",
    "    else:\n",
    "        if set(class_names) != set(class_to_index):\n",
    "            raise ValueError(\n",
    "                'Training and testing class folders do not match. '\n",
    "                f'Train classes: {sorted(class_to_index)}; '\n",
    "                f'Test classes: {sorted(class_names)}'\n",
    "            )\n",
    "\n",
    "    records = []\n",
    "\n",
    "    for class_directory in class_directories:\n",
    "        class_name = class_directory.name\n",
    "        class_index = class_to_index[class_name]\n",
    "\n",
    "        for image_path in class_directory.rglob('*'):\n",
    "            if (\n",
    "                image_path.is_file()\n",
    "                and image_path.suffix.lower() in IMAGE_EXTENSIONS\n",
    "            ):\n",
    "                records.append(\n",
    "                    {\n",
    "                        'filepath': str(image_path),\n",
    "                        'label': class_index,\n",
    "                        'class_name': class_name,\n",
    "                    }\n",
    "                )\n",
    "\n",
    "    dataframe = pd.DataFrame(records)\n",
    "\n",
    "    if dataframe.empty:\n",
    "        raise ValueError(f'No supported images found in {folder_path}')\n",
    "\n",
    "    return dataframe, class_names, class_to_index\n",
    "\n",
    "\n",
    "train_df_full, class_names, class_to_index = (\n",
    "    build_dataframe_from_folder(TRAIN_FOLDER)\n",
    ")\n",
    "\n",
    "test_df, test_class_names, _ = build_dataframe_from_folder(\n",
    "    TEST_FOLDER,\n",
    "    class_to_index=class_to_index,\n",
    ")\n",
    "\n",
    "NUM_CLASSES = len(class_names)\n",
    "\n",
    "train_df_full.to_csv(\n",
    "    TABLE_DIR / 'all_training_folder_images.csv',\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "test_df.to_csv(\n",
    "    TABLE_DIR / 'official_test_images.csv',\n",
    "    index=False,\n",
    ")\n",
    "\n",
