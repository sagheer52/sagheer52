    "\n",
    "# ============================================================\n",
    "# CELL 11 — ROBUST SMOKE TESTS AND ARCHITECTURE SUMMARIES\n",
    "# ============================================================\n",
    "\n",
    "architecture_rows = []\n",
    "RUNNABLE_MODEL_NAMES = set()\n",
    "\n",
    "for model_configuration in MODEL_CONFIGS:\n",
    "    model_name = model_configuration['name']\n",
    "\n",
    "    if model_name not in MODELS_TO_RUN:\n",
    "        continue\n",
    "\n",
    "    tf.keras.backend.clear_session()\n",
    "    gc.collect()\n",
    "\n",
    "    model = None\n",
    "    backbone = None\n",
    "\n",
    "    try:\n",
    "        show_progress(f'Smoke-testing {model_name}')\n",
    "\n",
    "        model, backbone, pretrained_loaded = (\n",
    "            model_configuration['builder']()\n",
    "        )\n",
    "\n",
    "        output = model(\n",
    "            sample_images[:1],\n",
    "            training=False,\n",
    "        )\n",
    "\n",
    "        if int(output.shape[-1]) != NUM_CLASSES:\n",
    "            raise ValueError(\n",
    "                f'{model_name} output classes '\n",
    "                f'{output.shape[-1]} != {NUM_CLASSES}'\n",
    "            )\n",
    "\n",
    "        architecture_directory = (\n",
    "            MODEL_DIR\n",
    "            / clean_model_name(model_name)\n",
    "        )\n",
    "        architecture_directory.mkdir(\n",
    "            parents=True,\n",
    "            exist_ok=True,\n",
    "        )\n",
    "\n",
    "        with open(\n",
    "            architecture_directory / 'architecture_summary.txt',\n",
    "            'w',\n",
    "            encoding='utf-8',\n",
    "        ) as file:\n",
    "            model.summary(\n",
    "                print_fn=lambda line: file.write(line + '\\n'),\n",
    "                line_length=140,\n",
    "            )\n",
    "\n",
    "        RUNNABLE_MODEL_NAMES.add(model_name)\n",
    "\n",
    "        architecture_rows.append(\n",
    "            {\n",
    "                'model': model_name,\n",
    "                'group': model_configuration['group'],\n",
    "                'status': 'passed',\n",
    "                'parameters': int(model.count_params()),\n",
    "                'pretrained_loaded': bool(pretrained_loaded),\n",
    "                'output_shape': str(output.shape),\n",
    "            }\n",
    "        )\n",
    "\n",
    "    except Exception as error:\n",
    "        architecture_rows.append(\n",
    "            {\n",
    "                'model': model_name,\n",
    "                'group': model_configuration['group'],\n",
    "                'status': 'failed',\n",
    "                'parameters': np.nan,\n",
    "                'pretrained_loaded': False,\n",
    "                'output_shape': None,\n",
    "                'error': repr(error),\n",
    "            }\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            f'Smoke test failed for {model_name}: {error}',\n",
    "            flush=True,\n",
    "        )\n",
    "\n",
    "    finally:\n",
    "        if model is not None:\n",
    "            del model\n",
    "\n",
    "        if backbone is not None:\n",
    "            del backbone\n",
    "\n",
    "        gc.collect()\n",
    "        tf.keras.backend.clear_session()\n",
