    "    \"\"\"Build architecture without downloading ImageNet weights.\"\"\"\n",
    "    global USE_IMAGENET_WEIGHTS\n",
    "    previous_value = USE_IMAGENET_WEIGHTS\n",
    "    USE_IMAGENET_WEIGHTS = False\n",
    "    try:\n",
    "        return builder_function()\n",
    "    finally:\n",
    "        USE_IMAGENET_WEIGHTS = previous_value\n",
    "\n",
    "\n",
    "for experiment_seed in EXPERIMENT_SEEDS:\n",
    "    set_global_seed(experiment_seed)\n",
    "\n",
    "    # Recreate the shuffled training pipeline for each seed.\n",
    "    train_fit_ds = create_tf_dataset(\n",
    "        train_df,\n",
    "        training=True,\n",
    "        augment=True,\n",
    "        seed=experiment_seed,\n",
    "    )\n",
    "\n",
    "    for model_configuration in MODEL_CONFIGS:\n",
    "        model_name = model_configuration['name']\n",
    "\n",
    "        if model_name not in MODELS_TO_RUN:\n",
    "            continue\n",
    "\n",
    "        if model_name not in RUNNABLE_MODEL_NAMES:\n",
    "            print(\n",
    "                f'Skipping unavailable model: {model_name}',\n",
    "                flush=True,\n",
    "            )\n",
    "            continue\n",
    "\n",
    "        run_directory = (\n",
    "            MODEL_DIR\n",
    "            / clean_model_name(model_name)\n",
    "            / f'seed_{experiment_seed}'\n",
    "        )\n",
    "        run_directory.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "        metrics_path = run_directory / 'complete_metrics.json'\n",
    "        history_path = run_directory / 'combined_history.csv'\n",
    "        final_weights_path = run_directory / 'best_model.weights.h5'\n",
    "        selection_path = (\n",
    "            run_directory\n",
    "            / 'training_selection_summary.json'\n",
    "        )\n",
    "\n",
    "        if (\n",
    "            RESUME_COMPLETED_MODELS\n",
    "            and metrics_path.exists()\n",
    "            and history_path.exists()\n",
    "        ):\n",
    "            show_progress(\n",
    "                f'Skipping completed model: {model_name}, '\n",
    "                f'seed {experiment_seed}'\n",
    "            )\n",
    "            with open(metrics_path, 'r', encoding='utf-8') as file:\n",
    "                all_results.append(json.load(file))\n",
    "            all_histories[(model_name, experiment_seed)] = (\n",
    "                pd.read_csv(history_path)\n",
    "            )\n",
    "            continue\n",
    "\n",
    "        model = None\n",
    "        backbone = None\n",
