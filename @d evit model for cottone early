e),\n","            seed=seed,\n","            reshuffle_each_iteration=True,\n","        )\n","\n","    ds = ds.map(\n","        decode_image,\n","        num_parallel_calls=AUTOTUNE,\n","    )\n","\n","    if training:\n","        ds = ds.enumerate()\n","\n","        def augment_one(index, pair):\n","\n","            image, label = pair\n","\n","            random_seed = tf.stack([\n","                tf.cast(seed, tf.int32),\n","                tf.cast(index, tf.int32),\n","            ])\n","\n","            image = tf.image.stateless_random_flip_left_right(\n","                image,\n","                seed=random_seed,\n","            )\n","\n","            image = tf.image.stateless_random_brightness(\n","                image,\n","                max_delta=10.0,\n","                seed=random_seed + [5, 11],\n","            )\n","\n","            image = tf.image.stateless_random_contrast(\n","                image,\n","                lower=0.85,\n","                upper=1.15,\n","                seed=random_seed + [13, 17],\n","            )\n","\n","            image = tf.clip_by_value(\n","                image, 0.0, 255.0\n","            )\n","\n","            return image, label\n","\n","        ds = ds.map(\n","            augment_one,\n","            num_parallel_calls=AUTOTUNE,\n","        )\n","\n","    options = tf.data.Options()\n","    options.experimental_deterministic = True\n","\n","    ds = ds.batch(\n","        BATCH_SIZE,\n","        drop_remainder=False,\n","    )\n","\n","    return ds.with_options(options).prefetch(\n","        AUTOTUNE\n","    )\n","\n","\n","train_eval_ds = make_dataset(\n","    train_df,\n","    training=False,\n",")\n","\n","validation_ds = make_dataset(\n","    validation_df,\n","    training=False,\n",")\n","\n","test_ds = make_dataset(\n","    test_df,\n","    training=False,\n",")\n","\n","\n","def calculate_class_weights(dataframe):\n","\n","    if not USE_CLASS_WEIGHTS:\n","        return None\n","\n","    labels = dataframe[\"label\"].to_numpy()\n","\n","    weights = compute_class_weight(\n","        class_weight=\"balanced\",\n","        classes=np.arange(NUM_CLASSES),\n","        y=labels,\n","    )\n","\n","    return {\n","        int(index): float(weight)\n","        for index, weight in enumerate(weights)\n","    }\n","\n","\n","class_weights = calculate_class_weights(\n","    train_df\n",")\n","\n","sample_images, sample_labels = next(\n","    iter(make_dataset(train_df, True, SEED))\n",")\n","\n","print(\"Sample shape:\", sample_images.shape)\n","print(\"Class weights:\", class_weights)\n","print(\"Classes:\", NUM_CLASSES)\n","\n","save_cell_summary(\n","    \"cell_03_pipeline\",\n","    {\n","        \"sample_shape\": sample_images.shape.as_list(),\n","        \"class_weights\": class_weights,\n","        \"training_batches\": int(\n","            tf.data.experimental.cardinality(\n","                make_dataset(train_df, True, SEED)\n","            ).numpy()\n","        ),\n","    },\n",")"]},{"cell_type":"code","execution_count":4,"id":"41d6d980","metadata":{"execution":{"iopub.execute_input":"2026-10-26T16:57:26.580977Z","iopub.status.busy":"2026-10-26T16:57:26.580723Z","iopub.status.idle":"2026-10-26T16:57:26.640013Z","shell.execute_reply":"2026-10-26T16:57:26.639166Z"},"papermill":{"duration":0.066069,"end_time":"2026-10-26T16:57:26.641386+00:00","exception":false,"start_time":"2026-10-26T16:57:26.575317+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Cell 04 complete: Custom layers registered.\n"]}],"source":["# ============================================================\n","# CELL 04 — CUSTOM MODEL LAYERS\n","# ============================================================\n","\n","@tf.keras.utils.register_keras_serializable()\n","class Patches(layers.Layer):\n","    def __init__(self, patch_size, **kwargs):\n","        super().__init__(**kwargs)\n","        self.patch_size = int(patch_size)\n","    def call(self, images):\n","        p = self.patch_size\n","        patches = tf.image.extract_patches(\n","            images=images,\n","            sizes=[1, p, p, 1],\n","            strides=[1, p, p, 1],\n","            rates=[1, 1, 1, 1],\n","            padding=\"VALID\",\n","        )\n","        batch = tf.shape(images)[0]\n","        dimension = p * p * int(images.shape[-1])\n","        return tf.reshape(\n","            patches,\n","            [batch, -1, dimension],\n","        )\n","    def get_config(self):\n","        return {\n","            **super().get_config(),\n","            \"patch_size\": self.patch_size,\n","        }\n","\n","\n","@tf.keras.utils.register_keras_serializable()\n","class PatchEncoder(layers.Layer):\n","    def __init__(\n","        self,\n","        num_patches,\n","        projection_dim,\n","        **kwargs,\n","    ):\n","        super().__init__(**kwargs)\n","        self.num_patches = int(num_patches)\n","        self.projection_dim = int(projection_dim)\n","        self.projection = layers.Dense(\n","            projection_dim\n","        )\n","        self.position_embedding = layers.Embedding(\n","            input_dim=num_patches,\n","            output_dim=projection_dim,\n","        )\n","    def call(self, patches):\n","        positions = tf.range(self.num_patches)\n","        return (\n","            self.projection(patches)\n","            + self.position_embedding(positions)\n","        )\n","    def get_config(self):\n","        return {\n","            **super().get_config(),\n","            \"num_patches\": self.num_patches,\n","            \"projection_dim\": self.projection_dim,\n","        }\n","\n","@tf.keras.utils.register_keras_serializable()\n","class TransformerEncoder(layers.Layer):\n","    def __init__(\n","        self,\n","        projection_dim,\n","        num_heads,\n","        mlp_dim,\n","        dropout_rate=0.1,\n","        **kwargs,\n","    ):\n","        super().__init__(**kwargs)\n","        self.projection_dim = projection_dim\n","        self.num_heads = num_heads\n","        self.mlp_dim = mlp_dim\n","        self.dropout_rate = dropout_rate\n","        self.norm1 = layers.LayerNormalization(\n","            epsilon=1e-6\n","        )\n","        self.attention = layers.MultiHeadAttention(\n","            num_heads=num_heads,\n","            key_dim=projection_dim // num_heads,\n","            dropout=dropout_rate,\n","        )\n","\n","        self.dropout1 = layers.Dropout(dropout_rate)\n","        self.norm2 = layers.LayerNormalization(\n","            epsilon=1e-6\n","        )\n","        self.mlp = tf.keras.Sequential([\n","            layers.Dense(\n","                mlp_dim,\n","                activation=\"gelu\",\n","            ),\n","            layers.Dropout(dropout_rate),\n","            layers.Dense(projection_dim),\n","            layers.Dropout(dropout_rate),\n","        ])\n","\n","    def call(self, inputs, training=None):\n","        x = self.norm1(inputs)\n","        attention = self.attention(\n","            x, x,\n","            training=training,\n","        )\n","\n","        x = inputs + self.dropout1(\n","            attention,\n","            training=training,\n","        )\n","        mlp_output = self.mlp(\n","            self.norm2(x),\n","            training=training,\n","        )\n","        return x + mlp_output\n","    def get_config(self):\n","        return {\n","            **super().get_config(),\n","            \"projection_dim\": self.projection_dim,\n","            \"num_heads\": self.num_heads,\n","            \"mlp_dim\": self.mlp_dim,\n","            \"dropout_rate\": self.dropout_rate,\n","        }\n","\n","\n","\n","# SPARSE LABEL-SMOOTHING LOSS\n","\n","@tf.keras.utils.register_keras_serializable()\n","class SparseLabelSmoothingCrossentropy(\n","    tf.keras.losses.Loss\n","):\n","    def __init__(\n","        self,\n","        num_classes,\n","        label_smoothing=0.0,\n","        name=\"sparse_label_smoothing_crossentropy\",\n","        **kwargs,\n","    ):\n","        super().__init__(name=name, **kwargs)\n","        self.num_classes = int(num_classes)\n","        self.label_smoothing = float(label_smoothing)\n","\n","    def call(self, y_true, y_pred):\n","        y_true = tf.cast(\n","            tf.reshape(y_true, [-1]),\n","            tf.int32,\n","        )\n","        one_hot = tf.one_hot(\n","            y_true,\n","            depth=self.num_classes,\n","            dtype=y_pred.dtype,\n","        )\n","        return tf.keras.losses.categorical_crossentropy(\n","            one_hot,\n","            y_pred,\n","            label_smoothing=self.label_smoothing,\n","        )\n","    def get_config(self):\n","        return {\n","            **super().get_config(),\n","            \"num_classes\": self.num_classes,\n","            \"label_smoothing\": self.label_smoothing,\n","        }\n","\n","\n","# STREAMING MACRO F1\n","\n","@tf.keras.utils.register_keras_serializable()\n","class SparseMacroF1(tf.keras.metrics.Metric):\n","    def __init__(\n","        self,\n","        num_classes,\n","        name=\"macro_f1\",\n","        **kwargs,\n","    ):\n","        super().__init__(name=name, **kwargs)\n","        self.num_classes = int(num_classes)\n","        self.matrix = self.add_weight(\n","            name=\"confusion_matrix\",\n","            shape=(num_classes, num_classes),\n","            initializer=\"zeros\",\n","            dtype=tf.float32,\n","        )\n","\n","    def update_state(\n","        self,\n","        y_true,\n","        y_pred,\n","        sample_weight=None,\n","    ):\n","        y_true = tf.cast(\n","            tf.reshape(y_true, [-1]),\n","            tf.int32,\n","        )\n","        y_pred = tf.argmax(\n","            y_pred,\n","            axis=-1,\n","            output_type=tf.int32,\n","        )\n","        weights = None\n","        if sample_weight is not None:\n","            weights = tf.cast(\n","                tf.reshape(sample_weight, [-1]),\n","                tf.float32,\n","            )\n","\n","        batch_matrix = tf.math.confusion_matrix(\n","            y_true,\n","            tf.reshape(y_pred, [-1]),\n","            num_classes=self.num_classes,\n","            weights=weights,\n","            dtype=tf.float32,\n","        )\n","        self.matrix.assign_add(batch_matrix)\n","    def result(self):\n","        tp = tf.linalg.diag_part(self.matrix)\n","        fp = tf.reduce_sum(\n","            self.matrix, axis=0\n","        ) - tp\n","\n","        fn = tf.reduce_sum(\n","            self.matrix, axis=1\n","        ) - tp\n","        precision = tf.math.divide_no_nan(\n","            tp, tp + fp\n","        )\n","        recall = tf.math.divide_no_nan(\n","            tp, tp + fn\n","        )\n","        f1 = tf.math.divide_no_nan(\n","            2.0 * precision * recall,\n","            precision + recall,\n","        )\n","        return tf.reduce_mean(f1)\n","\n","    def reset_state(self):\n","        self.matrix.assign(\n","            tf.zeros_like(self.matrix)\n","        )\n","\n","    def get_config(self):\n","        return {\n","            **super().get_config(),\n","            \"num_classes\": self.num_classes,\n","        }\n","\n","\n","# MULTI-SCALE DISEASE-AREA DECOUPLER\n","\n","@tf.keras.utils.register_keras_serializable()\n","class MultiScaleDiseaseAreaDecoupler(layers.Layer):\n","    def __init__(\n","        self,\n","        hidden_dim=48,\n","        min_area=0.03,\n","        max_area=0.45,\n","        area_loss_weight=1e-3,\n","        tv_loss_weight=1e-5,\n","        **kwargs,\n","    ):\n","        super().__init__(**kwargs)\n","        self.hidden_dim = int(hidden_dim)\n","        self.min_area = float(min_area)\n","        self.max_area = float(max_area)\n","        self.area_loss_weight = float(area_loss_weight)\n","        self.tv_loss_weight = float(tv_loss_weight)\n","        self.local_branch = layers.SeparableConv2D(\n","            hidden_dim,\n","            3,\n","            padding=\"same\",\n","            activation=\"swish\",\n","        )\n","\n","        self.dilated_branch = layers.SeparableConv2D(\n","            hidden_dim,\n","            3,\n","            padding=\"same\",\n","            dilation_rate=2,\n","            activation=\"swish\",\n","        )\n","        self.point_branch = layers.Conv2D(\n","            hidden_dim,\n","            1,\n","            activation=\"swish\",\n","        )\n","        self.fusion = layers.Conv2D(\n","            hidden_dim,\n","            1,\n","            activation=\"swish\",\n","        )\n","        self.mask_head = layers.Conv2D(\n","            1,\n","            1,\n","            activation=\"sigmoid\",\n","            bias_initializer=(\n","                tf.keras.initializers.Constant(-1.1)\n","            ),\n","        )\n","\n","    def call(self, feature_map):\n","        local = self.local_branch(feature_map)\n","        dilated = self.dilated_branch(feature_map)\n","        point = self.point_branch(feature_map)\n","        combined = tf.concat(\n","            [local, dilated, point],\n","            axis=-1,\n","        )\n","        perception = self.fusion(combined)\n","        mask = self.mask_head(perception)\n","        mask_float = tf.cast(mask, tf.float32)\n","        area = tf.reduce_mean(\n","            mask_float,\n","            axis=[1, 2, 3],\n","        )\n","        area_penalty = (\n","            tf.square(\n","                tf.nn.relu(self.min_area - area)\n","            )\n","            + tf.square(\n","                tf.nn.relu(area - self.max_area)\n","            )\n","        )\n","\n","        spatial_size = tf.cast(\n","            tf.shape(mask_float)[1]\n","            * tf.shape(mask_float)[2],\n","            tf.float32,\n","        )\n","\n","        tv_penalty = (\n","            tf.image.total_variation(mask_float)\n","            / tf.maximum(spatial_size, 1.0)\n","        )\n","        regularization = (\n","            self.area_loss_weight\n","            * tf.reduce_mean(area_penalty)\n","            + self.tv_loss_weight\n","            * tf.reduce_mean(tv_penalty)\n","        )\n","\n","        self.add_loss(regularization)\n","        mask = tf.cast(mask, feature_map.dtype)\n","        lesion_features = feature_map * mask\n","        context_features = feature_map * (\n","            1.0 - mask\n","        )\n","        return (\n","            lesion_features,\n","            context_features,\n","            mask,\n","        )\n","    def get_config(self):\n","        return {\n","            **super().get_config(),\n","            \"hidden_dim\": self.hidden_dim,\n","            \"min_area\": self.min_area,\n","            \"max_area\": self.max_area,\n","            \"area_loss_weight\": self.area_loss_weight,\n","            \"tv_loss_weight\": self.tv_loss_weight,\n","        }\n","\n","\n","# LESION-GUIDED BIDIRECTIONAL CROSS ATTENTION\n","\n","\n","@tf.keras.utils.register_keras_serializable()\n","class LesionGuidedDynamicCrossAttention(layers.Layer):\n","    def __init__(\n","        self,\n","        projection_dim,\n","        num_heads,\n","        dropout_rate=0.1,\n","        gate_hidden_dim=64,\n","        **kwargs,\n","    ):\n","        super().__init__(**kwargs)\n","        self.projection_dim = projection_dim\n","        self.num_heads = num_heads\n","        self.dropout_rate = dropout_rate\n","        self.gate_hidden_dim = gate_hidden_dim\n","        head_dim = projection_dim // num_heads\n","        self.cnn_norm = layers.LayerNormalization(\n","            epsilon=1e-6\n","        )\n","        self.vit_norm = layers.LayerNormalization(\n","            epsilon=1e-6\n","        )\n","        self.cnn_queries_vit = layers.MultiHeadAttention(\n","            num_heads=num_heads,\n","            key_dim=head_dim,\n","            dropout=dropout_rate,\n","        )\n","        self.vit_queries_cnn = layers.MultiHeadAttention(\n","            num_heads=num_heads,\n","            key_dim=head_dim,\n","            dropout=dropout_rate,\n","        )\n","        self.context_dropout = layers.Dropout(\n","            dropout_rate\n","        )\n","        self.gate_hidden = layers.Dense(\n","            gate_hidden_dim,\n","            activation=\"swish\",\n","        )\n","        self.gate_output = layers.Dense(\n","            2,\n","            activation=\"sigmoid\",\n","            kernel_initializer=\"zeros\",\n","            bias_initializer=(\n","                tf.keras.initializers.Constant(-3.0)\n","            ),\n","        )\n","\n","        self.cnn_ffn_norm = layers.LayerNormalization(\n","            epsilon=1e-6\n","        )\n","        self.vit_ffn_norm = layers.LayerNormalization(\n","            epsilon=1e-6\n","        )\n","        self.cnn_ffn = tf.keras.Sequential([\n","            layers.Dense(\n","                projection_dim * 2,\n","                activation=\"gelu\",\n","            ),\n","            layers.Dropout(dropout_rate),\n","            layers.Dense(projection_dim),\n","        ])\n","\n","        self.vit_ffn = tf.keras.Sequential([\n","            layers.Dense(\n","                projection_dim * 2,\n","                activation=\"gelu\",\n","            ),\n","            layers.Dropout(dropout_rate),\n","            layers.Dense(projection_dim),\n","        ])\n","\n","    def call(self, inputs, training=None):\n","        lesion_tokens, vit_tokens, lesion_scores = inputs\n","        cnn = self.cnn_norm(lesion_tokens)\n","        vit = self.vit_norm(vit_tokens)\n","        scores = tf.cast(\n","            lesion_scores,\n","            cnn.dtype,\n","        )\n","\n","        weighted_cnn = cnn * (0.5 + scores)\n","        cnn_context = self.cnn_queries_vit(\n","            query=cnn,\n","            key=vit,\n","            value=vit,\n","            training=training,\n","        )\n","\n","        vit_context = self.vit_queries_cnn(\n","            query=vit,\n","            key=weighted_cnn,\n","            value=weighted_cnn,\n","            training=training,\n","        )\n","        gate_features = tf.concat(\n","            [\n","                tf.reduce_mean(cnn, axis=1),\n","                tf.reduce_mean(vit, axis=1),\n","                tf.reduce_mean(scores, axis=1),\n","            ],\n","            axis=-1,\n","        )\n","\n","        gates = self.gate_output(\n","            self.gate_hidden(gate_features)\n","        )\n","\n","        cnn_gate = gates[:, 0:1, None]\n","        vit_gate = gates[:, 1:2, None]\n","\n","        cnn_context = self.context_dropout(\n","            cnn_context,\n","            training=training,\n","        )\n","\n","        vit_context = self.context_dropout(\n","            vit_context,\n","            training=training,\n","        )\n","\n","        lesion_tokens = (\n","            lesion_tokens\n","            + cnn_gate * cnn_context\n","        )\n","\n","        vit_tokens = (\n","            vit_tokens\n","            + vit_gate * vit_context\n","        )\n","\n","        lesion_tokens = (\n","            lesion_tokens\n","            + cnn_gate * self.cnn_ffn(\n","                self.cnn_ffn_norm(lesion_tokens),\n","                training=training,\n","            )\n","        )\n","\n","        vit_tokens = (\n","            vit_tokens\n","            + vit_gate * self.vit_ffn(\n","                self.vit_ffn_norm(vit_tokens),\n","                training=training,\n","            )\n","        )\n","\n","        return (\n","            lesion_tokens,\n","            vit_tokens,\n","            gates,\n","        )\n","\n","    def get_config(self):\n","        return {\n","            **super().get_config(),\n","            \"projection_dim\": self.projection_dim,\n","            \"num_heads\": self.num_heads,\n","            \"dropout_rate\": self.dropout_rate,\n","            \"gate_hidden_dim\": self.gate_hidden_dim,\n","        }\n","\n","\n","# ORIGINAL V5 THREE-EXPERT DYNAMIC FUSION\n","\n","@tf.keras.utils.register_keras_serializable()\n","class DynamicAdaptiveFusion(layers.Layer):\n","    def __init__(\n","        self,\n","        fusion_dim=128,\n","        balance_loss_weight=1e-4,\n","        **kwargs,\n","    ):\n","        super().__init__(**kwargs)\n","        self.fusion_dim = fusion_dim\n","        self.balance_loss_weight = balance_loss_weight\n","        self.lesion_projection = layers.Dense(\n","            fusion_dim, activation=\"gelu\"\n","        )\n","        self.global_projection = layers.Dense(\n","            fusion_dim, activation=\"gelu\"\n","        )\n","        self.interaction_projection = layers.Dense(\n","            fusion_dim, activation=\"gelu\"\n","        )\n","        self.gate_hidden = layers.Dense(\n","            fusion_dim, activation=\"swish\"\n","        )\n","        self.gate_logits = layers.Dense(\n","            3,\n","            kernel_initializer=\"zeros\",\n","            bias_initializer=\"zeros\",\n","        )\n","\n","    def call(self, inputs):\n","        lesion, context, vit, cross_gates = inputs\n","        experts = tf.stack(\n","            [\n","                self.lesion_projection(lesion),\n","                self.global_projection(vit),\n","                self.interaction_projection(\n","                    tf.concat(\n","                        [lesion, vit],\n","                        axis=-1,\n","                    )\n","                ),\n","            ],\n","            axis=1,\n","        )\n","\n","        gate_features = tf.concat(\n","            [lesion, context, vit, cross_gates],\n","            axis=-1,\n","        )\n","\n","        weights = tf.nn.softmax(\n","            self.gate_logits(\n","                self.gate_hidden(gate_features)\n","            ),\n","            axis=-1,\n","        )\n","\n","        fused = tf.reduce_sum(\n","            experts * weights[..., None],\n","            axis=1,\n","        )\n","\n","        mean_weights = tf.reduce_mean(\n","            weights,\n","            axis=0,\n","        )\n","\n","        balance_loss = tf.reduce_sum(\n","            tf.square(\n","                mean_weights - 1.0 / 3.0\n","            )\n","        )\n","\n","        self.add_loss(\n","            self.balance_loss_weight\n","            * balance_loss\n","        )\n","\n","        return fused, weights\n","\n","    def get_config(self):\n","        return {\n","            **super().get_config(),\n","            \"fusion_dim\": self.fusion_dim,\n","            \"balance_loss_weight\": self.balance_loss_weight,\n","        }\n","\n","\n","# ============================================================\n","# NEW V6 — NORMALIZED MASKED POOLING\n","# ============================================================\n","\n","@tf.keras.utils.register_keras_serializable()\n","class NormalizedMaskedPooling(layers.Layer):\n","\n","    def __init__(self, epsilon=1e-4, **kwargs):\n","        super().__init__(**kwargs)\n","        self.epsilon = epsilon\n","\n","    def call(self, inputs):\n","\n","        features, mask = inputs\n","\n","        mask = tf.cast(\n","            mask,\n","            features.dtype,\n","        )\n","\n","        numerator = tf.reduce_sum(\n","            features * mask,\n","            axis=[1, 2],\n","        )\n","\n","        denominator = tf.reduce_sum(\n","            mask,\n","            axis=[1, 2],\n","        )\n","\n","        denominator = tf.maximum(\n","            denominator,\n","            tf.cast(\n","                self.epsilon,\n","                features.dtype,\n","            ),\n","        )\n","\n","        return numerator / denominator\n","\n","    def get_config(self):\n","        return {\n","            **super().get_config(),\n","            \"epsilon\": self.epsilon,\n","        }\n","\n","\n","# ============================================================\n","# NEW V6 — RESIDUAL FEATURE PRESERVATION\n","# ============================================================\n","\n","@tf.keras.utils.register_keras_serializable()\n","class MaskResidualFeatures(layers.Layer):\n","\n","    def call(self, inputs):\n","\n","        features, mask = inputs\n","\n","        mask = tf.cast(\n","            mask,\n","            features.dtype,\n","        )\n","\n","        return features * (0.5 + mask)\n","\n","\n","@tf.keras.utils.register_keras_serializable()\n","class ComplementMask(layers.Layer):\n","\n","    def call(self, mask):\n","        return 1.0 - mask\n","\n","\n","# ============================================================\n","# NEW V6 — FOUR-EXPERT DYNAMIC FUSION\n","# ============================================================\n","\n","@tf.keras.utils.register_keras_serializable()\n","class ContextAwareFourExpertFusion(layers.Layer):\n","\n","    def __init__(\n","        self,\n","        fusion_dim=128,\n","        dropout_rate=0.10,\n","        **kwargs,\n","    ):\n","        super().__init__(**kwargs)\n","\n","        self.fusion_dim = fusion_dim\n","        self.dropout_rate = dropout_rate\n","\n","        self.expert_projections = [\n","            layers.Dense(\n","                fusion_dim,\n","                activation=\"gelu\",\n","            )\n","            for _ in range(4)\n","        ]\n","\n","        self.gate_norm = layers.LayerNormalization(\n","            epsilon=1e-6\n","        )\n","\n","        self.gate_hidden = layers.Dense(\n","            fusion_dim,\n","            activation=\"swish\",\n","        )\n","\n","        self.gate_dropout = layers.Dropout(\n","            dropout_rate\n","        )\n","\n","        self.gate_logits = layers.Dense(\n","            4,\n","            kernel_initializer=\"zeros\",\n","            bias_initializer=\"zeros\",\n","        )\n","\n","    def call(self, inputs, training=None):\n","\n","        lesion, context, vit, cnn = inputs\n","\n","        projected_experts = [\n","            projection(vector)\n","            for projection, vector in zip(\n","                self.expert_projections,\n","                inputs,\n","            )\n","        ]\n","\n","        expert_stack = tf.stack(\n","            projected_experts,\n","            axis=1,\n","        )\n","\n","        gate_features = tf.concat(\n","            [lesion, context, vit, cnn],\n","            axis=-1,\n","        )\n","\n","        gate_features = self.gate_norm(\n","            gate_features\n","        )\n","\n","        gate_features = self.gate_hidden(\n","            gate_features\n","        )\n","\n","        gate_features = self.gate_dropout(\n","            gate_features,\n","            training=training,\n","        )\n","\n","        fusion_weights = tf.nn.softmax(\n","            self.gate_logits(gate_features),\n","            axis=-1,\n","        )\n","\n","        fused = tf.reduce_sum(\n","            expert_stack\n","            * fusion_weights[..., None],\n","            axis=1,\n","        )\n","\n","        return fused, fusion_weights\n","\n","    def get_config(self):\n","        return {\n","            **super().get_config(),\n","            \"fusion_dim\": self.fusion_dim,\n","            \"dropout_rate\": self.dropout_rate,\n","        }\n","\n","\n","# ============================================================\n","# WEIGHTED CONCATENATION AND RESNET PREPROCESSING\n","# ============================================================\n","\n","@tf.keras.utils.register_keras_serializable()\n","class BalancedConcatenation(layers.Layer):\n","\n","    def build(self, input_shape):\n","\n","        self.branch_logits = self.add_weight(\n","            name=\"branch_logits\",\n","            shape=(len(input_shape),),\n","            initializer=\"zeros\",\n","            trainable=True,\n","        )\n","\n","        super().build(input_shape)\n","\n","    def call(self, inputs):\n","\n","        weights = tf.nn.softmax(\n","            self.branch_logits\n","        )\n","\n","        return tf.concat(\n","            [\n","                vector * tf.cast(\n","                    weights[i],\n","                    vector.dtype,\n","                )\n","                for i, vector in enumerate(inputs)\n","            ],\n","            axis=-1,\n","        )\n","\n","\n","@tf.keras.utils.register_keras_serializable()\n","class ResNetPreprocessing(layers.Layer):\n","\n","    def call(self, inputs):\n","\n","        return tf.keras.applications.resnet.preprocess_input(\n","            inputs\n","        )\n","\n","\n","# ============================================================\n","# GATED CROSS ATTENTION FOR EARLIER ABLATION MODEL\n","# ============================================================\n","\n","@tf.keras.utils.register_keras_serializable()\n","class GatedBidirectionalCrossAttention(layers.Layer):\n","\n","    def __init__(\n","        self,\n","        projection_dim,\n","        num_heads,\n","        dropout_rate=0.10,\n","        **kwargs,\n","    ):\n","        super().__init__(**kwargs)\n","\n","        self.projection_dim = projection_dim\n","        self.num_heads = num_heads\n","        self.dropout_rate = dropout_rate\n","\n","        self.cnn_norm = layers.LayerNormalization()\n","        self.vit_norm = layers.LayerNormalization()\n","\n","        self.cnn_attention = layers.MultiHeadAttention(\n","            num_heads=num_heads,\n","            key_dim=projection_dim // num_heads,\n","            dropout=dropout_rate,\n","        )\n","\n","        self.vit_attention = layers.MultiHeadAttention(\n","            num_heads=num_heads,\n","            key_dim=projection_dim // num_heads,\n","            dropout=dropout_rate,\n","        )\n","\n","        self.dropout = layers.Dropout(dropout_rate)\n","\n","    def build(self, input_shape):\n","\n","        self.cnn_scale = self.add_weight(\n","            name=\"cnn_scale\",\n","            shape=(),\n","            initializer=\"zeros\",\n","            trainable=True,\n","        )\n","\n","        self.vit_scale = self.add_weight(\n","            name=\"vit_scale\",\n","            shape=(),\n","            initializer=\"zeros\",\n","            trainable=True,\n","        )\n","\n","        super().build(input_shape)\n","\n","    def call(self, inputs, training=None):\n","\n","        cnn, vit = inputs\n","\n","        normalized_cnn = self.cnn_norm(cnn)\n","        normalized_vit = self.vit_norm(vit)\n","\n","        cnn_context = self.cnn_attention(\n","            normalized_cnn,\n","            normalized_vit,\n","            training=training,\n","        )\n","\n","        vit_context = self.vit_attention(\n","            normalized_vit,\n","            normalized_cnn,\n","            training=training,\n","        )\n","\n","        cnn = (\n","            cnn\n","            + tf.tanh(self.cnn_scale)\n","            * self.dropout(\n","                cnn_context,\n","                training=training,\n","            )\n","        )\n","\n","        vit = (\n","            vit\n","            + tf.tanh(self.vit_scale)\n","            * self.dropout(\n","                vit_context,\n","                training=training,\n","            )\n","        )\n","\n","        return cnn, vit\n","\n","    def get_config(self):\n","        return {\n","            **super().get_config(),\n","            \"projection_dim\": self.projection_dim,\n","            \"num_heads\": self.num_heads,\n","            \"dropout_rate\": self.dropout_rate,\n","        }\n","\n","\n","print(\"Cell 04 complete: Custom layers registered.\")\n","\n","save_cell_summary(\n","    \"cell_04_custom_layers\",\n","    {\n","        \"transformer\": True,\n","        \"disease_area_decoupling\": True,\n","        \"lesion_guided_cross_attention\": True,\n","        \"original_three_expert_fusion\": True,\n","        \"new_normalized_masked_pooling\": True,\n","        \"new_four_expert_fusion\": True,\n","    },\n",")"]},{"cell_type":"code","execution_count":5,"id":"08edb4c0","metadata":{"execution":{"iopub.execute_input":"2026-10-26T16:57:26.651538Z","iopub.status.busy":"2026-10-26T16:57:26.651288Z","iopub.status.idle":"2026-10-26T16:57:26.692052Z","shell.execute_reply":"2026-10-26T16:57:26.691265Z"},"papermill":{"duration":0.047749,"end_time":"2026-10-26T16:57:26.693534+00:00","exception":false,"start_time":"2026-10-26T16:57:26.645785+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Registered model architectures: 12\n"]}],"source":["# ============================================================\n","# CELL 05 — MODEL BUILDERS\n","# ============================================================\n","\n","def shared_classifier_head(features, prefix):\n","\n","    x = layers.LayerNormalization(\n","        epsilon=1e-6,\n","        name=f\"{prefix}_normalization\",\n","    )(features)\n","\n","    x = layers.Dense(\n","        256,\n","        activation=\"gelu\",\n","        kernel_regularizer=(\n","            tf.keras.regularizers.l2(1e-5)\n","        ),\n","        name=f\"{prefix}_dense_1\",\n","    )(x)\n","\n","    x = layers.Dropout(0.35)(x)\n","\n","    x = layers.Dense(\n","        128,\n","        activation=\"gelu\",\n","        kernel_regularizer=(\n","            tf.keras.regularizers.l2(1e-5)\n","        ),\n","        name=f\"{prefix}_dense_2\",\n","    )(x)\n","\n","    x = layers.Dropout(0.25)(x)\n","\n","    outputs = layers.Dense(\n","        NUM_CLASSES,\n","        activation=\"softmax\",\n","        dtype=\"float32\",\n","        name=f\"{prefix}_predictions\",\n","    )(x)\n","\n","    return outputs\n","\n","\n","def safe_application_backbone(\n","    constructor,\n","    architecture_name,\n","    **kwargs,\n","):\n","\n","    requested_weights = (\n","        \"imagenet\"\n","        if USE_IMAGENET_WEIGHTS\n","        else None\n","    )\n","\n","    try:\n","        backbone = constructor(\n","            weights=requested_weights,\n","            **kwargs,\n","        )\n","\n","        pretrained = requested_weights is not None\n","\n","    except Exception as error:\n","\n","        if (\n","            REQUIRE_PRETRAINED_WEIGHTS\n","            and requested_weights is not None\n","        ):\n","            raise RuntimeError(\n","                f\"ImageNet weights unavailable for \"\n","                f\"{architecture_name}. \"\n","                \"Check Kaggle Internet or attach cached weights.\"\n","            ) from error\n","\n","        print(\n","            f\"{architecture_name}: random initialization\",\n","            repr(error),\n","        )\n","\n","        backbone = constructor(\n","            weights=None,\n","            **kwargs,\n","        )\n","\n","        pretrained = False\n","\n","    backbone.trainable = not pretrained\n","\n","    return backbone, pretrained\n","\n","\n","def build_vit_tokens(inputs, prefix):\n","\n","    images = layers.Rescaling(\n","        1.0 / 255.0,\n","        name=f\"{prefix}_vit_rescaling\",\n","    )(inputs)\n","\n","    number_of_patches = (\n","        IMAGE_HEIGHT // PATCH_SIZE\n","    ) * (\n","        IMAGE_WIDTH // PATCH_SIZE\n","    )\n","\n","    patches = Patches(\n","        PATCH_SIZE,\n","        name=f\"{prefix}_patches\",\n","    )(images)\n","\n","    tokens = PatchEncoder(\n","        number_of_patches,\n","        PROJECTION_DIM,\n","        name=f\"{prefix}_patch_encoder\",\n","    )(patches)\n","\n","    for index in range(NUM_TRANSFORMER_BLOCKS):\n","\n","        tokens = TransformerEncoder(\n","            projection_dim=PROJECTION_DIM,\n","            num_heads=NUM_HEADS,\n","            mlp_dim=TRANSFORMER_MLP_DIM,\n","            dropout_rate=DROPOUT_RATE,\n","            name=f\"{prefix}_transformer_{index + 1}\",\n","        )(tokens)\n","\n","    return tokens\n","\n","\n","def build_projected_cnn(inputs, prefix):\n","\n","    backbone, pretrained = safe_application_backbone(\n","        tf.keras.applications.EfficientNetV2B0,\n","        architecture_name=prefix,\n","        include_top=False,\n","        include_preprocessing=True,\n","        input_shape=(224, 224, 3),\n","    )\n","\n","    features = backbone(\n","        inputs,\n","        training=False,\n","    )\n","\n","    features = layers.Conv2D(\n","        PROJECTION_DIM,\n","        1,\n","        padding=\"same\",\n","        use_bias=False,\n","        name=f\"{prefix}_cnn_projection\",\n","    )(features)\n","\n","    features = layers.BatchNormalization(\n","        name=f\"{prefix}_cnn_projection_bn\",\n","    )(features)\n","\n","    features = layers.Activation(\n","        \"swish\",\n","        name=f\"{prefix}_cnn_activation\",\n","    )(features)\n","\n","    return features, backbone, pretrained\n","\n","\n","def build_disease_area(features, prefix):\n","\n","    return MultiScaleDiseaseAreaDecoupler(\n","        hidden_dim=DAP_HIDDEN_DIM,\n","        min_area=DAP_MIN_AREA,\n","        max_area=DAP_MAX_AREA,\n","        area_loss_weight=DAP_AREA_LOSS_WEIGHT,\n","        tv_loss_weight=DAP_TV_LOSS_WEIGHT,\n","        name=f\"{prefix}_disease_area_decoupling\",\n","    )(features)\n","\n","\n","def build_lesion_cross_attention(\n","    lesion_tokens,\n","    vit_tokens,\n","    lesion_scores,\n","    prefix,\n","):\n","\n","    return LesionGuidedDynamicCrossAttention(\n","        projection_dim=PROJECTION_DIM,\n","        num_heads=NUM_HEADS,\n","        dropout_rate=CAF_ATTENTION_DROPOUT,\n","        gate_hidden_dim=64,\n","        name=f\"{prefix}_cross_attention\",\n","    )([\n","        lesion_tokens,\n","        vit_tokens,\n","        lesion_scores,\n","    ])\n","\n","\n","# ============================================================\n","# BASELINE 1 — CNN FROM SCRATCH\n","# ============================================================\n","\n","def build_cnn_scratch():\n","\n","    inputs = layers.Input(\n","        shape=(224, 224, 3),\n","        name=\"cnn_scratch_input\",\n","    )\n","\n","    x = layers.Rescaling(1.0 / 255.0)(inputs)\n","\n","    for index, filters in enumerate(\n","        [32, 64, 128, 192],\n","        start=1,\n","    ):\n","        x = layers.Conv2D(\n","            filters,\n","            3,\n","            padding=\"same\",\n","            use_bias=False,\n","            name=f\"cnn_block_{index}_conv\",\n","        )(x)\n","\n","        x = layers.BatchNormalization()(x)\n","        x = layers.Activation(\"swish\")(x)\n","        x = layers.MaxPooling2D()(x)\n","        x = layers.Dropout(0.10)(x)\n","\n","    x = layers.GlobalAveragePooling2D()(x)\n","\n","    outputs = shared_classifier_head(\n","        x, \"cnn_scratch\"\n","    )\n","\n","    return (\n","        Model(inputs, outputs, name=\"CNN_Scratch\"),\n","        None,\n","        False,\n","    )\n","\n","\n","# ============================================================\n","# BASELINE 2 — MOBILENET V3 SMALL\n","# ============================================================\n","\n","def build_mobilenetv3_small():\n","\n","    inputs = layers.Input((224, 224, 3))\n","\n","    backbone, pretrained = safe_application_backbone(\n","        tf.keras.applications.MobileNetV3Small,\n","        architecture_name=\"MobileNetV3-Small\",\n","        include_top=False,\n","        include_preprocessing=True,\n","        input_shape=(224, 224, 3),\n","    )\n","\n","    features = backbone(inputs, training=False)\n","\n","    pooled = layers.GlobalAveragePooling2D()(\n","        features\n","    )\n","\n","    outputs = shared_classifier_head(\n","        pooled, \"mobilenetv3\"\n","    )\n","\n","    return (\n","        Model(inputs, outputs, name=\"MobileNetV3_Small\"),\n","        backbone,\n","        pretrained,\n","    )\n","\n","\n","# ============================================================\n","# BASELINE 3 — RESNET50\n","# ============================================================\n","\n","def build_resnet50():\n","\n","    inputs = layers.Input((224, 224, 3))\n","\n","    processed = ResNetPreprocessing()(inputs)\n","\n","    backbone, pretrained = safe_application_backbone(\n","        tf.keras.applications.ResNet50,\n","        architecture_name=\"ResNet50\",\n","        include_top=False,\n","        input_shape=(224, 224, 3),\n","    )\n","\n","    features = backbone(\n","        processed,\n","        training=False,\n","    )\n","\n","    pooled = layers.GlobalAveragePooling2D()(\n","        features\n","    )\n","\n","    outputs = shared_classifier_head(\n","        pooled, \"resnet50\"\n","    )\n","\n","    return (\n","        Model(inputs, outputs, name=\"ResNet50\"),\n","        backbone,\n","        pretrained,\n","    )\n","\n","\n","# ============================================================\n","# BASELINE 4 — EFFICIENTNET V2 B0\n","# ============================================================\n","\n","def build_efficientnetv2_b0():\n","\n","    inputs = layers.Input((224, 224, 3))\n","\n","    backbone, pretrained = safe_application_backbone(\n","        tf.keras.applications.EfficientNetV2B0,\n","        architecture_name=\"EfficientNetV2-B0\",\n","        include_top=False,\n","        include_preprocessing=True,\n","        input_shape=(224, 224, 3),\n","    )\n","\n","    features = backbone(inputs, training=False)\n","\n","    pooled = layers.GlobalAveragePooling2D()(\n","        features\n","    )\n","\n","    outputs = shared_classifier_head(\n","        pooled, \"efficientnet\"\n","    )\n","\n","    return (\n","        Model(inputs, outputs, name=\"EfficientNetV2_B0\"),\n","        backbone,\n","        pretrained,\n","    )\n","\n","\n","# ============================================================\n","# BASELINE 5 — SMALL TRANSFORMER\n","# ============================================================\n","\n","def build_vit_small():\n","\n","    inputs = layers.Input((224, 224, 3))\n","\n","    tokens = build_vit_tokens(\n","        inputs,\n","        \"vit_small\",\n","    )\n","\n","    pooled = layers.GlobalAveragePooling1D()(\n","        tokens\n","    )\n","\n","    outputs = shared_classifier_head(\n","        pooled, \"vit_small\"\n","    )\n","\n","    return (\n","        Model(inputs, outputs, name=\"ViT_Small\"),\n","        None,\n","        False,\n","    )\n","\n","\n","# ============================================================\n","# BASELINE 6 — CONVNEXT TINY\n","# ============================================================\n","\n","def build_convnext_tiny():\n","\n","    inputs = layers.Input((224, 224, 3))\n","\n","    backbone, pretrained = safe_application_backbone(\n","        tf.keras.applications.ConvNeXtTiny,\n","        architecture_name=\"ConvNeXt-Tiny\",\n","        include_top=False,\n","        include_preprocessing=True,\n","        input_shape=(224, 224, 3),\n","    )\n","\n","    features = backbone(inputs, training=False)\n","\n","    pooled = layers.GlobalAveragePooling2D()(\n","        features\n","    )\n","\n","    outputs = shared_classifier_head(\n","        pooled, \"convnext_tiny\"\n","    )\n","\n","    return (\n","        Model(inputs, outputs, name=\"ConvNeXt_Tiny\"),\n","        backbone,\n","        pretrained,\n","    )\n","\n","\n","# ============================================================\n","# ABLATION 1 — CNN + VIT CONCATENATION\n","# ============================================================\n","\n","def build_evit_concat():\n","\n","    inputs = layers.Input((224, 224, 3))\n","\n","    cnn, backbone, pretrained = build_projected_cnn(\n","        inputs, \"concat\"\n","    )\n","\n","    cnn_tokens = layers.Reshape(\n","        (-1, PROJECTION_DIM)\n","    )(cnn)\n","\n","    vit_tokens = build_vit_tokens(\n","        inputs, \"concat\"\n","    )\n","\n","    cnn_vector = layers.GlobalAveragePooling1D()(\n","        cnn_tokens\n","    )\n","\n","    vit_vector = layers.GlobalAveragePooling1D()(\n","        vit_tokens\n","    )\n","\n","    fused = BalancedConcatenation(\n","        name=\"concat_balanced_fusion\"\n","    )([cnn_vector, vit_vector])\n","\n","    outputs = shared_classifier_head(\n","        fused, \"evit_concat\"\n","    )\n","\n","    return (\n","        Model(inputs, outputs, name=\"EVit_Concat\"),\n","        backbone,\n","        pretrained,\n","    )\n","\n","\n","# ============================================================\n","# ABLATION 2 — GATED CNN + VIT CROSS ATTENTION\n","# ============================================================\n","\n","def build_evit_caf_gated():\n","\n","    inputs = layers.Input((224, 224, 3))\n","\n","    cnn, backbone, pretrained = build_projected_cnn(\n","        inputs, \"caf\"\n","    )\n","\n","    cnn_tokens = layers.Reshape(\n","        (-1, PROJECTION_DIM)\n","    )(cnn)\n","\n","    vit_tokens = build_vit_tokens(\n","        inputs, \"caf\"\n","    )\n","\n","    cnn_tokens, vit_tokens = (\n","        GatedBidirectionalCrossAttention(\n","            projection_dim=PROJECTION_DIM,\n","            num_heads=NUM_HEADS,\n","            dropout_rate=CAF_ATTENTION_DROPOUT,\n","            name=\"gated_bidirectional_cross_attention\",\n","        )([cnn_tokens, vit_tokens])\n","    )\n","\n","    cnn_vector = layers.GlobalAveragePooling1D()(\n","        cnn_tokens\n","    )\n","\n","    vit_vector = layers.GlobalAveragePooling1D()(\n","        vit_tokens\n","    )\n","\n","    fused = BalancedConcatenation()([\n","        cnn_vector,\n","        vit_vector,\n","    ])\n","\n","    outputs = shared_classifier_head(\n","        fused, \"evit_caf_gated\"\n","    )\n","\n","    return (\n","        Model(inputs, outputs, name=\"EVit_CAF_Gated\"),\n","        backbone,\n","        pretrained,\n","    )\n","\n","\n","# ============================================================\n","# ABLATION 3 — DAP + CONCATENATION\n","# =====================================================