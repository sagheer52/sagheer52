===============\n","\n","def dataframe_from_folder(\n","    folder,\n","    class_to_index=None,\n","):\n","\n","    folder = Path(folder)\n","\n","    if not folder.exists():\n","        raise FileNotFoundError(\n","            f\"Dataset folder not found: {folder}\"\n","        )\n","\n","    groups = {}\n","\n","    for directory in sorted(folder.iterdir()):\n","\n","        if not directory.is_dir():\n","            continue\n","\n","        images = sorted(\n","            str(path)\n","            for path in directory.rglob(\"*\")\n","            if path.is_file()\n","            and path.suffix.lower() in IMAGE_EXTENSIONS\n","        )\n","\n","        if images:\n","            groups[directory.name] = images\n","\n","    if class_to_index is None:\n","\n","        class_to_index = {\n","            name: index\n","            for index, name in enumerate(\n","                sorted(groups.keys())\n","            )\n","        }\n","\n","    if set(groups.keys()) != set(class_to_index.keys()):\n","        raise ValueError(\n","            \"Training and testing class folders do not match.\"\n","        )\n","\n","    records = []\n","\n","    for class_name, image_paths in groups.items():\n","\n","        for filepath in image_paths:\n","\n","            records.append({\n","                \"filepath\": filepath,\n","                \"label\": class_to_index[class_name],\n","                \"class_name\": class_name,\n","            })\n","\n","    dataframe = pd.DataFrame(records)\n","\n","    if dataframe.empty:\n","        raise ValueError(\n","            f\"No images found in {folder}\"\n","        )\n","\n","    return (\n","        dataframe\n","        .sort_values(\"filepath\")\n","        .reset_index(drop=True)\n","    ), class_to_index\n","\n","\n","train_full, class_to_index = dataframe_from_folder(\n","    TRAIN_FOLDER\n",")\n","\n","test_df, _ = dataframe_from_folder(\n","    TEST_FOLDER,\n","    class_to_index=class_to_index,\n",")\n","\n","class_names = list(class_to_index.keys())\n","\n","NUM_CLASSES = len(class_names)\n","\n","print(\"Classes:\", class_names)\n","print(\"Number of classes:\", NUM_CLASSES)\n","print(\"Original training images:\", len(train_full))\n","print(\"Official test images:\", len(test_df))\n","\n","\n","# ============================================================\n","# STEP 2 — CALCULATE EXACT IMAGE HASHES\n","# ============================================================\n","\n","def sha256_file(filepath):\n","\n","    digest = hashlib.sha256()\n","\n","    with open(filepath, \"rb\") as file:\n","\n","        for block in iter(\n","            lambda: file.read(1024 * 1024),\n","            b\"\",\n","        ):\n","            digest.update(block)\n","\n","    return digest.hexdigest()\n","\n","\n","print(\"\\nCalculating image hashes...\", flush=True)\n","\n","train_full[\"sha256\"] = (\n","    train_full[\"filepath\"].map(sha256_file)\n",")\n","\n","test_df[\"sha256\"] = (\n","    test_df[\"filepath\"].map(sha256_file)\n",")\n","\n","\n","# ============================================================\n","# STEP 3 — DETECT AND REMOVE TRAIN/TEST DUPLICATES\n","# ============================================================\n","\n","cross_duplicate_hashes = (\n","    set(train_full[\"sha256\"])\n","    & set(test_df[\"sha256\"])\n",")\n","\n","print(\n","    \"\\nTrain/test overlapping hashes:\",\n","    len(cross_duplicate_hashes)\n",")\n","\n","duplicate_report = (\n","    train_full[\n","        train_full[\"sha256\"].isin(\n","            cross_duplicate_hashes\n","        )\n","    ].merge(\n","        test_df,\n","        on=\"sha256\",\n","        suffixes=(\"_train\", \"_test\"),\n","    )\n",")\n","\n","duplicate_report.to_csv(\n","    TABLE_DIR / \"cross_split_exact_duplicates.csv\",\n","    index=False,\n",")\n","\n","train_clean = train_full[\n","    ~train_full[\"sha256\"].isin(\n","        cross_duplicate_hashes\n","    )\n","].copy()\n","\n","removed_cross_duplicates = (\n","    len(train_full) - len(train_clean)\n",")\n","\n","print(\n","    \"Removed overlapping training files:\",\n","    removed_cross_duplicates\n",")\n","\n","\n","# ============================================================\n","# STEP 4 — CHECK TRAINING LABEL CONFLICTS\n","# ============================================================\n","\n","conflicting_labels = (\n","    train_clean.groupby(\"sha256\")[\"label\"]\n","    .nunique()\n",")\n","\n","if (conflicting_labels > 1).any():\n","\n","    raise ValueError(\n","        \"Identical images have conflicting labels.\"\n","    )\n","\n","\n","# ============================================================\n","# STEP 5 — REMOVE INTERNAL TRAINING DUPLICATES\n","# ============================================================\n","\n","removed_internal_duplicates = int(\n","    train_clean[\"sha256\"].duplicated().sum()\n",")\n","\n","train_unique = (\n","    train_clean\n","    .drop_duplicates(\n","        subset=\"sha256\",\n","        keep=\"first\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","print(\n","    \"Removed internal training duplicates:\",\n","    removed_internal_duplicates\n",")\n","\n","\n","# ============================================================\n","# STEP 6 — CREATE TRAINING AND VALIDATION SPLITS\n","# ============================================================\n","\n","class_counts = train_unique[\n","    \"label\"\n","].value_counts()\n","\n","if (\n","    len(class_counts) != NUM_CLASSES\n","    or (class_counts < 2).any()\n","):\n","    raise ValueError(\n","        \"At least one class has insufficient images \"\n","        \"for stratified splitting.\"\n","    )\n","\n","train_df, validation_df = train_test_split(\n","    train_unique,\n","    test_size=VALIDATION_RATIO,\n","    random_state=SEED,\n","    stratify=train_unique[\"label\"],\n",")\n","\n","train_df = (\n","    train_df\n","    .sort_values(\"filepath\")\n","    .reset_index(drop=True)\n",")\n","\n","validation_df = (\n","    validation_df\n","    .sort_values(\"filepath\")\n","    .reset_index(drop=True)\n",")\n","\n","test_df = (\n","    test_df\n","    .sort_values(\"filepath\")\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ============================================================\n","# STEP 7 — VERIFY ALL SPLITS\n","# ============================================================\n","\n","train_hashes = set(train_df[\"sha256\"])\n","validation_hashes = set(validation_df[\"sha256\"])\n","test_hashes = set(test_df[\"sha256\"])\n","\n","assert not (\n","    train_hashes & validation_hashes\n","), \"Train/validation exact-image leakage detected.\"\n","\n","assert not (\n","    train_hashes & test_hashes\n","), \"Train/test exact-image leakage detected.\"\n","\n","assert not (\n","    validation_hashes & test_hashes\n","), \"Validation/test exact-image leakage detected.\"\n","\n","\n","# ============================================================\n","# STEP 8 — SAVE CLEAN SPLITS\n","# ============================================================\n","\n","train_df.to_csv(\n","    TABLE_DIR / \"training_split.csv\",\n","    index=False,\n",")\n","\n","validation_df.to_csv(\n","    TABLE_DIR / \"validation_split.csv\",\n","    index=False,\n",")\n","\n","test_df.to_csv(\n","    TABLE_DIR / \"testing_split.csv\",\n","    index=False,\n",")\n","\n","\n","# ============================================================\n","# STEP 9 — DISPLAY CLASS DISTRIBUTION\n","# ============================================================\n","\n","distribution = pd.concat(\n","    [\n","        train_df[\"class_name\"].value_counts(),\n","        validation_df[\"class_name\"].value_counts(),\n","        test_df[\"class_name\"].value_counts(),\n","    ],\n","    axis=1,\n","    keys=[\n","        \"Training\",\n","        \"Validation\",\n","        \"Testing\",\n","    ],\n",").fillna(0).astype(int)\n","\n","display(distribution)\n","\n","\n","# ===================