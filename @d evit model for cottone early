    "                RESUME_EVALUATION_FROM_SAVED_WEIGHTS\n",
    "                and final_weights_path.exists()\n",
    "                and history_path.exists()\n",
    "                and selection_path.exists()\n",
    "            ):\n",
    "                show_progress(\n",
    "                    f'{model_name}: recovering saved weights and '\n",
