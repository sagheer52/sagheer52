    "# ============================================================\n",
    "# CELL 10 — MODEL BUILDERS\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "def build_cnn_scratch():\n",
    "    inputs = layers.Input(\n",
    "        shape=(IMAGE_HEIGHT, IMAGE_WIDTH, 3),\n",
    "        name='cnn_scratch_input',\n",
    "    )\n",
    "\n",
    "    x = layers.Rescaling(1.0 / 255.0)(inputs)\n",
    "\n",
    "    for block_index, filters in enumerate(\n",
    "        [32, 64, 128, 192],\n",
    "        start=1,\n",
    "    ):\n",
    "        x = layers.Conv2D(\n",
    "            filters,\n",
    "            3,\n",
    "            padding='same',\n",
    "            use_bias=False,\n",
    "            name=f'cnn_block_{block_index}_conv',\n",
    "        )(x)\n",
    "\n",
    "        x = layers.BatchNormalization(\n",
    "            name=f'cnn_block_{block_index}_bn',\n",
    "        )(x)\n",
    "\n",
    "        x = layers.Activation(\n",
    "            'swish',\n",
    "            name=f'cnn_block_{block_index}_activation',\n",
    "        )(x)\n",
    "\n",
    "        x = layers.MaxPooling2D(\n",
    "            name=f'cnn_block_{block_index}_pool',\n",
    "        )(x)\n",
    "\n",
    "        x = layers.Dropout(\n",
    "            0.10,\n",
    "            name=f'cnn_block_{block_index}_dropout',\n",
    "        )(x)\n",
    "\n",
    "    x = layers.GlobalAveragePooling2D(name='cnn_global_pool')(x)\n",
    "    outputs = shared_classifier_head(x, prefix='cnn_scratch')\n",
    "\n",
    "    return Model(inputs, outputs, name='CNN_Scratch'), None, False\n",
    "\n",
    "\n",
    "def build_mobilenetv3_small():\n",
    "    inputs = layers.Input(\n",
    "        shape=(IMAGE_HEIGHT, IMAGE_WIDTH, 3),\n",
    "        name='mobilenet_input',\n",
    "    )\n",
    "\n",
    "    backbone, pretrained_loaded = safe_application_backbone(\n",
    "        tf.keras.applications.MobileNetV3Small,\n",
    "        architecture_name='MobileNetV3-Small',\n",
    "        include_top=False,\n",
    "        include_preprocessing=True,\n",
    "        input_shape=(IMAGE_HEIGHT, IMAGE_WIDTH, 3),\n",
    "    )\n",
    "\n",
    "    x = backbone(inputs, training=False)\n",
    "    x = layers.GlobalAveragePooling2D(name='mobilenet_global_pool')(x)\n",
    "    outputs = shared_classifier_head(x, prefix='mobilenet')\n",
    "\n",
    "    return (\n",
    "        Model(inputs, outputs, name='MobileNetV3_Small'),\n",
    "        backbone,\n",
    "        pretrained_loaded,\n",
    "    )\n",
    "\n",
    "\n",
    "def build_resnet50():\n",
    "    inputs = layers.Input(\n",
    "        shape=(IMAGE_HEIGHT, IMAGE_WIDTH, 3),\n",
    "        name='resnet50_input',\n",
    "    )\n",
    "\n",
    "    x = ResNetPreprocessing(name='resnet50_preprocessing')(inputs)\n",
    "\n",
    "    backbone, pretrained_loaded = safe_application_backbone(\n",
    "        tf.keras.applications.ResNet50,\n",
    "        architecture_name='ResNet50',\n",
    "        include_top=False,\n",
    "        input_shape=(IMAGE_HEIGHT, IMAGE_WIDTH, 3),\n",
    "    )\n",
    "\n",
    "    x = backbone(x, training=False)\n",
    "    x = layers.GlobalAveragePooling2D(name='resnet50_global_pool')(x)\n",
    "    outputs = shared_classifier_head(x, prefix='resnet50')\n",
    "\n",
    "    return Model(inputs, outputs, name='ResNet50'), backbone, pretrained_loaded\n",
    "\n",
    "\n",
    "def build_efficientnetv2_b0():\n",
    "    inputs = layers.Input(\n",
    "        shape=(IMAGE_HEIGHT, IMAGE_WIDTH, 3),\n",
    "        name='efficientnet_input',\n",
    "    )\n",
    "\n",
    "    backbone, pretrained_loaded = safe_application_backbone(\n",
    "        tf.keras.applications.EfficientNetV2B0,\n",
    "        architecture_name='EfficientNetV2-B0',\n",
    "        include_top=False,\n",
    "        include_preprocessing=True,\n",
    "        input_shape=(IMAGE_HEIGHT, IMAGE_WIDTH, 3),\n",
    "    )\n",
    "\n",
    "    x = backbone(inputs, training=False)\n",
    "    x = layers.GlobalAveragePooling2D(name='efficientnet_global_pool')(x)\n",
    "    outputs = shared_classifier_head(x, prefix='efficientnet')\n",
    "\n",
    "    return (\n",
    "        Model(inputs, outputs, name='EfficientNetV2_B0'),\n",
    "        backbone,\n",
    "        pretrained_loaded,\n",
    "    )\n",
    "\n",
    "\n",
    "def build_vit_small():\n",
    "    inputs = layers.Input(\n",
    "        shape=(IMAGE_HEIGHT, IMAGE_WIDTH, 3),\n",
    "        name='vit_input',\n",
    "    )\n",
    "\n",
    "    x = layers.Rescaling(1.0 / 255.0, name='vit_rescaling')(inputs)\n",
    "\n",
    "    number_of_patches = (\n",
    "        IMAGE_HEIGHT // PATCH_SIZE\n",
    "    ) * (\n",
    "        IMAGE_WIDTH // PATCH_SIZE\n",
    "    )\n",
    "\n",
    "    tokens = Patches(PATCH_SIZE, name='vit_patch_extraction')(x)\n",
    "    tokens = PatchEncoder(\n",
    "        number_of_patches,\n",
    "        PROJECTION_DIM,\n",
    "        name='vit_patch_encoder',\n",
    "    )(tokens)\n",
    "\n",
    "    for block_index in range(NUM_TRANSFORMER_BLOCKS):\n",
    "        tokens = TransformerEncoder(\n",
    "            projection_dim=PROJECTION_DIM,\n",
    "            num_heads=NUM_HEADS,\n",
    "            mlp_dim=TRANSFORMER_MLP_DIM,\n",
    "            dropout_rate=DROPOUT_RATE,\n",
    "            name=f'vit_transformer_block_{block_index + 1}',\n",
    "        )(tokens)\n",
    "\n",
    "    pooled = layers.GlobalAveragePooling1D(name='vit_global_pool')(tokens)\n",
    "    outputs = shared_classifier_head(pooled, prefix='vit')\n",
    "\n",
    "    return Model(inputs, outputs, name='ViT_Small'), None, False\n",
    "\n",
    "\n",
    "def build_evit_concat():\n",
    "    inputs = layers.Input(\n",
    "        shape=(IMAGE_HEIGHT, IMAGE_WIDTH, 3),\n",
    "        name='evit_concat_input',\n",
    "    )\n",
    "\n",
    "    (\n",
    "        cnn_tokens,\n",
    "        vit_tokens,\n",
    "        backbone,\n",
    "        pretrained_loaded,\n",
    "    ) = build_efficientnet_and_vit_tokens(inputs, prefix='concat')\n",
    "\n",
    "    cnn_vector = layers.GlobalAveragePooling1D(\n",
    "        name='concat_cnn_pool',\n",
    "    )(cnn_tokens)\n",
    "\n",
    "    vit_vector = layers.GlobalAveragePooling1D(\n",
    "        name='concat_vit_pool',\n",
    "    )(vit_tokens)\n",
    "\n",
    "    fused = BalancedConcatenation(\n",
    "        name='concat_balanced_concatenation',\n",
    "    )([cnn_vector, vit_vector])\n",
    "\n",
    "    outputs = shared_classifier_head(fused, prefix='evit_concat')\n",
    "\n",
    "    return (\n",
    "        Model(inputs, outputs, name='EVit_Concat'),\n",
    "        backbone,\n",
    "        pretrained_loaded,\n",
    "    )\n",
    "\n",
    "\n",
    "def build_evit_caf_gated():\n",
    "    inputs = layers.Input(\n",
    "        shape=(IMAGE_HEIGHT, IMAGE_WIDTH, 3),\n",
    "        name='evit_caf_input',\n",
    "    )\n",
    "\n",
    "    (\n",
    "        cnn_tokens,\n",
    "        vit_tokens,\n",
    "        backbone,\n",
    "        pretrained_loaded,\n",
    "    ) = build_efficientnet_and_vit_tokens(inputs, prefix='caf')\n",
    "\n",
    "    fused_cnn_tokens, fused_vit_tokens = GatedBidirectionalCrossAttention(\n",
    "        projection_dim=PROJECTION_DIM,\n",
    "        num_heads=NUM_HEADS,\n",
    "        dropout_rate=CAF_ATTENTION_DROPOUT,\n",
    "        ffn_multiplier=CAF_FFN_MULTIPLIER,\n",
    "        name='gated_bidirectional_cross_attention',\n",
    "    )([cnn_tokens, vit_tokens])\n",
    "\n",
    "    cnn_vector = layers.GlobalAveragePooling1D(\n",
    "        name='caf_cnn_pool',\n",
    "    )(fused_cnn_tokens)\n",
    "\n",
    "    vit_vector = layers.GlobalAveragePooling1D(\n",
    "        name='caf_vit_pool',\n",
    "    )(fused_vit_tokens)\n",
    "\n",
    "    fused = BalancedConcatenation(\n",
    "        name='caf_balanced_concatenation',\n",
    "    )([cnn_vector, vit_vector])\n",
    "\n",
    "    outputs = shared_classifier_head(fused, prefix='evit_caf')\n",
    "\n",
    "    return (\n",
    "        Model(inputs, outputs, name='EVit_CAF_Gated'),\n",
    "        backbone,\n",
    "        pretrained_loaded,\n",
    "    )\n",
    "\n",
    "\n",
    "\n",
    "def build_evit_dap_concat():\n",
    "    \"\"\"Disease-area decoupling without cross-attention or dynamic fusion.\"\"\"\n",
    "\n",
    "    inputs = layers.Input(\n",
    "        shape=(IMAGE_HEIGHT, IMAGE_WIDTH, 3),\n",
    "        name='evit_dap_concat_input',\n",
    "    )\n",
    "\n",
    "    backbone, pretrained_loaded = safe_application_backbone(\n",
    "        tf.keras.applications.EfficientNetV2B0,\n",
    "        architecture_name='EVit-DAP-Concat EfficientNetV2-B0',\n",
    "        include_top=False,\n",
    "        include_preprocessing=True,\n",
    "        input_shape=(IMAGE_HEIGHT, IMAGE_WIDTH, 3),\n",
    "    )\n",
    "\n",
    "    cnn_features = backbone(inputs, training=False)\n",
    "    cnn_features = layers.Conv2D(\n",
    "        PROJECTION_DIM,\n",
    "        1,\n",
    "        padding='same',\n",
    "        use_bias=False,\n",
    "        name='dap_concat_cnn_projection',\n",
    "    )(cnn_features)\n",
    "    cnn_features = layers.BatchNormalization(\n",
    "        name='dap_concat_cnn_projection_bn',\n",
    "    )(cnn_features)\n",
    "    cnn_features = layers.Activation(\n",
    "        'swish',\n",
    "        name='dap_concat_cnn_projection_activation',\n",
    "    )(cnn_features)\n",
    "\n",
    "    lesion_features, context_features, disease_mask = (\n",
    "        MultiScaleDiseaseAreaDecoupler(\n",
    "            hidden_dim=DAP_HIDDEN_DIM,\n",
    "            min_area=DAP_MIN_AREA,\n",
    "            max_area=DAP_MAX_AREA,\n",
    "            area_loss_weight=DAP_AREA_LOSS_WEIGHT,\n",
    "            tv_loss_weight=DAP_TV_LOSS_WEIGHT,\n",
    "            name='dap_concat_disease_area_decoupling',\n",
    "        )(cnn_features)\n",
    "    )\n",
    "\n",
    "    lesion_vector = layers.GlobalAveragePooling2D(\n",
    "        name='dap_concat_lesion_pool',\n",
    "    )(lesion_features)\n",
    "    context_vector = layers.GlobalAveragePooling2D(\n",
    "        name='dap_concat_context_pool',\n",
    "    )(context_features)\n",
    "\n",
    "    vit_images = layers.Rescaling(\n",
    "        1.0 / 255.0,\n",
    "        name='dap_concat_vit_rescaling',\n",
    "    )(inputs)\n",
    "    number_of_patches = (\n",
    "        IMAGE_HEIGHT // PATCH_SIZE\n",
    "    ) * (\n",
    "        IMAGE_WIDTH // PATCH_SIZE\n",
    "    )\n",
    "    vit_tokens = Patches(\n",
    "        PATCH_SIZE,\n",
    "        name='dap_concat_patch_extraction',\n",
    "    )(vit_images)\n",
    "    vit_tokens = PatchEncoder(\n",
    "        number_of_patches,\n",
    "        PROJECTION_DIM,\n",
    "        name='dap_concat_patch_encoder',\n",
    "    )(vit_tokens)\n",
    "\n",
    "    for block_index in range(NUM_TRANSFORMER_BLOCKS):\n",
    "        vit_tokens = TransformerEncoder(\n",
    "            projection_dim=PROJECTION_DIM,\n",
    "            num_heads=NUM_HEADS,\n",
    "            mlp_dim=TRANSFORMER_MLP_DIM,\n",
    "            dropout_rate=DROPOUT_RATE,\n",
    "            name=f'dap_concat_transformer_block_{block_index + 1}',\n",
    "        )(vit_tokens)\n",
    "\n",
    "    vit_vector = layers.GlobalAveragePooling1D(\n",
    "        name='dap_concat_vit_pool',\n",
    "    )(vit_tokens)\n",
    "\n",
    "    fused = MultiBranchBalancedConcatenation(\n",
    "        name='dap_concat_balanced_concatenation',\n",
    "    )([lesion_vector, context_vector, vit_vector])\n",
    "\n",
    "    outputs = shared_classifier_head(\n",
    "        fused,\n",
    "        prefix='evit_dap_concat',\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        Model(inputs, outputs, name='EVit_DAP_Concat'),\n",
    "        backbone,\n",
    "        pretrained_loaded,\n",
    "    )\n",
    "\n",
    "\n",
    "def build_evit_dap_caf():\n",
    "    \"\"\"Disease-area decoupling plus lesion-guided CAF, without adaptive fusion.\"\"\"\n",
    "\n",
    "    inputs = layers.Input(\n",
    "        shape=(IMAGE_HEIGHT, IMAGE_WIDTH, 3),\n",
    "        name='evit_dap_caf_input',\n",
    "    )\n",
    "\n",
    "    backbone, pretrained_loaded = safe_application_backbone(\n",
    "        tf.keras.applications.EfficientNetV2B0,\n",
    "        architecture_name='EVit-DAP-CAF EfficientNetV2-B0',\n",
    "        include_top=False,\n",
    "        include_preprocessing=True,\n",
    "        input_shape=(IMAGE_HEIGHT, IMAGE_WIDTH, 3),\n",
    "    )\n",
    "\n",
    "    cnn_features = backbone(inputs, training=False)\n",
    "    cnn_features = layers.Conv2D(\n",
    "        PROJECTION_DIM,\n",
    "        1,\n",
    "        padding='same',\n",
    "        use_bias=False,\n",
    "        name='dap_caf_cnn_projection',\n",
    "    )(cnn_features)\n",
    "    cnn_features = layers.BatchNormalization(\n",
    "        name='dap_caf_cnn_projection_bn',\n",
    "    )(cnn_features)\n",
    "    cnn_features = layers.Activation(\n",
    "        'swish',\n",
    "        name='dap_caf_cnn_projection_activation',\n",
    "    )(cnn_features)\n",
    "\n",
    "    lesion_features, context_features, disease_mask = (\n",
    "        MultiScaleDiseaseAreaDecoupler(\n",
    "            hidden_dim=DAP_HIDDEN_DIM,\n",
    "            min_area=DAP_MIN_AREA,\n",
    "            max_area=DAP_MAX_AREA,\n",
    "            area_loss_weight=DAP_AREA_LOSS_WEIGHT,\n",
    "            tv_loss_weight=DAP_TV_LOSS_WEIGHT,\n",
    "            name='dap_caf_disease_area_decoupling',\n",
    "        )(cnn_features)\n",
    "    )\n",
    "\n",
    "    lesion_tokens = layers.Reshape(\n",
    "        (-1, PROJECTION_DIM),\n",
    "        name='dap_caf_lesion_tokens',\n",
    "    )(lesion_features)\n",
    "    lesion_scores = layers.Reshape(\n",
    "        (-1, 1),\n",
    "        name='dap_caf_lesion_scores',\n",
    "    )(disease_mask)\n",
    "    context_vector = layers.GlobalAveragePooling2D(\n",
    "        name='dap_caf_context_pool',\n",
    "    )(context_features)\n",
    "\n",
    "    vit_images = layers.Rescaling(\n",
    "        1.0 / 255.0,\n",
    "        name='dap_caf_vit_rescaling',\n",
    "    )(inputs)\n",
    "    number_of_patches = (\n",
    "        IMAGE_HEIGHT // PATCH_SIZE\n",
    "    ) * (\n",
    "        IMAGE_WIDTH // PATCH_SIZE\n",
    "    )\n",
    "    vit_tokens = Patches(\n",
    "        PATCH_SIZE,\n",
    "        name='dap_caf_patch_extraction',\n",
    "    )(vit_images)\n",
    "    vit_tokens = PatchEncoder(\n",
    "        number_of_patches,\n",
    "        PROJECTION_DIM,\n",
    "        name='dap_caf_patch_encoder',\n",
    "    )(vit_tokens)\n",
    "\n",
    "    for block_index in range(NUM_TRANSFORMER_BLOCKS):\n",
    "        vit_tokens = TransformerEncoder(\n",
    "            projection_dim=PROJECTION_DIM,\n",
    "            num_heads=NUM_HEADS,\n",
    "            mlp_dim=TRANSFORMER_MLP_DIM,\n",
    "            dropout_rate=DROPOUT_RATE,\n",
    "            name=f'dap_caf_transformer_block_{block_index + 1}',\n",
    "        )(vit_tokens)\n",
    "\n",
    "    fused_lesion_tokens, fused_vit_tokens, cross_gates = (\n",
    "        LesionGuidedDynamicCrossAttention(\n",
    "            projection_dim=PROJECTION_DIM,\n",
    "            num_heads=NUM_HEADS,\n",
    "            dropout_rate=CAF_ATTENTION_DROPOUT,\n",
    "            gate_hidden_dim=64,\n",
    "            name='dap_caf_lesion_guided_cross_attention',\n",
    "        )([lesion_tokens, vit_tokens, lesion_scores])\n",
    "    )\n",
    "\n",
    "    lesion_vector = layers.GlobalAveragePooling1D(\n",
    "        name='dap_caf_lesion_pool',\n",
    "    )(fused_lesion_tokens)\n",
    "    vit_vector = layers.GlobalAveragePooling1D(\n",
    "        name='dap_caf_vit_pool',\n",
    "    )(fused_vit_tokens)\n",
    "\n",
    "    fused = MultiBranchBalancedConcatenation(\n",
    "        name='dap_caf_balanced_concatenation',\n",
    "    )([lesion_vector, context_vector, vit_vector, cross_gates])\n",
    "\n",
    "    outputs = shared_classifier_head(\n",
    "        fused,\n",
    "        prefix='evit_dap_caf',\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        Model(inputs, outputs, name='EVit_DAP_CAF'),\n",
    "        backbone,\n",
    "        pretrained_loaded,\n",
    "    )\n",
    "\n",
