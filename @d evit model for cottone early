    "# ============================================================\n",
    "# CELL 17 — RECOVER ALL COMPLETED CLASSIFICATION RESULTS\n",
    "# ============================================================\n",
    "\n",
    "saved_metric_files = sorted(\n",
    "    MODEL_DIR.rglob(\n",
    "        'complete_metrics.json'\n",
    "    )\n",
    ")\n",
    "\n",
    "recovered_results = []\n",
    "\n",
    "for metric_file in saved_metric_files:\n",
    "    try:\n",
    "        with open(\n",
    "            metric_file,\n",
    "            'r',\n",
    "            encoding='utf-8',\n",
    "        ) as file:\n",
    "            recovered_results.append(\n",
    "                json.load(file)\n",
    "            )\n",
    "    except Exception as error:\n",
    "        print(\n",
    "            f'Could not read {metric_file}: '\n",
    "            f'{error}',\n",
    "            flush=True,\n",
    "        )\n",
    "\n",
    "results_df = pd.DataFrame(\n",
    "    recovered_results\n",
    ")\n",
    "\n",
    "if results_df.empty:\n",
    "    raise RuntimeError(\n",
    "        'No completed model metrics were found. '\n",
    "        'Inspect each model folder for failure.json '\n",
    "        'or rerun Cell 16.'\n",
    "    )\n",
    "\n",
    "results_df = (\n",
    "    results_df\n",
    "    .drop_duplicates(\n",
    "        subset=[\n",
    "            'model',\n",
    "            'seed',\n",
    "        ],\n",
    "        keep='last',\n",
    "    )\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "results_df.to_csv(\n",
    "    TABLE_DIR\n",
    "    / 'recovered_all_run_results.csv',\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "all_histories = {}\n",
    "\n",
    "for _, result_row in results_df.iterrows():\n",
    "    model_name = result_row['model']\n",
    "    seed = int(result_row['seed'])\n",
    "\n",
    "    history_path = (\n",
    "        MODEL_DIR\n",
    "        / clean_model_name(model_name)\n",
    "        / f'seed_{seed}'\n",
    "        / 'combined_history.csv'\n",
    "    )\n",
    "\n",
    "    if history_path.exists():\n",
    "        all_histories[\n",
    "            (\n",
    "                model_name,\n",
    "                seed,\n",
    "            )\n",
    "        ] = pd.read_csv(\n",
    "            history_path\n",
    "        )\n",
    "\n",
    "show_progress(\n",
    "    f'Recovered {len(results_df)} '\n",
    "    f'completed model runs'\n",
    ")\n",
