    "train_hashes['sha256'] = train_hashes['filepath'].map(sha256_file)\n",
    "test_hashes['sha256'] = test_hashes['filepath'].map(sha256_file)\n",
    "\n",
    "cross_split_duplicates = train_hashes.merge(\n",
    "    test_hashes,\n",
    "    on='sha256',\n",
    "    suffixes=('_train', '_test'),\n",
