    "# CELL 8 — SERIALIZABLE TRANSFORMER, LOSS AND FUSION LAYERS\n",
    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class Patches(layers.Layer):\n",
    "\n",
    "    def __init__(self, patch_size: int, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.patch_size = patch_size\n",
    "\n",
    "    def call(self, images):\n",
    "        batch_size = tf.shape(images)[0]\n",
    "\n",
    "        patches = tf.image.extract_patches(\n",
    "            images=images,\n",
    "            sizes=[1, self.patch_size, self.patch_size, 1],\n",
    "            strides=[1, self.patch_size, self.patch_size, 1],\n",
    "            rates=[1, 1, 1, 1],\n",
    "            padding='VALID',\n",
    "        )\n",
    "\n",
    "        patch_dimensions = (\n",
    "            self.patch_size * self.patch_size * images.shape[-1]\n",
    "        )\n",
    "\n",
    "        return tf.reshape(\n",
    "            patches,\n",
    "            [batch_size, -1, patch_dimensions],\n",
    "        )\n",
    "\n",
    "    def get_config(self):\n",
    "        configuration = super().get_config()\n",
    "        configuration.update({'patch_size': self.patch_size})\n",
    "        return configuration\n",
    "\n",
    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class PatchEncoder(layers.Layer):\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        num_patches: int,\n",
    "        projection_dim: int,\n",
    "        **kwargs,\n",
    "    ):\n",
    "        super().__init__(**kwargs)\n",
    "        self.num_patches = num_patches\n",
    "        self.projection_dim = projection_dim\n",
    "        self.projection = layers.Dense(projection_dim)\n",
    "        self.position_embedding = layers.Embedding(\n",
    "            input_dim=num_patches,\n",
    "            output_dim=projection_dim,\n",
    "        )\n",
    "\n",
    "    def call(self, patches):\n",
    "        positions = tf.range(\n",
    "            start=0,\n",
    "            limit=self.num_patches,\n",
    "            delta=1,\n",
    "        )\n",
    "\n",
    "        return (\n",
    "            self.projection(patches)\n",
    "            + self.position_embedding(positions)\n",
    "        )\n",
    "\n",
    "    def get_config(self):\n",
    "        configuration = super().get_config()\n",
    "        configuration.update(\n",
    "            {\n",
    "                'num_patches': self.num_patches,\n",
    "                'projection_dim': self.projection_dim,\n",
    "            }\n",
    "        )\n",
    "        return configuration\n",
    "\n",
    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class TransformerEncoder(layers.Layer):\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        projection_dim: int,\n",
    "        num_heads: int,\n",
    "        mlp_dim: int,\n",
    "        dropout_rate: float = 0.1,\n",
    "        **kwargs,\n",
    "    ):\n",
    "        super().__init__(**kwargs)\n",
    "        self.projection_dim = projection_dim\n",
    "        self.num_heads = num_heads\n",
    "        self.mlp_dim = mlp_dim\n",
    "        self.dropout_rate = dropout_rate\n",
    "\n",
    "        self.norm_1 = layers.LayerNormalization(epsilon=1e-6)\n",
    "        self.attention = layers.MultiHeadAttention(\n",
    "            num_heads=num_heads,\n",
    "            key_dim=projection_dim // num_heads,\n",
    "            dropout=dropout_rate,\n",
    "        )\n",
    "        self.attention_dropout = layers.Dropout(dropout_rate)\n",
    "        self.norm_2 = layers.LayerNormalization(epsilon=1e-6)\n",
    "\n",
    "        self.mlp = tf.keras.Sequential(\n",
    "            [\n",
    "                layers.Dense(mlp_dim, activation='gelu'),\n",
    "                layers.Dropout(dropout_rate),\n",
    "                layers.Dense(projection_dim),\n",
    "                layers.Dropout(dropout_rate),\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    def call(self, inputs, training=False):\n",
    "        normalized = self.norm_1(inputs)\n",
    "\n",
    "        attended = self.attention(\n",
    "            normalized,\n",
    "            normalized,\n",
    "            training=training,\n",
    "        )\n",
    "\n",
    "        attended = self.attention_dropout(\n",
    "            attended,\n",
    "            training=training,\n",
    "        )\n",
    "\n",
    "        first_residual = inputs + attended\n",
    "\n",
    "        mlp_output = self.mlp(\n",
    "            self.norm_2(first_residual),\n",
    "            training=training,\n",
    "        )\n",
    "\n",
    "        return first_residual + mlp_output\n",
    "\n",
    "    def get_config(self):\n",
    "        configuration = super().get_config()\n",
    "        configuration.update(\n",
    "            {\n",
    "                'projection_dim': self.projection_dim,\n",
    "                'num_heads': self.num_heads,\n",
    "                'mlp_dim': self.mlp_dim,\n",
    "                'dropout_rate': self.dropout_rate,\n",
    "            }\n",
    "        )\n",
    "        return configuration\n",
    "\n",
    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class SparseLabelSmoothingCrossentropy(tf.keras.losses.Loss):\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        num_classes: int,\n",
    "        label_smoothing: float = 0.0,\n",
    "        name: str = 'sparse_label_smoothing_crossentropy',\n",
    "        **kwargs,\n",
    "    ):\n",
    "        super().__init__(name=name, **kwargs)\n",
    "        self.num_classes = num_classes\n",
    "        self.label_smoothing = label_smoothing\n",
    "\n",
    "    def call(self, y_true, y_pred):\n",
    "        y_true = tf.cast(tf.reshape(y_true, [-1]), tf.int32)\n",
    "\n",
    "        one_hot_labels = tf.one_hot(\n",
    "            y_true,\n",
    "            depth=self.num_classes,\n",
    "            dtype=y_pred.dtype,\n",
    "        )\n",
    "\n",
    "        return tf.keras.losses.categorical_crossentropy(\n",
    "            one_hot_labels,\n",
    "            y_pred,\n",
    "            label_smoothing=self.label_smoothing,\n",
    "        )\n",
    "\n",
    "    def get_config(self):\n",
    "        configuration = super().get_config()\n",
    "        configuration.update(\n",
    "            {\n",
    "                'num_classes': self.num_classes,\n",
    "                'label_smoothing': self.label_smoothing,\n",
    "            }\n",
    "        )\n",
    "        return configuration\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class SparseMacroF1(tf.keras.metrics.Metric):\n",
    "    \"\"\"Streaming macro-F1 for sparse integer labels.\n",
    "\n",
    "    The metric accumulates one confusion matrix during the normal Keras\n",
    "    training or validation pass. It therefore removes the previous second,\n",
    "    silent full validation prediction at every epoch.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        num_classes: int,\n",
    "        name: str = 'macro_f1',\n",
    "        dtype=tf.float32,\n",
    "        **kwargs,\n",
    "    ):\n",
    "        super().__init__(name=name, dtype=dtype, **kwargs)\n",
    "        self.num_classes = int(num_classes)\n",
    "        self.confusion_matrix_state = self.add_weight(\n",
    "            name='confusion_matrix',\n",
    "            shape=(self.num_classes, self.num_classes),\n",
    "            initializer='zeros',\n",
    "            dtype=tf.float32,\n",
    "        )\n",
    "\n",
    "    def update_state(self, y_true, y_pred, sample_weight=None):\n",
    "        y_true = tf.cast(tf.reshape(y_true, [-1]), tf.int32)\n",
    "        y_pred = tf.argmax(y_pred, axis=-1, output_type=tf.int32)\n",
    "        y_pred = tf.reshape(y_pred, [-1])\n",
    "\n",
    "        weights = None\n",
    "        if sample_weight is not None:\n",
    "            weights = tf.cast(tf.reshape(sample_weight, [-1]), tf.float32)\n",
    "\n",
    "        batch_matrix = tf.math.confusion_matrix(\n",
    "            labels=y_true,\n",
    "            predictions=y_pred,\n",
    "            num_classes=self.num_classes,\n",
    "            weights=weights,\n",
    "            dtype=tf.float32,\n",
    "        )\n",
    "\n",
    "        self.confusion_matrix_state.assign_add(batch_matrix)\n",
    "\n",
    "    def result(self):\n",
    "        matrix = self.confusion_matrix_state\n",
    "        true_positives = tf.linalg.diag_part(matrix)\n",
    "        false_positives = tf.reduce_sum(matrix, axis=0) - true_positives\n",
    "        false_negatives = tf.reduce_sum(matrix, axis=1) - true_positives\n",
    "\n",
    "        precision = tf.math.divide_no_nan(\n",
    "            true_positives,\n",
    "            true_positives + false_positives,\n",
    "        )\n",
    "        recall = tf.math.divide_no_nan(\n",
    "            true_positives,\n",
    "            true_positives + false_negatives,\n",
    "        )\n",
    "        class_f1 = tf.math.divide_no_nan(\n",
    "            2.0 * precision * recall,\n",
    "            precision + recall,\n",
    "        )\n",
    "        return tf.reduce_mean(class_f1)\n",
    "\n",
    "    def reset_state(self):\n",
    "        self.confusion_matrix_state.assign(\n",
    "            tf.zeros_like(self.confusion_matrix_state)\n",
    "        )\n",
    "\n",
    "    def get_config(self):\n",
    "        configuration = super().get_config()\n",
    "        configuration.update({'num_classes': self.num_classes})\n",
    "        return configuration\n",
    "\n",
    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class GatedBidirectionalCrossAttention(layers.Layer):\n",
    "    \"\"\"\n",
    "    Zero-initialised residual cross-attention.\n",
    "\n",
    "    At initialisation, tanh(scale) = 0, so the layer behaves like an\n",
    "    identity mapping. Cross-branch information is learned only when it\n",
    "    improves the training objective.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        projection_dim: int,\n",
    "        num_heads: int,\n",
    "        dropout_rate: float = 0.1,\n",
    "        ffn_multiplier: int = 2,\n",
    "        **kwargs,\n",
    "    ):\n",
    "        super().__init__(**kwargs)\n",
    "        self.projection_dim = projection_dim\n",
    "        self.num_heads = num_heads\n",
    "        self.dropout_rate = dropout_rate\n",
    "        self.ffn_multiplier = ffn_multiplier\n",
    "\n",
    "        head_dimension = projection_dim // num_heads\n",
    "\n",
    "        self.cnn_query_norm = layers.LayerNormalization(epsilon=1e-6)\n",
    "        self.vit_query_norm = layers.LayerNormalization(epsilon=1e-6)\n",
    "        self.cnn_ffn_norm = layers.LayerNormalization(epsilon=1e-6)\n",
    "        self.vit_ffn_norm = layers.LayerNormalization(epsilon=1e-6)\n",
    "\n",
    "        self.cnn_queries_vit = layers.MultiHeadAttention(\n",
    "            num_heads=num_heads,\n",
    "            key_dim=head_dimension,\n",
    "            dropout=dropout_rate,\n",
    "        )\n",
    "\n",
    "        self.vit_queries_cnn = layers.MultiHeadAttention(\n",
    "            num_heads=num_heads,\n",
    "            key_dim=head_dimension,\n",
    "            dropout=dropout_rate,\n",
    "        )\n",
    "\n",
    "        self.cnn_context_dropout = layers.Dropout(dropout_rate)\n",
    "        self.vit_context_dropout = layers.Dropout(dropout_rate)\n",
    "\n",
    "        hidden_dimension = projection_dim * ffn_multiplier\n",
    "\n",
    "        self.cnn_ffn = tf.keras.Sequential(\n",
    "            [\n",
    "                layers.Dense(hidden_dimension, activation='gelu'),\n",
    "                layers.Dropout(dropout_rate),\n",
    "                layers.Dense(projection_dim),\n",
    "                layers.Dropout(dropout_rate),\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        self.vit_ffn = tf.keras.Sequential(\n",
    "            [\n",
    "                layers.Dense(hidden_dimension, activation='gelu'),\n",
    "                layers.Dropout(dropout_rate),\n",
    "                layers.Dense(projection_dim),\n",
    "                layers.Dropout(dropout_rate),\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    def build(self, input_shape):\n",
    "        self.cnn_cross_scale = self.add_weight(\n",
    "            name='cnn_cross_scale',\n",
    "            shape=(),\n",
    "            initializer='zeros',\n",
    "            trainable=True,\n",
    "        )\n",
    "\n",
    "        self.vit_cross_scale = self.add_weight(\n",
    "            name='vit_cross_scale',\n",
    "            shape=(),\n",
    "            initializer='zeros',\n",
    "            trainable=True,\n",
    "        )\n",
    "\n",
    "        self.cnn_ffn_scale = self.add_weight(\n",
    "            name='cnn_ffn_scale',\n",
    "            shape=(),\n",
    "            initializer='zeros',\n",
    "            trainable=True,\n",
    "        )\n",
    "\n",
    "        self.vit_ffn_scale = self.add_weight(\n",
    "            name='vit_ffn_scale',\n",
    "            shape=(),\n",
    "            initializer='zeros',\n",
    "            trainable=True,\n",
    "        )\n",
    "\n",
    "        super().build(input_shape)\n",
    "\n",
    "    def call(self, inputs, training=False):\n",
    "        cnn_tokens, vit_tokens = inputs\n",
    "\n",
    "        normalized_cnn = self.cnn_query_norm(cnn_tokens)\n",
    "        normalized_vit = self.vit_query_norm(vit_tokens)\n",
    "\n",
    "        cnn_context = self.cnn_queries_vit(\n",
    "            query=normalized_cnn,\n",
    "            key=normalized_vit,\n",
    "            value=normalized_vit,\n",
    "            training=training,\n",
    "        )\n",
    "\n",
    "        vit_context = self.vit_queries_cnn(\n",
    "            query=normalized_vit,\n",
    "            key=normalized_cnn,\n",
    "            value=normalized_cnn,\n",
    "            training=training,\n",
    "        )\n",
    "\n",
    "        cnn_context = self.cnn_context_dropout(\n",
    "            cnn_context,\n",
    "            training=training,\n",
    "        )\n",
    "\n",
    "        vit_context = self.vit_context_dropout(\n",
    "            vit_context,\n",
    "            training=training,\n",
    "        )\n",
    "\n",
    "        cnn_tokens = (\n",
    "            cnn_tokens\n",
    "            + tf.cast(\n",
    "                tf.tanh(self.cnn_cross_scale),\n",
    "                cnn_tokens.dtype,\n",
    "            )\n",
    "            * cnn_context\n",
    "        )\n",
    "\n",
    "        vit_tokens = (\n",
    "            vit_tokens\n",
    "            + tf.cast(\n",
    "                tf.tanh(self.vit_cross_scale),\n",
    "                vit_tokens.dtype,\n",
    "            )\n",
    "            * vit_context\n",
    "        )\n",
    "\n",
    "        cnn_ffn_output = self.cnn_ffn(\n",
    "            self.cnn_ffn_norm(cnn_tokens),\n",
    "            training=training,\n",
    "        )\n",
    "\n",
    "        vit_ffn_output = self.vit_ffn(\n",
    "            self.vit_ffn_norm(vit_tokens),\n",
    "            training=training,\n",
    "        )\n",
    "\n",
    "        cnn_tokens = (\n",
    "            cnn_tokens\n",
    "            + tf.cast(\n",
    "                tf.tanh(self.cnn_ffn_scale),\n",
    "                cnn_tokens.dtype,\n",
    "            )\n",
    "            * cnn_ffn_output\n",
    "        )\n",
    "\n",
    "        vit_tokens = (\n",
    "            vit_tokens\n",
    "            + tf.cast(\n",
    "                tf.tanh(self.vit_ffn_scale),\n",
    "                vit_tokens.dtype,\n",
    "            )\n",
    "            * vit_ffn_output\n",
    "        )\n",
    "\n",
    "        return cnn_tokens, vit_tokens\n",
    "\n",
    "    def get_config(self):\n",
    "        configuration = super().get_config()\n",
    "        configuration.update(\n",
    "            {\n",
    "                'projection_dim': self.projection_dim,\n",
    "                'num_heads': self.num_heads,\n",
    "                'dropout_rate': self.dropout_rate,\n",
    "                'ffn_multiplier': self.ffn_multiplier,\n",
    "            }\n",
    "        )\n",
    "        return configuration\n",
    "\n",
