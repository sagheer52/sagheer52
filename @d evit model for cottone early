    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class MultiScaleDiseaseAreaDecoupler(layers.Layer):\n",
    "    \"\"\"Weakly supervised disease-area perception and foreground/context decoupling.\n",
    "\n",
    "    Multi-scale depthwise-separable convolutions generate a soft disease mask.\n",
    "    The mask splits the CNN map into lesion-focused and complementary context maps.\n",
    "    Area and total-variation penalties discourage trivial or fragmented masks.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        hidden_dim: int = 48,\n",
    "        min_area: float = 0.03,\n",
    "        max_area: float = 0.45,\n",
    "        area_loss_weight: float = 1e-3,\n",
    "        tv_loss_weight: float = 1e-5,\n",
    "        **kwargs,\n",
    "    ):\n",
    "        super().__init__(**kwargs)\n",
    "        self.hidden_dim = hidden_dim\n",
    "        self.min_area = min_area\n",
    "        self.max_area = max_area\n",
    "        self.area_loss_weight = area_loss_weight\n",
    "        self.tv_loss_weight = tv_loss_weight\n",
    "\n",
    "        self.local_branch = layers.SeparableConv2D(\n",
    "            hidden_dim,\n",
    "            3,\n",
    "            padding='same',\n",
    "            activation='swish',\n",
    "        )\n",
    "        self.dilated_branch = layers.SeparableConv2D(\n",
    "            hidden_dim,\n",
    "            3,\n",
    "            padding='same',\n",
    "            dilation_rate=2,\n",
    "            activation='swish',\n",
    "        )\n",
    "        self.point_branch = layers.Conv2D(\n",
    "            hidden_dim,\n",
    "            1,\n",
    "            padding='same',\n",
    "            activation='swish',\n",
    "        )\n",
    "        self.fusion = layers.Conv2D(\n",
    "            hidden_dim,\n",
    "            1,\n",
    "            padding='same',\n",
    "            activation='swish',\n",
    "        )\n",
    "        self.mask_head = layers.Conv2D(\n",
    "            1,\n",
    "            1,\n",
    "            padding='same',\n",
    "            activation='sigmoid',\n",
    "            bias_initializer=tf.keras.initializers.Constant(-1.1),\n",
    "        )\n",
    "\n",
    "    def call(self, feature_map):\n",
    "        local_features = self.local_branch(feature_map)\n",
    "        dilated_features = self.dilated_branch(feature_map)\n",
    "        point_features = self.point_branch(feature_map)\n",
    "\n",
    "        perception_features = tf.concat(\n",
    "            [local_features, dilated_features, point_features],\n",
    "            axis=-1,\n",
    "        )\n",
    "        perception_features = self.fusion(perception_features)\n",
    "        disease_mask = self.mask_head(perception_features)\n",
    "\n",
    "        mask_float = tf.cast(disease_mask, tf.float32)\n",
    "        mean_area = tf.reduce_mean(mask_float, axis=[1, 2, 3])\n",
    "\n",
    "        area_penalty = tf.square(\n",
    "            tf.nn.relu(self.min_area - mean_area)\n",
    "        ) + tf.square(\n",
    "            tf.nn.relu(mean_area - self.max_area)\n",
    "        )\n",
    "\n",
    "        spatial_size = tf.cast(\n",
    "            tf.shape(mask_float)[1] * tf.shape(mask_float)[2],\n",
    "            tf.float32,\n",
    "        )\n",
    "        tv_penalty = tf.image.total_variation(mask_float) / tf.maximum(\n",
    "            spatial_size,\n",
    "            1.0,\n",
    "        )\n",
    "\n",
    "        self.add_loss(\n",
    "            self.area_loss_weight * tf.reduce_mean(area_penalty)\n",
    "            + self.tv_loss_weight * tf.reduce_mean(tv_penalty)\n",
    "        )\n",
    "\n",
    "        mask_for_features = tf.cast(disease_mask, feature_map.dtype)\n",
    "        lesion_features = feature_map * mask_for_features\n",
    "        context_features = feature_map * (1.0 - mask_for_features)\n",
    "\n",
    "        return lesion_features, context_features, disease_mask\n",
    "\n",
    "    def get_config(self):\n",
    "        configuration = super().get_config()\n",
    "        configuration.update(\n",
    "            {\n",
    "                'hidden_dim': self.hidden_dim,\n",
    "                'min_area': self.min_area,\n",
    "                'max_area': self.max_area,\n",
    "                'area_loss_weight': self.area_loss_weight,\n",
    "                'tv_loss_weight': self.tv_loss_weight,\n",
    "            }\n",
    "        )\n",
    "        return configuration\n",
    "\n",
    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class LesionGuidedDynamicCrossAttention(layers.Layer):\n",
    "    \"\"\"Bidirectional cross-attention conditioned by disease-area evidence.\n",
    "\n",
    "    The CNN-to-ViT and ViT-to-CNN residual strengths are predicted separately for\n",
    "    every image. The ViT queries lesion-weighted CNN keys/values, reducing the\n",
    "    influence of complex background regions.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        projection_dim: int,\n",
    "        num_heads: int,\n",
    "        dropout_rate: float = 0.1,\n",
    "        gate_hidden_dim: int = 64,\n",
    "        **kwargs,\n",
    "    ):\n",
    "        super().__init__(**kwargs)\n",
    "        self.projection_dim = projection_dim\n",
    "        self.num_heads = num_heads\n",
    "        self.dropout_rate = dropout_rate\n",
    "        self.gate_hidden_dim = gate_hidden_dim\n",
    "\n",
    "        head_dim = projection_dim // num_heads\n",
    "        self.cnn_norm = layers.LayerNormalization(epsilon=1e-6)\n",
    "        self.vit_norm = layers.LayerNormalization(epsilon=1e-6)\n",
    "\n",
    "        self.cnn_queries_vit = layers.MultiHeadAttention(\n",
    "            num_heads=num_heads,\n",
    "            key_dim=head_dim,\n",
    "            dropout=dropout_rate,\n",
    "        )\n",
    "        self.vit_queries_cnn = layers.MultiHeadAttention(\n",
    "            num_heads=num_heads,\n",
    "            key_dim=head_dim,\n",
    "            dropout=dropout_rate,\n",
    "        )\n",
    "\n",
    "        self.context_dropout = layers.Dropout(dropout_rate)\n",
    "        self.gate_hidden = layers.Dense(\n",
    "            gate_hidden_dim,\n",
    "            activation='swish',\n",
    "        )\n",
    "        self.gate_output = layers.Dense(\n",
    "            2,\n",
    "            activation='sigmoid',\n",
    "            kernel_initializer='zeros',\n",
    "            bias_initializer=tf.keras.initializers.Constant(-3.0),\n",
    "        )\n",
    "\n",
    "        self.cnn_ffn_norm = layers.LayerNormalization(epsilon=1e-6)\n",
    "        self.vit_ffn_norm = layers.LayerNormalization(epsilon=1e-6)\n",
    "        self.cnn_ffn = tf.keras.Sequential(\n",
    "            [\n",
    "                layers.Dense(projection_dim * 2, activation='gelu'),\n",
    "                layers.Dropout(dropout_rate),\n",
    "                layers.Dense(projection_dim),\n",
    "            ]\n",
    "        )\n",
    "        self.vit_ffn = tf.keras.Sequential(\n",
    "            [\n",
    "                layers.Dense(projection_dim * 2, activation='gelu'),\n",
    "                layers.Dropout(dropout_rate),\n",
    "                layers.Dense(projection_dim),\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    def call(self, inputs, training=False):\n",
    "        lesion_tokens, vit_tokens, lesion_scores = inputs\n",
    "\n",
    "        normalized_cnn = self.cnn_norm(lesion_tokens)\n",
    "        normalized_vit = self.vit_norm(vit_tokens)\n",
    "\n",
    "        lesion_scores = tf.cast(lesion_scores, normalized_cnn.dtype)\n",
    "        weighted_cnn = normalized_cnn * (0.5 + lesion_scores)\n",
    "\n",
    "        cnn_context = self.cnn_queries_vit(\n",
    "            query=normalized_cnn,\n",
    "            key=normalized_vit,\n",
    "            value=normalized_vit,\n",
    "            training=training,\n",
    "        )\n",
    "        vit_context = self.vit_queries_cnn(\n",
    "            query=normalized_vit,\n",
    "            key=weighted_cnn,\n",
    "            value=weighted_cnn,\n",
    "            training=training,\n",
    "        )\n",
    "\n",
    "        cnn_summary = tf.reduce_mean(normalized_cnn, axis=1)\n",
    "        vit_summary = tf.reduce_mean(normalized_vit, axis=1)\n",
    "        lesion_ratio = tf.reduce_mean(lesion_scores, axis=1)\n",
    "\n",
    "        gate_features = tf.concat(\n",
    "            [cnn_summary, vit_summary, lesion_ratio],\n",
    "            axis=-1,\n",
    "        )\n",
    "        gates = self.gate_output(self.gate_hidden(gate_features))\n",
    "\n",
    "        cnn_gate = tf.cast(gates[:, 0:1, None], lesion_tokens.dtype)\n",
    "        vit_gate = tf.cast(gates[:, 1:2, None], vit_tokens.dtype)\n",
    "\n",
    "        cnn_context = self.context_dropout(cnn_context, training=training)\n",
    "        vit_context = self.context_dropout(vit_context, training=training)\n",
    "\n",
    "        lesion_tokens = lesion_tokens + cnn_gate * cnn_context\n",
    "        vit_tokens = vit_tokens + vit_gate * vit_context\n",
    "\n",
    "        lesion_tokens = lesion_tokens + cnn_gate * self.cnn_ffn(\n",
    "            self.cnn_ffn_norm(lesion_tokens),\n",
    "            training=training,\n",
    "        )\n",
    "        vit_tokens = vit_tokens + vit_gate * self.vit_ffn(\n",
    "            self.vit_ffn_norm(vit_tokens),\n",
    "            training=training,\n",
    "        )\n",
    "\n",
    "        return lesion_tokens, vit_tokens, gates\n",
    "\n",
    "    def get_config(self):\n",
    "        configuration = super().get_config()\n",
    "        configuration.update(\n",
    "            {\n",
    "                'projection_dim': self.projection_dim,\n",
    "                'num_heads': self.num_heads,\n",
    "                'dropout_rate': self.dropout_rate,\n",
    "                'gate_hidden_dim': self.gate_hidden_dim,\n",
    "            }\n",
    "        )\n",
    "        return configuration\n",
    "\n",
    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class DynamicAdaptiveFusion(layers.Layer):\n",
    "    \"\"\"Sample-dependent mixture of lesion, global and interaction experts.\"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        fusion_dim: int = 128,\n",
    "        balance_loss_weight: float = 1e-4,\n",
    "        **kwargs,\n",
    "    ):\n",
    "        super().__init__(**kwargs)\n",
    "        self.fusion_dim = fusion_dim\n",
    "        self.balance_loss_weight = balance_loss_weight\n",
    "\n",
    "        self.lesion_projection = layers.Dense(\n",
    "            fusion_dim,\n",
    "            activation='gelu',\n",
    "        )\n",
    "        self.global_projection = layers.Dense(\n",
    "            fusion_dim,\n",
    "            activation='gelu',\n",
    "        )\n",
    "        self.interaction_projection = layers.Dense(\n",
    "            fusion_dim,\n",
    "            activation='gelu',\n",
    "        )\n",
    "        self.gate_hidden = layers.Dense(\n",
    "            fusion_dim,\n",
    "            activation='swish',\n",
    "        )\n",
    "        self.gate_logits = layers.Dense(\n",
    "            3,\n",
    "            kernel_initializer='zeros',\n",
    "            bias_initializer='zeros',\n",
    "        )\n",
    "\n",
    "    def call(self, inputs):\n",
    "        lesion_vector, context_vector, vit_vector, cross_gates = inputs\n",
    "\n",
    "        lesion_expert = self.lesion_projection(lesion_vector)\n",
    "        global_expert = self.global_projection(vit_vector)\n",
    "        interaction_expert = self.interaction_projection(\n",
    "            tf.concat([lesion_vector, vit_vector], axis=-1)\n",
    "        )\n",
    "\n",
    "        gate_features = tf.concat(\n",
    "            [lesion_vector, context_vector, vit_vector, cross_gates],\n",
    "            axis=-1,\n",
    "        )\n",
    "        fusion_weights = tf.nn.softmax(\n",
    "            self.gate_logits(self.gate_hidden(gate_features)),\n",
    "            axis=-1,\n",
    "        )\n",
    "\n",
    "        expert_stack = tf.stack(\n",
    "            [lesion_expert, global_expert, interaction_expert],\n",
    "            axis=1,\n",
    "        )\n",
    "        fused = tf.reduce_sum(\n",
    "            tf.cast(fusion_weights[..., None], expert_stack.dtype)\n",
    "            * expert_stack,\n",
    "            axis=1,\n",
    "        )\n",
    "\n",
    "        batch_mean_weights = tf.reduce_mean(\n",
    "            tf.cast(fusion_weights, tf.float32),\n",
    "            axis=0,\n",
    "        )\n",
    "        uniform_weights = tf.ones_like(batch_mean_weights) / 3.0\n",
    "        self.add_loss(\n",
    "            self.balance_loss_weight\n",
    "            * tf.reduce_sum(\n",
    "                tf.square(batch_mean_weights - uniform_weights)\n",
    "            )\n",
    "        )\n",
    "\n",
    "        return fused, fusion_weights\n",
    "\n",
    "    def get_config(self):\n",
    "        configuration = super().get_config()\n",
    "        configuration.update(\n",
    "            {\n",
    "                'fusion_dim': self.fusion_dim,\n",
    "                'balance_loss_weight': self.balance_loss_weight,\n",
    "            }\n",
    "        )\n",
    "        return configuration\n",
    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class BalancedConcatenation(layers.Layer):\n",
    "    \"\"\"Learn two global branch weights and then concatenate both branches.\"\"\"\n",
    "\n",
    "    def build(self, input_shape):\n",
    "        self.branch_logits = self.add_weight(\n",
    "            name='branch_logits',\n",
    "            shape=(2,),\n",
    "            initializer='zeros',\n",
    "            trainable=True,\n",
    "        )\n",
    "        super().build(input_shape)\n",
    "\n",
    "    def call(self, inputs):\n",
    "        cnn_vector, vit_vector = inputs\n",
    "        branch_weights = tf.nn.softmax(self.branch_logits)\n",
    "\n",
    "        cnn_weight = tf.cast(branch_weights[0], cnn_vector.dtype)\n",
    "        vit_weight = tf.cast(branch_weights[1], vit_vector.dtype)\n",
    "\n",
    "        return tf.concat(\n",
    "            [\n",
    "                cnn_weight * cnn_vector,\n",
    "                vit_weight * vit_vector,\n",
    "            ],\n",
    "            axis=-1,\n",
    "        )\n",
    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class MultiBranchBalancedConcatenation(layers.Layer):\n",
    "    \"\"\"Learn global weights for an arbitrary number of feature branches.\"\"\"\n",
    "\n",
    "    def build(self, input_shape):\n",
    "        branch_count = len(input_shape)\n",
    "\n",
    "        if branch_count < 2:\n",
    "            raise ValueError(\n",
    "                'MultiBranchBalancedConcatenation requires '\n",
    "                'at least two input branches.'\n",
    "            )\n",
    "\n",
    "        self.branch_logits = self.add_weight(\n",
    "            name='branch_logits',\n",
    "            shape=(branch_count,),\n",
    "            initializer='zeros',\n",
    "            trainable=True,\n",
    "        )\n",
    "\n",
    "        super().build(input_shape)\n",
    "\n",
    "    def call(self, inputs):\n",
    "        branch_weights = tf.nn.softmax(\n",
    "            self.branch_logits\n",
    "        )\n",
    "\n",
    "        weighted_inputs = [\n",
    "            tf.cast(\n",
    "                branch_weights[index],\n",
    "                branch.dtype,\n",
    "            ) * branch\n",
    "\n",
    "            for index, branch\n",
    "            in enumerate(inputs)\n",
    "        ]\n",
    "\n",
    "        return tf.concat(\n",
    "            weighted_inputs,\n",
    "            axis=-1,\n",
    "        )\n",
    "\n",
    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class ResNetPreprocessing(layers.Layer):\n",
    "\n",
    "    def call(self, inputs):\n",
    "        return tf.keras.applications.resnet50.preprocess_input(inputs)\n",
