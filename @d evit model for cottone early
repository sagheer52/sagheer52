    "# ============================================================\n",
    "# CELL 15 — EFFICIENCY, SAFE LATENCY AND SCIENTIFIC PLOTS\n",
    "# ============================================================\n",
    "\n",
    "plt.style.use('default')\n",
    "plt.rcParams.update(\n",
    "    {\n",
    "        'figure.dpi': 120,\n",
    "        'font.family': 'DejaVu Sans',\n",
    "        'font.size': 10,\n",
    "        'axes.titlesize': 14,\n",
    "        'axes.titleweight': 'bold',\n",
    "        'axes.labelsize': 11,\n",
    "        'axes.labelweight': 'bold',\n",
    "        'legend.frameon': False,\n",
    "        'axes.spines.top': False,\n",
    "        'axes.spines.right': False,\n",
    "        'grid.alpha': 0.25,\n",
    "        'savefig.dpi': 600,\n",
    "        'savefig.bbox': 'tight',\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "def calculate_efficiency_metrics(\n",
    "    model: Model,\n",
    "    model_name: str,\n",
    "    seed: int,\n",
    "):\n",
    "    run_directory = (\n",
    "        MODEL_DIR\n",
    "        / clean_model_name(model_name)\n",
    "        / f'seed_{seed}'\n",
    "    )\n",
    "\n",
    "    total_parameters = int(model.count_params())\n",
    "    trainable_parameters = int(\n",
    "        np.sum(\n",
    "            [\n",
    "                np.prod(weight.shape)\n",
    "                for weight in model.trainable_weights\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "    deployment_weights_path = (\n",
    "        run_directory\n",
    "        / 'deployment_weights.weights.h5'\n",
    "    )\n",
    "    model.save_weights(deployment_weights_path)\n",
    "\n",
    "    return {\n",
    "        'total_parameters': total_parameters,\n",
    "        'trainable_parameters': trainable_parameters,\n",
    "        'weights_size_mb': float(\n",
    "            deployment_weights_path.stat().st_size\n",
    "            / (1024 ** 2)\n",
    "        ),\n",
    "    }\n",
    "\n",
    "\n",
    "def measure_inference_latency_safe(\n",
    "    model: Model,\n",
    "    dataset: tf.data.Dataset,\n",
    "    number_of_images: int = 100,\n",
    "    warmup_batches: int = 10,\n",
    "    repetitions: int = 3,\n",
    ") -> float:\n",
    "    \"\"\"Measure median latency without allowing timing failure to stop results.\"\"\"\n",
    "    try:\n",
    "        benchmark_batches = list(\n",
    "            dataset\n",
    "            .unbatch()\n",
    "            .take(number_of_images)\n",
    "            .batch(BATCH_SIZE)\n",
    "        )\n",
    "\n",
    "        if not benchmark_batches:\n",
    "            return float('nan')\n",
    "\n",
    "        @tf.function(\n",
    "            reduce_retracing=True,\n",
    "            jit_compile=False,\n",
    "        )\n",
    "        def inference_step(images):\n",
    "            return model(images, training=False)\n",
    "\n",
    "        show_progress(\n",
    "            f'Latency warm-up: {warmup_batches} batches'\n",
    "        )\n",
    "\n",
    "        for warmup_index in range(warmup_batches):\n",
    "            images, _ = benchmark_batches[\n",
    "                warmup_index % len(benchmark_batches)\n",
    "            ]\n",
    "            outputs = inference_step(images)\n",
    "            _ = outputs.numpy()  # GPU synchronisation\n",
    "\n",
    "        measurements = []\n",
    "\n",
    "        for repetition in range(repetitions):\n",
    "            processed_images = 0\n",
    "            start_time = time.perf_counter()\n",
    "\n",
    "            for images, _ in benchmark_batches:\n",
    "                outputs = inference_step(images)\n",
    "                _ = outputs.numpy()\n",
    "                processed_images += int(images.shape[0])\n",
    "\n",
    "            elapsed = time.perf_counter() - start_time\n",
    "            measurements.append(\n",
    "                elapsed / processed_images * 1000.0\n",
    "            )\n",
    "\n",
    "            print(\n",
    "                f'Latency repetition {repetition + 1}/{repetitions}: '\n",
    "                f'{measurements[-1]:.3f} ms/image',\n",
    "                flush=True,\n",
    "            )\n",
    "\n",
    "        return float(np.median(measurements))\n",
    "\n",
    "    except Exception as error:\n",
    "        print(\n",
    "            'Latency measurement failed; classification results remain '\n",
    "            f'valid and execution will continue: {error!r}',\n",
    "            flush=True,\n",
    "        )\n",
    "        return float('nan')\n",
    "\n",
    "\n",
    "def plot_history(\n",
    "    model_name: str,\n",
    "    seed: int,\n",
    "    history_dataframe: pd.DataFrame,\n",
    "    fine_tuning_start_epoch: int,\n",
    "):\n",
    "    run_directory = (\n",
    "        MODEL_DIR\n",
    "        / clean_model_name(model_name)\n",
    "        / f'seed_{seed}'\n",
    "    )\n",
    "    epochs = history_dataframe['epoch']\n",
    "\n",
    "    plt.figure(figsize=(9, 6))\n",
    "    plt.plot(\n",
    "        epochs,\n",
    "        history_dataframe['accuracy'] * 100,\n",
    "        linewidth=2.2,\n",
    "        label='Training accuracy',\n",
    "    )\n",
    "    plt.plot(\n",
    "        epochs,\n",
    "        history_dataframe['val_accuracy'] * 100,\n",
    "        linewidth=2.2,\n",
    "        linestyle='--',\n",
    "        label='Validation accuracy',\n",
    "    )\n",
    "    if fine_tuning_start_epoch > 0:\n",
    "        plt.axvline(\n",
    "            fine_tuning_start_epoch + 0.5,\n",
    "            linestyle=':',\n",
    "            label='Fine-tuning begins',\n",
    "        )\n",
    "    plt.xlabel('Epoch')\n",
    "    plt.ylabel('Accuracy (%)')\n",
    "    plt.title(f'{model_name}: Training and Validation Accuracy')\n",
    "    plt.grid(linestyle='--')\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(\n",
    "        run_directory / 'accuracy_curve.png',\n",
    "        facecolor='white',\n",
    "    )\n",
    "    plt.close()\n",
    "\n",
    "    if (\n",
    "        'macro_f1' in history_dataframe.columns\n",
    "        and 'val_macro_f1' in history_dataframe.columns\n",
    "    ):\n",
    "        plt.figure(figsize=(9, 6))\n",
    "        plt.plot(\n",
    "            epochs,\n",
    "            history_dataframe['macro_f1'] * 100,\n",
    "            linewidth=2.2,\n",
    "            label='Training macro F1',\n",
    "        )\n",
    "        plt.plot(\n",
    "            epochs,\n",
    "            history_dataframe['val_macro_f1'] * 100,\n",
    "            linewidth=2.2,\n",
    "            linestyle='--',\n",
    "            label='Validation macro F1',\n",
    "        )\n",
    "        if fine_tuning_start_epoch > 0:\n",
    "            plt.axvline(\n",
    "                fine_tuning_start_epoch + 0.5,\n",
    "                linestyle=':',\n",
    "                label='Fine-tuning begins',\n",
    "            )\n",
    "        plt.xlabel('Epoch')\n",
    "        plt.ylabel('Macro F1 (%)')\n",
    "        plt.title(f'{model_name}: Training and Validation Macro F1')\n",
    "        plt.grid(linestyle='--')\n",
    "        plt.legend()\n",
    "        plt.tight_layout()\n",
    "        plt.savefig(\n",
    "            run_directory / 'macro_f1_curve.png',\n",
    "            facecolor='white',\n",
    "        )\n",
    "        plt.close()\n",
    "\n",
    "    plt.figure(figsize=(9, 6))\n",
    "    plt.plot(\n",
    "        epochs,\n",
    "        history_dataframe['loss'],\n",
    "        linewidth=2.2,\n",
    "        label='Training loss',\n",
    "    )\n",
    "    plt.plot(\n",
    "        epochs,\n",
    "        history_dataframe['val_loss'],\n",
    "        linewidth=2.2,\n",
    "        linestyle='--',\n",
    "        label='Validation loss',\n",
    "    )\n",
    "    if fine_tuning_start_epoch > 0:\n",
    "        plt.axvline(\n",
    "            fine_tuning_start_epoch + 0.5,\n",
    "            linestyle=':',\n",
    "            label='Fine-tuning begins',\n",
    "        )\n",
    "    plt.xlabel('Epoch')\n",
    "    plt.ylabel('Loss')\n",
    "    plt.title(f'{model_name}: Training and Validation Loss')\n",
    "    plt.grid(linestyle='--')\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(\n",
    "        run_directory / 'loss_curve.png',\n",
    "        facecolor='white',\n",
    "    )\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "def plot_confusion_matrix_file(\n",
    "    model_name: str,\n",
    "    seed: int,\n",
    "    split_name: str,\n",
    "    confusion_dataframe: pd.DataFrame,\n",
    "):\n",
    "    run_directory = (\n",
    "        MODEL_DIR\n",
    "        / clean_model_name(model_name)\n",
    "        / f'seed_{seed}'\n",
    "    )\n",
    "    figure_size = max(8, int(NUM_CLASSES * 1.2))\n",
    "    _, axis = plt.subplots(\n",
    "        figsize=(figure_size, figure_size)\n",
    "    )\n",
    "    ConfusionMatrixDisplay(\n",
    "        confusion_matrix=confusion_dataframe.to_numpy(),\n",
    "        display_labels=class_names,\n",
    "    ).plot(\n",
    "        ax=axis,\n",
    "        cmap='Blues',\n",
    "        xticks_rotation=45,\n",
    "        colorbar=False,\n",
    "        values_format='d',\n",
    "    )\n",
    "    plt.title(\n",
    "        f'{model_name}: {split_name.title()} Confusion Matrix'\n",
    "    )\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(\n",
    "        run_directory / f'{split_name}_confusion_matrix.png',\n",
    "        facecolor='white',\n",
    "    )\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "save_cell_summary(\n",
    "    'cell_15_efficiency_and_plots',\n",
    "    {\n",
    "        'parameters': True,\n",
    "        'weights_size_mb': True,\n",
    "        'latency_isolated_after_training': True,\n",
    "        'latency_failure_is_non_fatal': True,\n",
    "        'accuracy_macro_f1_and_loss_curves': True,\n",
    "        'confusion_matrices': True,\n",
    "    },\n",
    ")"
