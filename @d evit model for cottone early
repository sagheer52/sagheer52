    "\n",
    "# CCONFIGURATION AND AUTOMATIC CELL JOURNAL\n",
    "DATASET_BASE_PATH = Path(\n",
    "    '/kaggle/input/notebooks/nirmitgavate1/cotton-plant-disease'\n",
    ")\n",
    "TRAIN_FOLDER = DATASET_BASE_PATH / 'train'\n",
    "TEST_FOLDER = DATASET_BASE_PATH / 'test'\n",
    "\n",
    "OUTPUT_DIR = Path('/kaggle/working/cotton_evit_caf_v5_stable_results')\n",
    "CELL_SUMMARY_DIR = OUTPUT_DIR / 'cell_summaries'\n",
    "MODEL_DIR = OUTPUT_DIR / 'models'\n",
    "FIGURE_DIR = OUTPUT_DIR / 'figures'\n",
    "TABLE_DIR = OUTPUT_DIR / 'tables'\n",
    "LOG_DIR = OUTPUT_DIR / 'logs'\n",
    "\n",
    "for directory in [\n",
    "    OUTPUT_DIR,\n",
    "    CELL_SUMMARY_DIR,\n",
    "    MODEL_DIR,\n",
    "    FIGURE_DIR,\n",
    "    TABLE_DIR,\n",
    "    LOG_DIR,\n",
    "]:\n",
    "    directory.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "SEED = 123\n",
    "\n",
    "# Development: [123]\n",
    "# Final paper: [42, 123, 2025]\n",
    "EXPERIMENT_SEEDS = [123]\n",
    "\n",
    "IMAGE_HEIGHT = 224\n",
    "IMAGE_WIDTH = 224\n",
    "IMAGE_SIZE = (IMAGE_HEIGHT, IMAGE_WIDTH)\n",
    "BATCH_SIZE = 8\n",
    "VALIDATION_RATIO = 0.15\n",
    "\n",
    "HEAD_EPOCHS = 15\n",
    "FINE_TUNE_EPOCHS = 20\n",
    "SCRATCH_EPOCHS = HEAD_EPOCHS + FINE_TUNE_EPOCHS\n",
    "EARLY_STOPPING_PATIENCE = 7\n",
    "FINE_TUNE_LAST_N = 40\n",
    "\n",
    "HEAD_LEARNING_RATE = 2e-4\n",
    "FINE_TUNE_LEARNING_RATE = 5e-6\n",
    "SCRATCH_LEARNING_RATE = 2e-4\n",
    "WEIGHT_DECAY = 5e-5\n",
    "LABEL_SMOOTHING = 0.03\n",
    "\n",
    "USE_IMAGENET_WEIGHTS = True\n",
    "USE_CLASS_WEIGHTS = True\n",
    "USE_MIXED_PRECISION = False\n",
    "RESUME_COMPLETED_MODELS = True\n",
    "FAIL_ON_CROSS_SPLIT_DUPLICATES = False\n",
    "\n",
    "\n",
    "# Stability controls\n",
    "# Latency is deliberately measured only after all classification results\n",
    "# have been saved. CUDA timer warnings therefore cannot block the tables.\n",
    "RUN_LATENCY_BENCHMARK = True\n",
    "LATENCY_IMAGES = 100\n",
    "LATENCY_WARMUP_BATCHES = 10\n",
    "LATENCY_REPETITIONS = 3\n",
    "\n",
    "# When True, an interrupted run that already has final weights and history\n",
    "# skips retraining and continues directly with evaluation.\n",
    "RESUME_EVALUATION_FROM_SAVED_WEIGHTS = True\n",
    "\n",
    "# The EfficientNet output and ViT branch both produce 7x7 = 49 tokens.\n",
    "PATCH_SIZE = 32\n",
    "PROJECTION_DIM = 96\n",
    "NUM_TRANSFORMER_BLOCKS = 2\n",
    "NUM_HEADS = 4\n",
    "TRANSFORMER_MLP_DIM = 192\n",
    "DROPOUT_RATE = 0.15\n",
    "CAF_ATTENTION_DROPOUT = 0.10\n",
    "CAF_FFN_MULTIPLIER = 2\n",
    "\n",
    "# Disease-area perception and dynamic fusion settings\n",
    "DAP_MIN_AREA = 0.0\n",
    "DAP_MAX_AREA = 0.45\n",
    "DAP_AREA_LOSS_WEIGHT = 1e-3\n",
    "DAP_TV_LOSS_WEIGHT = 1e-5\n",
    "DAP_HIDDEN_DIM = 48\n",
    "DYNAMIC_FUSION_DIM = 128\n",
    "DYNAMIC_FUSION_BALANCE_WEIGHT = 1e-4\n",
    "\n",
    "AUTOTUNE = tf.data.AUTOTUNE\n",
    "\n",
    "MODELS_TO_RUN = [\n",
    "    'CNN-Scratch',\n",
    "    'MobileNetV3-Small',\n",
    "    'ResNet50',\n",
    "    'EfficientNetV2-B0',\n",
    "    'ViT-Small',\n",
    "    'ConvNeXt-Tiny',\n",
    "    'EVit-Concat',\n",
    "    'EVit-CAF-Gated',\n",
    "    'EVit-DAP-Concat',\n",
    "    'EVit-DAP-CAF',\n",
    "    'EVit-CAF-D2AF',\n",
    "]\n",
    "\n",
    "EXECUTION_MANIFEST_PATH = OUTPUT_DIR / 'execution_manifest.json'\n",
    "EXECUTION_MANIFEST_CSV_PATH = OUTPUT_DIR / 'execution_manifest.csv'\n",
    "\n",
    "\n",
    "def utc_now() -> str:\n",
    "    return datetime.now(timezone.utc).isoformat()\n",
    "\n",
    "\n",
    "def make_json_serializable(value):\n",
    "    if isinstance(value, Path):\n",
    "        return str(value)\n",
    "    if isinstance(value, np.integer):\n",
    "        return int(value)\n",
    "    if isinstance(value, np.floating):\n",
    "        return float(value)\n",
    "    if isinstance(value, np.ndarray):\n",
    "        return value.tolist()\n",
    "    if isinstance(value, pd.DataFrame):\n",
    "        return {'shape': list(value.shape), 'columns': list(value.columns)}\n",
    "    if isinstance(value, pd.Series):\n",
    "        return value.to_dict()\n",
    "    if isinstance(value, tf.Tensor):\n",
    "        return value.numpy().tolist()\n",
    "    if isinstance(value, dict):\n",
    "        return {\n",
    "            str(key): make_json_serializable(item)\n",
    "            for key, item in value.items()\n",
    "        }\n",
    "    if isinstance(value, (list, tuple)):\n",
    "        return [make_json_serializable(item) for item in value]\n",
    "    return value\n",
    "\n",
    "\n",
    "def load_execution_manifest() -> List[Dict[str, Any]]:\n",
    "    if not EXECUTION_MANIFEST_PATH.exists():\n",
    "        return []\n",
    "\n",
    "    try:\n",
    "        with open(\n",
    "            EXECUTION_MANIFEST_PATH,\n",
    "            'r',\n",
    "            encoding='utf-8',\n",
    "        ) as file:\n",
    "            return json.load(file)\n",
    "    except Exception:\n",
    "        return []\n",
    "\n",
    "\n",
    "def save_cell_summary(\n",
    "    cell_id: str,\n",
    "    summary: Dict[str, Any],\n",
    "    status: str = 'completed',\n",
    ") -> Path:\n",
    "    record = {\n",
    "        'cell_id': cell_id,\n",
    "        'status': status,\n",
    "        'timestamp_utc': utc_now(),\n",
    "        'summary': make_json_serializable(summary),\n",
    "    }\n",
    "\n",
    "    cell_path = CELL_SUMMARY_DIR / f'{cell_id}.json'\n",
    "\n",
    "    with open(cell_path, 'w', encoding='utf-8') as file:\n",
    "        json.dump(record, file, indent=2)\n",
    "\n",
    "    manifest = load_execution_manifest()\n",
    "    manifest = [\n",
    "        previous\n",
    "        for previous in manifest\n",
    "        if previous.get('cell_id') != cell_id\n",
    "    ]\n",
    "    manifest.append(record)\n",
    "    manifest = sorted(manifest, key=lambda item: item['cell_id'])\n",
    "\n",
    "    with open(\n",
    "        EXECUTION_MANIFEST_PATH,\n",
    "        'w',\n",
    "        encoding='utf-8',\n",
    "    ) as file:\n",
    "        json.dump(manifest, file, indent=2)\n",
    "\n",
    "    pd.DataFrame(\n",
    "        [\n",
    "            {\n",
    "                'cell_id': item['cell_id'],\n",
    "                'status': item['status'],\n",
    "                'timestamp_utc': item['timestamp_utc'],\n",
    "                'summary_json': json.dumps(\n",
    "                    item['summary'],\n",
    "                    ensure_ascii=False,\n",
    "                ),\n",
    "            }\n",
    "            for item in manifest\n",
    "        ]\n",
    "    ).to_csv(EXECUTION_MANIFEST_CSV_PATH, index=False)\n",
    "\n",
    "    print(f'Saved cell summary: {cell_path}')\n",
    "    return cell_path\n",
    "\n",
    "\n",
    "\n",
    "def show_progress(message: str) -> None:\n",
    "    \"\"\"Print a timestamped message immediately in Kaggle.\"\"\"\n",
    "    current_time = time.strftime('%H:%M:%S')\n",
    "    print(f'\\n[{current_time}] {message}', flush=True)\n",
    "\n",
    "\n",
    "def clean_model_name(model_name: str) -> str:\n",
    "    \"\"\"Create a filesystem-safe model identifier.\"\"\"\n",
    "    return (\n",
    "        model_name\n",
    "        .lower()\n",
    "        .replace(' ', '_')\n",
    "        .replace('-', '_')\n",
    "    )\n",
    "\n",
    "save_cell_summary(\n",
    "    'cell_01_imports',\n",
    "    {\n",
    "        'python': platform.python_version(),\n",
    "        'tensorflow': tf.__version__,\n",
    "        'numpy': np.__version__,\n",
    "        'pandas': pd.__version__,\n",
    "    },\n",
    ")\n",
    "\n",
    "CONFIGURATION = {\n",
    "    'dataset_base_path': DATASET_BASE_PATH,\n",
    "    'train_folder': TRAIN_FOLDER,\n",
    "    'test_folder': TEST_FOLDER,\n",
    "    'output_dir': OUTPUT_DIR,\n",
    "    'seed': SEED,\n",
    "    'experiment_seeds': EXPERIMENT_SEEDS,\n",
    "    'image_size': IMAGE_SIZE,\n",
    "    'batch_size': BATCH_SIZE,\n",
    "    'validation_ratio': VALIDATION_RATIO,\n",
    "    'head_epochs': HEAD_EPOCHS,\n",
    "    'fine_tune_epochs': FINE_TUNE_EPOCHS,\n",
    "    'scratch_epochs': SCRATCH_EPOCHS,\n",
    "    'head_learning_rate': HEAD_LEARNING_RATE,\n",
    "    'fine_tune_learning_rate': FINE_TUNE_LEARNING_RATE,\n",
    "    'scratch_learning_rate': SCRATCH_LEARNING_RATE,\n",
    "    'weight_decay': WEIGHT_DECAY,\n",
    "    'label_smoothing': LABEL_SMOOTHING,\n",
    "    'patch_size': PATCH_SIZE,\n",
    "    'projection_dim': PROJECTION_DIM,\n",
    "    'transformer_blocks': NUM_TRANSFORMER_BLOCKS,\n",
    "    'num_heads': NUM_HEADS,\n",
    "    'transformer_mlp_dim': TRANSFORMER_MLP_DIM,\n",
    "    'dropout_rate': DROPOUT_RATE,\n",
    "    'models_to_run': MODELS_TO_RUN,\n",
    "    'top3_accuracy_included': False,\n",
    "    'checkpoint_selection_metric': 'validation macro F1',\n",
    "}\n",
    "\n",
    "with open(\n",
    "    OUTPUT_DIR / 'experiment_configuration.json',\n",
    "    'w',\n",
    "    encoding='utf-8',\n",
    ") as file:\n",
    "    json.dump(make_json_serializable(CONFIGURATION), file, indent=2)\n",
    "\n",
    "save_cell_summary('cell_02_configuration', CONFIGURATION)"
   ]
