    "\n",
    "    confusion_dataframe = pd.DataFrame(\n",
    "        confusion_values,\n",
    "        index=class_names,\n",
    "        columns=class_names,\n",
    "    )\n",
    "\n",
    "    confusion_dataframe.to_csv(\n",
    "        run_directory\n",
    "        / f'{split_name}_confusion_matrix.csv'\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        report_dataframe,\n",
    "        confusion_dataframe,\n",
    "    )\n",
    "\n",
    "\n",
    "save_cell_summary(\n",
