    "\n",
    "# CELL 8 — SERIALIZABLE TRANSFORMER, LOSS AND FUSION LAYERS\n",
    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class Patches(layers.Layer):\n",
    "\n",
    "    def __init__(self, patch_size: int, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.patch_size = patch_size\n",
    "\n",
    "    def call(self, images):\n",
    "        batch_size = tf.shape(images)[0]\n",
    "\n",
    "        patches = tf.image.extract_patches(\n",
    "            images=images,\n",
    "            sizes=[1, self.patch_size, self.patch_size, 1],\n",
    "            strides=[1, self.patch_size, self.patch_size, 1],\n",
    "            rates=[1, 1, 1, 1],\n",
    "            padding='VALID',\n",
    "        )\n",
    "\n",
    "        patch_dimensions = (\n",
    "            self.patch_size * self.patch_size * images.shape[-1]\n",
    "        )\n",
    "\n",
    "        return tf.reshape(\n",
    "            patches,\n",
    "            [batch_size, -1, patch_dimensions],\n",
    "        )\n",
    "\n",
    "    def get_config(self):\n",
    "        configuration = super().get_config()\n",
    "        configuration.update({'patch_size': self.patch_size})\n",
    "        return configuration\n",
    "\n",
    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class PatchEncoder(layers.Layer):\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        num_patches: int,\n",
    "        projection_dim: int,\n",
    "        **kwargs,\n",
    "    ):\n",
    "        super().__init__(**kwargs)\n",
    "        self.num_patches = num_patches\n",
    "        self.projection_dim = projection_dim\n",
    "        self.projection = layers.Dense(projection_dim)\n",
    "        self.position_embedding = layers.Embedding(\n",
    "            input_dim=num_patches,\n",
    "            output_dim=projection_dim,\n",
    "        )\n",
    "\n",
    "    def call(self, patches):\n",
    "        positions = tf.range(\n",
    "            start=0,\n",
    "            limit=self.num_patches,\n",
    "            delta=1,\n",
    "        )\n",
    "\n",
    "        return (\n",
    "            self.projection(patches)\n",
    "            + self.position_embedding(positions)\n",
    "        )\n",
    "\n",
    "    def get_config(self):\n",
    "        configuration = super().get_config()\n",
    "        configuration.update(\n",
    "            {\n",
    "                'num_patches': self.num_patches,\n",
    "                'projection_dim': self.projection_dim,\n",
    "            }\n",
    "        )\n",
    "        return configuration\n",
    "\n",
    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class TransformerEncoder(layers.Layer):\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        projection_dim: int,\n",
    "        num_heads: int,\n",
    "        mlp_dim: int,\n",
    "        dropout_rate: float = 0.1,\n",
    "        **kwargs,\n",
    "    ):\n",
    "        super().__init__(**kwargs)\n",
    "        self.projection_dim = projection_dim\n",
    "        self.num_heads = num_heads\n",
    "        self.mlp_dim = mlp_dim\n",
    "        self.dropout_rate = dropout_rate\n",
    "\n",
    "        self.norm_1 = layers.LayerNormalization(epsilon=1e-6)\n",
    "        self.attention = layers.MultiHeadAttention(\n",
    "            num_heads=num_heads,\n",
    "            key_dim=projection_dim // num_heads,\n",
    "            dropout=dropout_rate,\n",
    "        )\n",
    "        self.attention_dropout = layers.Dropout(dropout_rate)\n",
    "        self.norm_2 = layers.LayerNormalization(epsilon=1e-6)\n",
    "\n",
    "        self.mlp = tf.keras.Sequential(\n",
    "            [\n",
    "                layers.Dense(mlp_dim, activation='gelu'),\n",
    "                layers.Dropout(dropout_rate),\n",
    "                layers.Dense(projection_dim),\n",
    "                layers.Dropout(dropout_rate),\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    def call(self, inputs, training=False):\n",
    "        normalized = self.norm_1(inputs)\n",
    "\n",
    "        attended = self.attention(\n",
    "            normalized,\n",
    "            normalized,\n",
    "            training=training,\n",
    "        )\n",
    "\n",
    "        attended = self.attention_dropout(\n",
    "            attended,\n",
    "            training=training,\n",
    "        )\n",
    "\n",
    "        first_residual = inputs + attended\n",
    "\n",
    "        mlp_output = self.mlp(\n",
    "            self.norm_2(first_residual),\n",
    "            training=training,\n",
    "        )\n",
    "\n",
    "        return first_residual + mlp_output\n",
    "\n",
    "    def get_config(self):\n",
    "        configuration = super().get_config()\n",
    "        configuration.update(\n",
    "            {\n",
    "                'projection_dim': self.projection_dim,\n",
    "                'num_heads': self.num_heads,\n",
    "                'mlp_dim': self.mlp_dim,\n",
    "                'dropout_rate': self.dropout_rate,\n",
    "            }\n",
    "        )\n",
    "        return configuration\n",
    "\n",
    "\n",
    "@tf.keras.utils.register_keras_serializable()\n",
    "class SparseLabelSmoothingCrossentropy(tf.keras.losses.Loss):\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        num_classes: int,\n",
    "        label_smoothing: float = 0.0,\n",
    "        name: str = 'sparse_label_smoothing_crossentropy',\n",
    "        **kwargs,\n",
    "    ):\n",
    "        super().__init__(name=name, **kwargs)\n",
    "        self.num_classes = num_classes\n",
    "        self.label_smoothing = label_smoothing\n",
    "\n",
    "    def call(self, y_true, y_pred):\n",
    "        y_true = tf.cast(tf.reshape(y_true, [-1]), tf.int32)\n",
    "\n",
    "        one_hot_labels = tf.one_hot(\n",
    "            y_true,\n",
    "            depth=self.num_classes,\n",
    "            dtype=y_pred.dtype,\n",
    "        )\n",
    "\n",
    "        return tf.keras.losses.categorical_crossentropy(\n",
    "            one_hot_labels,\n",
    "            y_pred,\n",
    "            label_smoothing=self.label_smoothing,\n",
    "        )\n",
    "\n",
    "    def get_config(self):\n",
    "        configuration = super().get_config()\n",
    "        configuration.update(\n",
    "            {\n",
    "                'num_classes': self.num_classes,\n",
    "                'label_smoothing': self.label_smoothing,\n",
    "            }\n",
    "        )\n",
    "        return configuration\n",
    "\n",
    "\n",
    "\n",
