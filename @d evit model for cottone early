    "# STABLE TENSORFLOW, GPU AND REPRODUCIBILITY SETUP\n",
    "\n",
    "def set_global_seed(seed: int) -> None:\n",
    "    os.environ['PYTHONHASHSEED'] = str(seed)\n",
    "    random.seed(seed)\n",
    "    np.random.seed(seed)\n",
    "    tf.keras.utils.set_random_seed(seed)\n",
    "\n",
    "\n",
    "set_global_seed(SEED)\n",
    "os.environ['TF_CPP_MIN_LOG_LEVEL'] = '2'\n",
    "\n",
    "# Disable the optional Grappler NHWC-to-NCHW layout rewrite that can emit\n",
    "# the EfficientNetV2 stateless-dropout layout error on Kaggle GPUs.\n",
    "tf.config.optimizer.set_experimental_options(\n",
    "    {\n",
    "        'layout_optimizer': False,\n",
    "    }\n",
    ")\n",
    "\n",
    "# Disable global XLA/JIT. Individual model compilation also uses\n",
    "# jit_compile=False.\n",
    "tf.config.optimizer.set_jit(False)\n",
    "\n",
    "gpus = tf.config.list_physical_devices('GPU')\n",
    "\n",
    "for gpu in gpus:\n",
    "    try:\n",
    "        tf.config.experimental.set_memory_growth(gpu, True)\n",
    "    except RuntimeError:\n",
    "        pass\n",
    "\n",
    "if USE_MIXED_PRECISION and gpus:\n",
    "    tf.keras.mixed_precision.set_global_policy('mixed_float16')\n",
    "else:\n",
    "    # Float32 is the stable default. Enable mixed precision only after the\n",
    "    # complete notebook has run successfully on the selected Kaggle GPU.\n",
    "    tf.keras.mixed_precision.set_global_policy('float32')\n",
    "\n",
    "runtime_summary = {\n",
