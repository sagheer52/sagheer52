    " \n",
    "# TF.DATA PIPELINES, AUGMENTATION AND CLASS WEIGHTS\n",
    "\n",
    "data_augmentation = tf.keras.Sequential(\n",
    "    [\n",
    "        layers.RandomFlip('horizontal'),\n",
    "        layers.RandomRotation(0.10),\n",
    "        layers.RandomZoom(\n",
    "            height_factor=(-0.08, 0.12),\n",
    "            width_factor=(-0.08, 0.12),\n",
    "        ),\n",
    "        layers.RandomTranslation(\n",
    "            height_factor=0.06,\n",
    "            width_factor=0.06,\n",
    "        ),\n",
    "        layers.RandomContrast(0.12),\n",
    "    ],\n",
    "    name='shared_data_augmentation',\n",
    ")\n",
    "\n",
    "\n",
    "def load_and_resize_image(\n",
    "    image_path: tf.Tensor,\n",
    "    label: tf.Tensor,\n",
    "):\n",
    "    image_bytes = tf.io.read_file(image_path)\n",
    "\n",
    "    image = tf.io.decode_image(\n",
    "        image_bytes,\n",
    "        channels=3,\n",
    "        expand_animations=False,\n",
    "    )\n",
    "\n",
    "    image.set_shape([None, None, 3])\n",
    "\n",
    "    image = tf.image.resize(\n",
    "        image,\n",
    "        IMAGE_SIZE,\n",
    "        method='bilinear',\n",
    "        antialias=False,\n",
    "    )\n",
    "\n",
    "    return tf.cast(image, tf.float32), tf.cast(label, tf.int32)\n",
    "\n",
    "\n",
    "def create_tf_dataset(\n",
    "    dataframe: pd.DataFrame,\n",
    "    training: bool,\n",
    "    augment: bool,\n",
    "    seed: int,\n",
    ") -> tf.data.Dataset:\n",
    "    paths = dataframe['filepath'].astype(str).to_numpy()\n",
    "    labels = dataframe['label'].astype(np.int32).to_numpy()\n",
    "\n",
    "    dataset = tf.data.Dataset.from_tensor_slices((paths, labels))\n",
    "\n",
    "    if training:\n",
    "        dataset = dataset.shuffle(\n",
    "            buffer_size=min(len(dataframe), 4096),\n",
    "            seed=seed,\n",
    "            reshuffle_each_iteration=True,\n",
    "        )\n",
    "\n",
    "    dataset = dataset.map(\n",
    "        load_and_resize_image,\n",
    "        num_parallel_calls=AUTOTUNE,\n",
    "        deterministic=not training,\n",
    "    )\n",
    "\n",
    "    if augment:\n",
    "        dataset = dataset.map(\n",
    "            lambda images, labels: (\n",
    "                data_augmentation(images, training=True),\n",
    "                labels,\n",
    "            ),\n",
    "            num_parallel_calls=AUTOTUNE,\n",
    "            deterministic=False,\n",
    "        )\n",
    "\n",
    "    dataset = dataset.batch(BATCH_SIZE, drop_remainder=False)\n",
    "\n",
    "    options = tf.data.Options()\n",
    "    options.experimental_deterministic = not training\n",
    "    options.threading.private_threadpool_size = 8\n",
    "    options.threading.max_intra_op_parallelism = 1\n",
    "\n",
    "    return dataset.with_options(options).prefetch(AUTOTUNE)\n",
    "\n",
    "\n",
    "def calculate_class_weights(\n",
    "    dataframe: pd.DataFrame,\n",
    ") -> Optional[Dict[int, float]]:\n",
    "    if not USE_CLASS_WEIGHTS:\n",
    "        return None\n",
    "\n",
    "    labels = dataframe['label'].to_numpy()\n",
    "    unique_classes = np.unique(labels)\n",
    "\n",
    "    weights = compute_class_weight(\n",
    "        class_weight='balanced',\n",
    "        classes=unique_classes,\n",
    "        y=labels,\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        int(class_index): float(weight)\n",
    "        for class_index, weight in zip(unique_classes, weights)\n",
    "    }\n",
    "\n",
    "\n",
    "class_weights = calculate_class_weights(train_df)\n",
    "\n",
    "train_fit_ds = create_tf_dataset(\n",
    "    train_df,\n",
    "    training=True,\n",
    "    augment=True,\n",
    "    seed=SEED,\n",
    ")\n",
    "\n",
    "train_eval_ds = create_tf_dataset(\n",
    "    train_df,\n",
    "    training=False,\n",
    "    augment=False,\n",
    "    seed=SEED,\n",
    ")\n",
    "\n",
    "validation_ds = create_tf_dataset(\n",
    "    validation_df,\n",
    "    training=False,\n",
    "    augment=False,\n",
    "    seed=SEED,\n",
    ")\n",
    "\n",
    "test_ds = create_tf_dataset(\n",
    "    test_df,\n",
    "    training=False,\n",
    "    augment=False,\n",
    "    seed=SEED,\n",
    ")\n",
    "\n",
    "sample_images, sample_labels = next(iter(train_fit_ds))\n",
    "\n",
    "pipeline_summary = {\n",
    "    'sample_batch_shape': sample_images.shape.as_list(),\n",
    "    'class_weights': class_weights,\n",
    "    'training_batches': int(\n",
    "        tf.data.experimental.cardinality(train_fit_ds).numpy()\n",
    "    ),\n",
    "    'validation_batches': int(\n",
