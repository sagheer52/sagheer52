          output = inference_step(images)\n","\n","                _ = output.numpy()\n","\n","                processed_images += int(\n","                    images.shape[0]\n","                )\n","\n","            elapsed = (\n","                time.perf_counter() - start_time\n","            )\n","\n","            latency = (\n","                elapsed\n","                / processed_images\n","                * 1000.0\n","            )\n","\n","            measurements.append(latency)\n","\n","            print(\n","                f\"Repetition {repetition + 1}: \"\n","                f\"{latency:.4f} ms/image\"\n","            )\n","\n","        return float(\n","            np.median(measurements)\n","        )\n","\n","    except Exception as error:\n","\n","        print(\n","            \"Latency measurement failed:\",\n","            repr(error),\n","        )\n","\n","        return float(\"nan\")\n","\n","\n","# ============================================================\n","# LATENCY FOR ALL COMPLETED MODELS\n","# ============================================================\n","\n","latency_rows = []\n","\n","if RUN_LATENCY_BENCHMARK:\n","\n","    for _, result in results_df.iterrows():\n","\n","        model_name = result[\"model\"]\n","        seed = int(result[\"seed\"])\n","\n","        run_directory = (\n","            MODEL_DIR\n","            / clean_model_name(model_name)\n","            / f\"seed_{seed}\"\n","        )\n","\n","        weights_path = (\n","            run_directory / \"best_model.weights.h5\"\n","        )\n","\n","        metrics_path = (\n","            run_directory / \"complete_metrics.json\"\n","        )\n","\n","        if not weights_path.exists():\n","            continue\n","\n","        model = None\n","        backbone = None\n","\n","        try:\n","\n","            tf.keras.backend.clear_session()\n","            gc.collect()\n","\n","            show_progress(\n","                f\"Measuring latency: {model_name}\"\n","            )\n","\n","            configuration = CONFIG_BY_NAME[\n","                model_name\n","            ]\n","\n","            model, backbone, _ = (\n","                build_model_for_weight_recovery(\n","                    configuration[\"builder\"]\n","                )\n","            )\n","\n","            model.load_weights(\n","                weights_path\n","            )\n","\n","            latency = measure_inference_latency(\n","                model,\n","                test_ds,\n","                number_of_images=min(\n","                    100,\n","                    len(test_df),\n","                ),\n","                warmup_batches=10,\n","                repetitions=3,\n","            )\n","\n","            latency_rows.append({\n","                \"model\": model_name,\n","                \"seed\": seed,\n","                \"latency_ms_per_image\": latency,\n","            })\n","\n","            if metrics_path.exists():\n","\n","                with open(\n","                    metrics_path,\n","                    \"r\",\n","                    encoding=\"utf-8\",\n","                ) as file:\n","                    metrics = json.load(file)\n","\n","                metrics[\n","                    \"latency_ms_per_image\"\n","                ] = (\n","                    None\n","                    if not np.isfinite(latency)\n","                    else latency\n","                )\n","\n","                with open(\n","                    metrics_path,\n","                    \"w\",\n","                    encoding=\"utf-8\",\n","                ) as file:\n","                    json.dump(\n","                        metrics,\n","                        file,\n","                        indent=2,\n","                    )\n","\n","        except Exception as error:\n","\n","            print(\n","                f\"Latency failed for {model_name}:\",\n","                repr(error),\n","            )\n","\n","            latency_rows.append({\n","                \"model\": model_name,\n","                \"seed\": seed,\n","                \"latency_ms_per_image\": np.nan,\n","                \"error\": repr(error),\n","            })\n","\n","        finally:\n","\n","            if model is not None:\n","                del model\n","\n","            if backbone is not None:\n","                del backbone\n","\n","            tf.keras.backend.clear_session()\n","            gc.collect()\n","\n","\n","latency_df = pd.DataFrame(\n","    latency_rows\n",")\n","\n","latency_df.to_csv(\n","    TABLE_DIR / \"latency_benchmark.csv\",\n","    index=False,\n",")\n","\n","if not latency_df.empty:\n","    display(latency_df)\n","\n","\n","# ============================================================\n","# LOAD PROPOSED V6 MODEL FOR VISUALIZATION\n","# ============================================================\n","\n","proposed_name = \"EVit-CAF-D2AF-v6\"\n","\n","visualization_seed = EXPERIMENT_SEEDS[0]\n","\n","proposed_directory = (\n","    MODEL_DIR\n","    / clean_model_name(proposed_name)\n","    / f\"seed_{visualization_seed}\"\n",")\n","\n","proposed_weights = (\n","    proposed_directory\n","    / \"best_model.weights.h5\"\n",")\n","\n","if proposed_weights.exists():\n","\n","    tf.keras.backend.clear_session()\n","\n","    proposed_model, proposed_backbone, _ = (\n","        build_model_for_weight_recovery(\n","            CONFIG_BY_NAME[proposed_name][\"builder\"]\n","        )\n","    )\n","\n","    proposed_model.load_weights(\n","        proposed_weights\n","    )\n","\n","    # ---------------- EXTRACT DISEASE MASK ----------------\n","\n","    mask_model = Model(\n","        inputs=proposed_model.input,\n","        outputs=proposed_model.get_layer(\n","            \"v6_disease_area_decoupling\"\n","        ).output[2],\n","    )\n","\n","    images, labels = next(\n","        iter(test_ds)\n","    )\n","\n","    masks = mask_model.predict(\n","  