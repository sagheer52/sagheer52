    "# ============================================================\n",
    "# CELL 9 — SHARED MODEL HELPERS\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "def shared_classifier_head(features, prefix: str):\n",
    "    features = layers.LayerNormalization(\n",
    "        epsilon=1e-6,\n",
    "        name=f'{prefix}_normalization',\n",
    "    )(features)\n",
    "\n",
    "    features = layers.Dense(\n",
    "        256,\n",
    "        activation='gelu',\n",
    "        kernel_regularizer=tf.keras.regularizers.l2(1e-5),\n",
    "        name=f'{prefix}_dense_1',\n",
    "    )(features)\n",
    "\n",
    "    features = layers.Dropout(\n",
    "        0.35,\n",
    "        name=f'{prefix}_dropout_1',\n",
    "    )(features)\n",
    "\n",
    "    features = layers.Dense(\n",
    "        128,\n",
    "        activation='gelu',\n",
    "        kernel_regularizer=tf.keras.regularizers.l2(1e-5),\n",
    "        name=f'{prefix}_dense_2',\n",
    "    )(features)\n",
    "\n",
    "    features = layers.Dropout(\n",
    "        0.25,\n",
    "        name=f'{prefix}_dropout_2',\n",
    "    )(features)\n",
    "\n",
    "    return layers.Dense(\n",
    "        NUM_CLASSES,\n",
    "        activation='softmax',\n",
    "        dtype='float32',\n",
    "        name=f'{prefix}_predictions',\n",
    "    )(features)\n",
    "\n",
    "\n",
    "def safe_application_backbone(\n",
    "    constructor,\n",
    "    *,\n",
    "    architecture_name: str,\n",
    "    **kwargs,\n",
    ") -> Tuple[Model, bool]:\n",
    "    requested_weights = 'imagenet' if USE_IMAGENET_WEIGHTS else None\n",
    "\n",
    "    try:\n",
    "        backbone = constructor(\n",
    "            weights=requested_weights,\n",
    "            **kwargs,\n",
    "        )\n",
    "        pretrained_loaded = requested_weights is not None\n",
    "\n",
    "    except Exception as error:\n",
    "        print(\n",
    "            f'ImageNet weights unavailable for {architecture_name}. '\n",
    "            'Falling back to weights=None.'\n",
    "        )\n",
    "        print('Original error:', repr(error))\n",
    "\n",
    "        backbone = constructor(weights=None, **kwargs)\n",
    "        pretrained_loaded = False\n",
    "\n",
    "    backbone.trainable = not pretrained_loaded\n",
    "    return backbone, pretrained_loaded\n",
    "\n",
    "\n",
    "def build_efficientnet_and_vit_tokens(\n",
    "    inputs,\n",
    "    prefix: str,\n",
    "):\n",
    "    backbone, pretrained_loaded = safe_application_backbone(\n",
    "        tf.keras.applications.EfficientNetV2B0,\n",
    "        architecture_name=f'{prefix} EfficientNetV2-B0',\n",
    "        include_top=False,\n",
    "        include_preprocessing=True,\n",
    "        input_shape=(IMAGE_HEIGHT, IMAGE_WIDTH, 3),\n",
    "    )\n",
    "\n",
    "    cnn_features = backbone(inputs, training=False)\n",
    "\n",
    "    cnn_features = layers.Conv2D(\n",
    "        PROJECTION_DIM,\n",
    "        1,\n",
    "        padding='same',\n",
    "        use_bias=False,\n",
    "        name=f'{prefix}_cnn_projection',\n",
    "    )(cnn_features)\n",
    "\n",
    "    cnn_features = layers.BatchNormalization(\n",
    "        name=f'{prefix}_cnn_projection_bn',\n",
    "    )(cnn_features)\n",
    "\n",
    "    cnn_features = layers.Activation(\n",
    "        'swish',\n",
    "        name=f'{prefix}_cnn_projection_activation',\n",
    "    )(cnn_features)\n",
    "\n",
    "    cnn_tokens = layers.Reshape(\n",
    "        (-1, PROJECTION_DIM),\n",
    "        name=f'{prefix}_cnn_tokens',\n",
    "    )(cnn_features)\n",
    "\n",
    "    vit_images = layers.Rescaling(\n",
    "        1.0 / 255.0,\n",
    "        name=f'{prefix}_vit_rescaling',\n",
    "    )(inputs)\n",
    "\n",
    "    number_of_patches = (\n",
    "        IMAGE_HEIGHT // PATCH_SIZE\n",
    "    ) * (\n",
    "        IMAGE_WIDTH // PATCH_SIZE\n",
    "    )\n",
    "\n",
    "    vit_tokens = Patches(\n",
    "        PATCH_SIZE,\n",
    "        name=f'{prefix}_patch_extraction',\n",
    "    )(vit_images)\n",
    "\n",
    "    vit_tokens = PatchEncoder(\n",
    "        number_of_patches,\n",
    "        PROJECTION_DIM,\n",
    "        name=f'{prefix}_patch_encoder',\n",
    "    )(vit_tokens)\n",
    "\n",
    "    for block_index in range(NUM_TRANSFORMER_BLOCKS):\n",
    "        vit_tokens = TransformerEncoder(\n",
    "            projection_dim=PROJECTION_DIM,\n",
    "            num_heads=NUM_HEADS,\n",
    "            mlp_dim=TRANSFORMER_MLP_DIM,\n",
    "            dropout_rate=DROPOUT_RATE,\n",
    "            name=(\n",
    "                f'{prefix}_transformer_block_'\n",
    "                f'{block_index + 1}'\n",
    "            ),\n",
    "        )(vit_tokens)\n",
    "\n",
    "    return cnn_tokens, vit_tokens, backbone, pretrained_loaded\n",
    "\n",
    "\n",
    "save_cell_summary(\n",
    "    'cell_09_model_helpers',\n",
    "    {\n",
    "        'shared_classifier_head': True,\n",
    "        'same_token_dimension': PROJECTION_DIM,\n",
