   "source": [
    "# ============================================================\n",
    "# CELL 13 — MEMORY-SAFE TRAINING AND VALIDATION-ONLY SELECTION\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "def read_history_file(history_path: Path) -> pd.DataFrame:\n",
    "    if not history_path.exists():\n",
    "        raise FileNotFoundError(\n",
    "            f'History file missing: {history_path}'\n",
    "        )\n",
    "\n",
    "    dataframe = pd.read_csv(history_path)\n",
    "    if dataframe.empty:\n",
    "        raise ValueError(\n",
    "            f'History file is empty: {history_path}'\n",
    "        )\n",
    "\n",
    "    if 'epoch' not in dataframe.columns:\n",
    "        dataframe.insert(0, 'epoch', np.arange(len(dataframe)))\n",
    "\n",
    "    dataframe['epoch'] = pd.to_numeric(\n",
    "        dataframe['epoch'],\n",
    "        errors='coerce',\n",
    "    )\n",
    "    dataframe = dataframe.dropna(subset=['epoch']).copy()\n",
    "\n",
    "    # CSVLogger stores zero-based epoch indices. Convert them to the\n",
    "    # one-based epoch numbers used in figures and summaries.\n",
    "    dataframe['epoch'] = dataframe['epoch'].astype(int) + 1\n",
    "\n",
    "    return (\n",
    "        dataframe\n",
    "        .sort_values('epoch')\n",
    "        .drop_duplicates(subset=['epoch'], keep='last')\n",
    "        .reset_index(drop=True)\n",
    "    )\n",
    "\n",
    "\n",
    "def combine_history_frames(\n",
    "    stage_1_dataframe: Optional[pd.DataFrame],\n",
    "    stage_2_dataframe: Optional[pd.DataFrame],\n",
    ") -> pd.DataFrame:\n",
    "    frames = [\n",
    "        frame.copy()\n",
    "        for frame in [stage_1_dataframe, stage_2_dataframe]\n",
    "        if frame is not None and not frame.empty\n",
    "    ]\n",
    "\n",
    "    if not frames:\n",
    "        raise ValueError('No training histories were available.')\n",
    "\n",
    "    return (\n",
    "        pd.concat(frames, ignore_index=True)\n",
    "        .sort_values('epoch')\n",
    "        .drop_duplicates(subset=['epoch'], keep='last')\n",
    "        .reset_index(drop=True)\n",
    "    )\n",
    "\n",
    "\n",
    "def get_best_history_metric(\n",
    "    history_dataframe: pd.DataFrame,\n",
    "    metric_name: str,\n",
    ") -> float:\n",
    "    if metric_name not in history_dataframe.columns:\n",
    "        raise KeyError(\n",
    "            f'{metric_name} was not found. '\n",
    "            f'Columns: {list(history_dataframe.columns)}'\n",
    "        )\n",
    "\n",
    "    values = pd.to_numeric(\n",
    "        history_dataframe[metric_name],\n",
    "        errors='coerce',\n",
    "    ).dropna()\n",
    "\n",
    "    if values.empty:\n",
    "        raise ValueError(\n",
    "            f'{metric_name} has no numeric values.'\n",
    "        )\n",
    "\n",
    "    return float(values.max())\n",
    "\n",
    "\n",
    "def get_best_history_epoch(\n",
    "    history_dataframe: pd.DataFrame,\n",
    "    metric_name: str,\n",
    ") -> int:\n",
    "    values = pd.to_numeric(\n",
    "        history_dataframe[metric_name],\n",
    "        errors='coerce',\n",
    "    )\n",
    "    valid = values.notna()\n",
    "    if not valid.any():\n",
    "        return -1\n",
    "\n",
    "    local_index = values[valid].idxmax()\n",
    "    return int(history_dataframe.loc[local_index, 'epoch'])\n",
    "\n",
    "\n",
    "def unfreeze_final_backbone_layers(backbone: Model) -> None:\n",
    "    backbone.trainable = True\n",
    "\n",
    "    for layer in backbone.layers[:-FINE_TUNE_LAST_N]:\n",
    "        layer.trainable = False\n",
    "\n",
    "    for layer in backbone.layers:\n",
    "        if isinstance(layer, layers.BatchNormalization):\n",
    "            layer.trainable = False\n",
    "\n",
    "\n",
    "def train_model(\n",
    "    model_name: str,\n",
    "    model: Model,\n",
    "    backbone: Optional[Model],\n",
    "    pretrained_loaded: bool,\n",
    "    seed: int,\n",
    "):\n",
    "    run_directory = (\n",
    "        MODEL_DIR\n",
    "        / clean_model_name(model_name)\n",
    "        / f'seed_{seed}'\n",
    "    )\n",
    "    run_directory.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    show_progress(f'{model_name}: training started')\n",
    "\n",
    "    if pretrained_loaded and backbone is not None:\n",
    "        # ----------------------------------------------------\n",
    "        # Stage 1: frozen pretrained backbone\n",
    "        # ----------------------------------------------------\n",
    "        show_progress(f'{model_name}: Stage 1 — frozen backbone')\n",
    "        compile_model(model, HEAD_LEARNING_RATE)\n",
    "\n",
    "        (\n",
    "            stage_1_callbacks,\n",
    "            stage_1_checkpoint,\n",
    "            stage_1_history_path,\n",
    "            _,\n",
    "        ) = create_callbacks(model_name, seed, 'stage_1')\n",
    "\n",
    "        model.fit(\n",
    "            train_fit_ds,\n",
    "            validation_data=validation_ds,\n",
    "            epochs=HEAD_EPOCHS,\n",
    "            class_weight=class_weights,\n",
    "            callbacks=stage_1_callbacks,\n",
    "            verbose=2,\n",
    "        )\n",
    "\n",
    "        stage_1_history = read_history_file(stage_1_history_path)\n",
    "        stage_1_best_f1 = get_best_history_metric(\n",
    "            stage_1_history,\n",
    "            'val_macro_f1',\n",
    "        )\n",
    "        stage_1_best_epoch = get_best_history_epoch(\n",
    "            stage_1_history,\n",
    "            'val_macro_f1',\n",
    "        )\n",
    "        completed_stage_1_epochs = int(\n",
    "            stage_1_history['epoch'].max()\n",
    "        )\n",
    "\n",
    "        show_progress(\n",
    "            f'{model_name}: Stage 1 finished; '\n",
    "            f'best val_macro_f1={stage_1_best_f1:.6f} '\n",
    "            f'at epoch {stage_1_best_epoch}'\n",
    "        )\n",
    "\n",
    "        # EarlyStopping restored the best Stage-1 weights in memory.\n",
    "        # ----------------------------------------------------\n",
    "        # Stage 2: fine-tune only the final backbone layers\n",
    "        # ----------------------------------------------------\n",
    "        show_progress(f'{model_name}: Stage 2 — fine-tuning')\n",
    "        unfreeze_final_backbone_layers(backbone)\n",
    "        compile_model(model, FINE_TUNE_LEARNING_RATE)\n",
    "\n",
    "        (\n",
    "            stage_2_callbacks,\n",
    "            stage_2_checkpoint,\n",
    "            stage_2_history_path,\n",
    "            _,\n",
    "        ) = create_callbacks(model_name, seed, 'stage_2')\n",
    "\n",
    "        model.fit(\n",
    "            train_fit_ds,\n",
    "            validation_data=validation_ds,\n",
    "            initial_epoch=completed_stage_1_epochs,\n",
    "            epochs=(\n",
    "                completed_stage_1_epochs\n",
    "                + FINE_TUNE_EPOCHS\n",
    "            ),\n",
    "            class_weight=class_weights,\n",
    "            callbacks=stage_2_callbacks,\n",
    "            verbose=2,\n",
    "        )\n",
    "\n",
    "        stage_2_history = read_history_file(stage_2_history_path)\n",
    "        stage_2_best_f1 = get_best_history_metric(\n",
    "            stage_2_history,\n",
    "            'val_macro_f1',\n",
    "        )\n",
    "        stage_2_best_epoch = get_best_history_epoch(\n",
    "            stage_2_history,\n",
    "            'val_macro_f1',\n",
    "        )\n",
    "\n",
    "        show_progress(\n",
    "            f'{model_name}: Stage 2 finished; '\n",
    "            f'best val_macro_f1={stage_2_best_f1:.6f} '\n",
    "            f'at epoch {stage_2_best_epoch}'\n",
    "        )\n",
    "\n",
    "        if stage_2_best_f1 >= stage_1_best_f1:\n",
    "            selected_stage = 'stage_2'\n",
    "            selected_checkpoint = stage_2_checkpoint\n",
    "            selected_validation_f1 = stage_2_best_f1\n",
    "            selected_best_epoch = stage_2_best_epoch\n",
    "        else:\n",
    "            selected_stage = 'stage_1'\n",
    "            selected_checkpoint = stage_1_checkpoint\n",
    "            selected_validation_f1 = stage_1_best_f1\n",
    "            selected_best_epoch = stage_1_best_epoch\n",
    "\n",
    "        combined_history = combine_history_frames(\n",
    "            stage_1_history,\n",
    "            stage_2_history,\n",
    "        )\n",
    "        fine_tuning_start_epoch = completed_stage_1_epochs\n",
    "\n",
    "    else:\n",
    "        # ----------------------------------------------------\n",
    "        # Models trained from random initialisation\n",
    "        # ----------------------------------------------------\n",
    "        show_progress(f'{model_name}: single-stage scratch training')\n",
    "        compile_model(model, SCRATCH_LEARNING_RATE)\n",
    "\n",
    "        (\n",
    "            scratch_callbacks,\n",
    "            scratch_checkpoint,\n",
    "            scratch_history_path,\n",
    "            _,\n",
    "        ) = create_callbacks(model_name, seed, 'scratch')\n",
    "\n",
    "        model.fit(\n",
    "            train_fit_ds,\n",
    "            validation_data=validation_ds,\n",
    "            epochs=SCRATCH_EPOCHS,\n",
    "            class_weight=class_weights,\n",
    "            callbacks=scratch_callbacks,\n",
    "            verbose=2,\n",
    "        )\n",
    "\n",
    "        combined_history = read_history_file(scratch_history_path)\n",
    "        selected_stage = 'scratch'\n",
    "        selected_checkpoint = scratch_checkpoint\n",
    "        selected_validation_f1 = get_best_history_metric(\n",
    "            combined_history,\n",
    "            'val_macro_f1',\n",
    "        )\n",
    "        selected_best_epoch = get_best_history_epoch(\n",
    "            combined_history,\n",
    "            'val_macro_f1',\n",
    "        )\n",
    "        fine_tuning_start_epoch = 0\n",
    "\n",
    "    # Load only one selected weight file into the existing model. This avoids\n",
    "    # keeping Stage-1, Stage-2 and training models in GPU memory together.\n",
    "    show_progress(\n",
    "        f'{model_name}: loading selected {selected_stage} weights'\n",
    "    )\n",
    "    model.load_weights(selected_checkpoint)\n",
    "\n",
    "    combined_history_path = run_directory / 'combined_history.csv'\n",
    "    combined_history.to_csv(combined_history_path, index=False)\n",
    "\n",
    "    final_weights_path = run_directory / 'best_model.weights.h5'\n",
    "    model.save_weights(final_weights_path)\n",
    "\n",
    "    selection_summary = {\n",
    "        'selected_stage': selected_stage,\n",
    "        'selected_checkpoint': str(selected_checkpoint),\n",
    "        'selected_validation_macro_f1': float(\n",
    "            selected_validation_f1\n",
    "        ),\n",
    "        'selected_best_epoch': int(selected_best_epoch),\n",
    "        'fine_tuning_start_epoch': int(fine_tuning_start_epoch),\n",
    "        'combined_history_path': str(combined_history_path),\n",
    "        'best_weights_path': str(final_weights_path),\n",
    "        'stopped_early_is_successful_completion': True,\n",
    "    }\n",
    "\n",
    "    with open(\n",
    "        run_directory / 'training_selection_summary.json',\n",
    "        'w',\n",
    "        encoding='utf-8',\n",
    "    ) as file:\n",
    "        json.dump(selection_summary, file, indent=2)\n",
    "\n",
    "    show_progress(\n",
    "        f'{model_name}: training and checkpoint selection completed'\n",
    "    )\n",
    "\n",
    "    return model, combined_history, selection_summary\n",
    "\n",
    "\n",
    "save_cell_summary(\n",
    "    'cell_13_memory_safe_training',\n",
    "    {\n",
    "        'selection_metric': 'validation macro F1',\n",
    "        'test_used_for_selection': False,\n",
    "        'multiple_complete_models_loaded_simultaneously': False,\n",
    "        'final_artifact': 'best_model.weights.h5',\n",
    "    },\n",
    ")"
   ]
