    "        .transpose()\n",
    "    )\n",
    "\n",
    "    report_dataframe.to_csv(\n",
    "        run_directory\n",
    "        / f'{split_name}_classification_report.csv'\n",
    "    )\n",
    "\n",
    "    prediction_dataframe = dataframe.copy()\n",
    "\n",
    "    if len(prediction_dataframe) != len(\n",
    "        true_labels\n",
    "    ):\n",
    "        raise ValueError(\n",
    "            f'{split_name} dataframe length '\n",
    "            f'{len(prediction_dataframe)} does not match '\n",
    "            f'prediction length {len(true_labels)}.'\n",
    "        )\n",
    "\n",
    "    prediction_dataframe[\n",
    "        'true_label'\n",
    "    ] = true_labels\n",
    "\n",
    "    prediction_dataframe[\n",
    "        'predicted_label'\n",
    "    ] = predicted_labels\n",
    "\n",
    "    prediction_dataframe[\n",
    "        'predicted_class'\n",
    "    ] = [\n",
    "        class_names[index]\n",
    "        for index in predicted_labels\n",
    "    ]\n",
    "\n",
    "    prediction_dataframe[\n",
    "        'confidence'\n",
    "    ] = np.max(\n",
    "        probabilities,\n",
    "        axis=1,\n",
    "    )\n",
    "\n",
    "    prediction_dataframe[\n",
    "        'correct'\n",
    "    ] = (\n",
    "        true_labels\n",
    "        == predicted_labels\n",
    "    )\n",
    "\n",
    "    prediction_dataframe.to_csv(\n",
    "        run_directory\n",
    "        / f'{split_name}_predictions.csv',\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "    confusion_values = confusion_matrix(\n",
