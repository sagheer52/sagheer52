pe":"stream","text":["Cell 07 complete: Training system defined.\n"]}],"source":["# ============================================================\n","# CELL 07 — TRAINING AND CHECKPOINT SELECTION\n","# ============================================================\n","\n","def create_optimizer(learning_rate):\n","\n","    return tf.keras.optimizers.AdamW(\n","        learning_rate=learning_rate,\n","        weight_decay=WEIGHT_DECAY,\n","        clipnorm=1.0,\n","    )\n","\n","\n","def compile_model(model, learning_rate):\n","\n","    model.compile(\n","        optimizer=create_optimizer(learning_rate),\n","\n","        loss=SparseLabelSmoothingCrossentropy(\n","            num_classes=NUM_CLASSES,\n","            label_smoothing=LABEL_SMOOTHING,\n","        ),\n","\n","        metrics=[\n","            tf.keras.metrics.SparseCategoricalAccuracy(\n","                name=\"accuracy\"\n","            ),\n","\n","            SparseMacroF1(\n","                num_classes=NUM_CLASSES,\n","                name=\"macro_f1\",\n","            ),\n","        ],\n","\n","        steps_per_execution=1,\n","        jit_compile=False,\n","    )\n","\n","\n","def unfreeze_final_backbone_layers(backbone):\n","\n","    backbone.trainable = True\n","\n","    for layer in backbone.layers[:-FINE_TUNE_LAST_N]:\n","        layer.trainable = False\n","\n","    for layer in backbone.layers:\n","        if isinstance(\n","            layer,\n","            layers.BatchNormalization,\n","        ):\n","            layer.trainable = False\n","\n","\n","def create_callbacks(run_directory, stage):\n","\n","    checkpoint_path = (\n","        run_directory\n","        / f\"best_{stage}.weights.h5\"\n","    )\n","\n","    history_path = (\n","        run_directory\n","        / f\"{stage}_history.csv\"\n","    )\n","\n","    # This function starts a fresh stage.\n","    # Completed training is recovered separately in Cell 09.\n","    if history_path.exists():\n","        history_path.unlink()\n","\n","    callbacks = [\n","        tf.keras.callbacks.ModelCheckpoint(\n","            filepath=str(checkpoint_path),\n","            monitor=\"val_macro_f1\",\n","            mode=\"max\",\n","            save_best_only=True,\n","            save_weights_only=True,\n","            verbose=1,\n","        ),\n","\n","        tf.keras.callbacks.EarlyStopping(\n","            monitor=\"val_macro_f1\",\n","            mode=\"max\",\n","            patience=EARLY_STOPPING_PATIENCE,\n","            min_delta=0.0,\n","            restore_best_weights=True,\n","            verbose=1,\n","        ),\n","\n","        tf.keras.callbacks.ReduceLROnPlateau(\n","            monitor=\"val_macro_f1\",\n","            mode=\"max\",\n","            factor=0.5,\n","            patience=3,\n","            min_lr=1e-7,\n","            verbose=1,\n","        ),\n","\n","        tf.keras.callbacks.CSVLogger(\n","            filename=str(history_path),\n","            append=False,\n","        ),\n","\n","        tf.keras.callbacks.TerminateOnNaN(),\n","    ]\n","\n","    return (\n","        callbacks,\n","        checkpoint_path,\n","        history_path,\n","    )\n","\n","\n","def read_stage_history(history_path):\n","\n","    history_df = pd.read_csv(history_path)\n","\n","    if history_df.empty:\n","        raise ValueError(\n","            f\"Empty training history: {history_path}\"\n","        )\n","\n","    if \"epoch\" not in history_df.columns:\n","        raise ValueError(\n","            \"CSV training history lacks epoch column.\"\n","        )\n","\n","    # CSVLogger uses zero-based epoch numbering.\n","    history_df[\"epoch\"] = (\n","        history_df[\"epoch\"].astype(int) + 1\n","    )\n","\n","    return history_df\n","\n","\n","def get_best_stage_metric(history_df):\n","\n","    values = pd.to_numeric(\n","        history_df[\"val_macro_f1\"],\n","        errors=\"coerce\",\n","    )\n","\n","    if not np.isfinite(values.to_numpy()).any():\n","        raise ValueError(\n","            \"No valid validation macro F1 found.\"\n","        )\n","\n","    return float(values.max())\n","\n","\n","def train_model(\n","    model_name,\n","    model,\n","    backbone,\n","    pretrained,\n","    seed,\n","    run_directory,\n","    train_ds,\n","):\n","\n","    stage_results = []\n","\n","    show_progress(\n","        f\"Training started: {model_name}, seed={seed}\"\n","    )\n","\n","    if pretrained and backbone is not None:\n","\n","        # ------------------------------------------------\n","        # STAGE 1 — TRAIN NEW HEAD / FUSION MODULES\n","        # ------------------------------------------------\n","\n","        show_progress(\n","            f\"{model_name}: Stage 1\"\n","        )\n","\n","        backbone.trainable = False\n","\n","        compile_model(\n","            model,\n","            HEAD_LEARNING_RATE,\n","        )\n","\n","        callbacks, checkpoint, history_path = (\n","            create_callbacks(\n","                run_directory,\n","                \"stage_1\",\n","            )\n","        )\n","\n","        model.fit(\n","            train_ds,\n","            validation_data=validation_ds,\n","            epochs=HEAD_EPOCHS,\n","            class_weight=class_weights,\n","            callbacks=callbacks,\n","            verbose=2,\n","        )\n","\n","        stage_1_history = read_stage_history(\n","            history_path\n","        )\n","\n","        if not checkpoint.exists():\n","            raise FileNotFoundError(\n","                f\"Stage 1 checkpoint missing: {checkpoint}\"\n","            )\n","\n","        # Begin fine-tuning from the best stage-1 weights.\n","        model.load_weights(checkpoint)\n","\n","        stage_results.append({\n","            \"stage\": \"stage_1\",\n","            \"checkpoint\": checkpoint,\n","            \"history\": stage_1_history,\n","        })\n","\n","        completed_head_epochs = int(\n","            stage_1_history[\"epoch\"].max()\n","        )\n","\n","        # ------------------------------------------------\n","        # STAGE 2 — FINE-TUNING\n","        # ------------------------------------------------\n","\n","        show_progress(\n","            f\"{model_name}: Stage 2\"\n","        )\n","\n","        unfreeze_final_backbone_layers(\n","            backbone\n","        )\n","\n","        compile_model(\n","            model,\n","            FINE_TUNE_LEARNING_RATE,\n","        )\n","\n","        callbacks, checkpoint, history_path = (\n","            create_callbacks(\n","                run_directory,\n","                \"stage_2\",\n","            )\n","        )\n","\n","        model.fit(\n","            train_ds,\n","            validation_data=validation_ds,\n","            initial_epoch=completed_head_epochs,\n","            epochs=(\n","                completed_head_epochs\n","                + FINE_TUNE_EPOCHS\n","            ),\n","            class_weight=class_weights,\n","            callbacks=callbacks,\n","            verbose=2,\n","        )\n","\n","        stage_2_history = read_stage_history(\n","            history_path\n","        )\n","\n","        if not checkpoint.exists():\n","            raise FileNotFoundError(\n","                f\"Stage 2 checkpoint missing: {checkpoint}\"\n","            )\n","\n","        stage_results.append({\n","            \"stage\": \"stage_2\",\n","            \"checkpoint\": checkpoint,\n","            \"history\": stage_2_history,\n","        })\n","\n","        fine_tuning_start_epoch = (\n","            completed_head_epochs\n","        )\n","\n","    else:\n","\n","        # ------------------------------------------------\n","        # SCRATCH TRAINING\n","        # ------------------------------------------------\n","\n","        show_progress(\n","            f\"{model_name}: Scratch training\"\n","        )\n","\n","        compile_model(\n","            model,\n","            SCRATCH_LEARNING_RATE,\n","        )\n","\n","        callbacks, checkpoint, history_path = (\n","            create_callbacks(\n","                run_directory,\n","                \"scratch\",\n","            )\n","        )\n","\n","        model.fit(\n","            train_ds,\n","            validation_data=validation_ds,\n","            epochs=SCRATCH_EPOCHS,\n","            class_weight=class_weights,\n","            callbacks=callbacks,\n","            verbose=2,\n","        )\n","\n","        scratch_history = read_stage_history(\n","            history_path\n","        )\n","\n","        stage_results.append({\n","            \"stage\": \"scratch\",\n","            \"checkpoint\": checkpoint,\n","            \"history\": scratch_history,\n","        })\n","\n","        fine_tuning_start_epoch = 0\n","\n","    # ------------------------------------------------\n","    # SELECT BEST CHECKPOINT USING VALIDATION F1\n","    # ------------------------------------------------\n","\n","    selected = max(\n","        stage_results,\n","        key=lambda stage: get_best_stage_metric(\n","            stage[\"history\"]\n","        ),\n","    )\n","\n","    selected_checkpoint = selected[\"checkpoint\"]\n","\n","    model.load_weights(\n","        selected_checkpoint\n","    )\n","\n","    combined_history = pd.concat(\n","        [\n","            stage[\"history\"]\n","            for stage in stage_results\n","        ],\n","        ignore_index=True,\n","    )\n","\n","    combined_history = (\n","        combined_history\n","        .sort_values(\"epoch\")\n","        .reset_index(drop=True)\n","    )\n","\n","    combined_history_path = (\n","        run_directory / \"combined_history.csv\"\n","    )\n","\n","    combined_history.to_csv(\n","        combined_history_path,\n","        index=False,\n","    )\n","\n","    final_weights_path = (\n","        run_directory / \"best_model.weights.h5\"\n","    )\n","\n","    model.save_weights(\n","        final_weights_path\n","    )\n","\n","    selected_history = selected[\"history\"]\n","\n","    best_row = selected_history.loc[\n","        selected_history[\"val_macro_f1\"].idxmax()\n","    ]\n","\n","    summary = {\n","        \"selected_stage\": selected[\"stage\"],\n","        \"selected_checkpoint\": str(selected_checkpoint),\n","        \"selected_validation_macro_f1\": (\n","            get_best_stage_metric(selected_history)\n","        ),\n","        \"selected_best_epoch\": int(\n","            best_row[\"epoch\"]\n","        ),\n","        \"fine_tuning_start_epoch\": int(\n","            fine_tuning_start_epoch\n","        ),\n","        \"best_weights_path\": str(final_weights_path),\n","        \"combined_history_path\": str(\n","            combined_history_path\n","        ),\n","    }\n","\n","    with open(\n","        run_directory / \"training_selection_summary.json\",\n","        \"w\",\n","        encoding=\"utf-8\",\n","    ) as file:\n","        json.dump(\n","            summary,\n","            file,\n","            indent=2,\n","        )\n","\n","    show_progress(\n","        f\"{model_name}: selected {selected['stage']} \"\n","        f\"with validation macro F1 = \"\n","        f\"{summary['selected_validation_macro_f1']:.6f}\"\n","    )\n","\n","    return (\n","        model,\n","        combined_history,\n","        summary,\n","    )\n","\n","\n","print(\"Cell 07 complete: Training system defined.\")"]},{"cell_type":"code","execution_count":9,"id":"98886e77","metadata":{"execution":{"iopub.execute_input":"2026-10-26T16:57:44.528396Z","iopub.status.busy":"2026-10-26T16:57:44.528119Z","iopub.status.idle":"2026-10-26T16:57:44.545997Z","shell.execute_reply":"2026-10-26T16:57:44.545186Z"},"papermill":{"duration":0.025385,"end_time":"2026-10-26T16:57:44.547452+00:00","exception":false,"start_time":"2026-10-26T16:57:44.522067+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Cell 08 complete: Evaluation functions ready.\n"]}],"source":["# ============================================================\n","# CELL 08 — CLASSIFICATION EVALUATION AND FIGURES\n","# ============================================================\n","\n","def evaluate_model_split(\n","    model,\n","    dataset,\n","    split_name,\n","    dataframe,\n","    run_directory,\n","):\n","\n","    show_progress(\n","        f\"Evaluating {split_name}\"\n","    )\n","\n","    true_labels = np.concatenate(\n","        [\n","            labels.numpy()\n","            for _, labels in dataset\n","        ]\n","    )\n","\n","    probabilities = model.predict(\n","        dataset,\n","        verbose=0,\n","    )\n","\n","    if probabilities.shape != (\n","        len(dataframe),\n","        NUM_CLASSES,\n","    ):\n","        raise ValueError(\n","            f\"{split_name}: prediction shape mismatch.\"\n","        )\n","\n","    if not np.array_equal(\n","        true_labels,\n","        dataframe[\"label\"].to_numpy(),\n","    ):\n","        raise ValueError(\n","            f\"{split_name}: labels are not aligned.\"\n","        )\n","\n","    predicted_labels = np.argmax(\n","        probabilities,\n","        axis=1,\n","    )\n","\n","    precision, recall, macro_f1, _ = (\n","        precision_recall_fscore_support(\n","            true_labels,\n","            predicted_labels,\n","            average=\"macro\",\n","            zero_division=0,\n","        )\n","    )\n","\n","    weighted_precision, weighted_recall, weighted_f1, _ = (\n","        precision_recall_fscore_support(\n","            true_labels,\n","            predicted_labels,\n","            average=\"weighted\",\n","            zero_division=0,\n","        )\n","    )\n","\n","    losses = tf.keras.losses.sparse_categorical_crossentropy(\n","        true_labels,\n","        probabilities,\n","    )\n","\n","    classification_loss = float(\n","        tf.reduce_mean(losses).numpy()\n","    )\n","\n","    metrics = {\n","        f\"{split_name}_accuracy\": float(\n","            accuracy_score(\n","                true_labels,\n","                predicted_labels,\n","            )\n","        ),\n","\n","        f\"{split_name}_macro_precision\": float(\n","            precision\n","        ),\n","\n","        f\"{split_name}_macro_recall\": float(\n","            recall\n","        ),\n","\n","        f\"{split_name}_macro_f1\": float(\n","            macro_f1\n","        ),\n","\n","        f\"{split_name}_weighted_precision\": float(\n","            weighted_precision\n","        ),\n","\n","        f\"{split_name}_weighted_recall\": float(\n","            weighted_recall\n","        ),\n","\n","        f\"{split_name}_weighted_f1\": float(\n","            weighted_f1\n","        ),\n","\n","        f\"{split_name}_loss\": classification_loss,\n","    }\n","\n","    # ---------------- PREDICTION TABLE ----------------\n","\n","    predictions_df = dataframe[\n","        [\"filepath\", \"label\", \"class_name\"]\n","    ].copy()\n","\n","    predictions_df[\"true_label\"] = true_labels\n","\n","    predictions_df[\"predicted_label\"] = (\n","        predicted_labels\n","    )\n","\n","    predictions_df[\"predicted_class\"] = [\n","        class_names[int(label)]\n","        for label in predicted_labels\n","    ]\n","\n","    predictions_df[\"confidence\"] = (\n","        probabilities.max(axis=1)\n","    )\n","\n","    predictions_df[\"correct\"] = (\n","        true_labels == predicted_labels\n","    )\n","\n","    for index, class_name in enumerate(class_names):\n","        predictions_df[\n","            f\"probability_class_{index}\"\n","        ] = probabilities[:, index]\n","\n","    predictions_df.to_csv(\n","        run_directory\n","        / f\"{split_name}_predictions.csv\",\n","        index=False,\n","    )\n","\n","    # ---------------- CLASSIFICATION REPORT ----------------\n","\n","    report = classification_report(\n","        true_labels,\n","        predicted_labels,\n","        labels=list(range(NUM_CLASSES)),\n","        target_names=class_names,\n","        output_dict=True,\n","        zero_division=0,\n","    )\n","\n","    pd.DataFrame(report).T.to_csv(\n","        run_directory\n","        / f\"{split_name}_classification_report.csv\"\n","    )\n","\n","    # ---------------- CONFUSION MATRIX ----------------\n","\n","    confusion_values = confusion_matrix(\n","        true_labels,\n","        predicted_labels,\n","        labels=list(range(NUM_CLASSES)),\n","    )\n","\n","    confusion_df = pd.DataFrame(\n","        confusion_values,\n","        index=class_names,\n","        columns=class_names,\n","    )\n","\n","    confusion_df.to_csv(\n","        run_directory\n","        / f\"{split_name}_confusion_matrix.csv\"\n","    )\n","\n","    return metrics, confusion_values\n","\n","\n","def plot_training_history(\n","    model_name,\n","    history_df,\n","    fine_tuning_start_epoch,\n","    run_directory,\n","):\n","\n","    figure_specs = [\n","        (\"accuracy\", \"Accuracy\"),\n","        (\"macro_f1\", \"Macro F1\"),\n","        (\"loss\", \"Loss\"),\n","    ]\n","\n","    for metric, label in figure_specs:\n","\n","        validation_metric = f\"val_{metric}\"\n","\n","        if (\n","            metric not in history_df.columns\n","            or validation_metric not in history_df.columns\n","        ):\n","            continue\n","\n","        figure, axis = plt.subplots(\n","            figsize=(9, 6)\n","        )\n","\n","        training_values = history_df[\n","            metric\n","        ].to_numpy()\n","\n","        validation_values = history_df[\n","            validation_metric\n","        ].to_numpy()\n","\n","        multiplier = (\n","            1.0 if metric == \"loss\" else 100.0\n","        )\n","\n","        axis.plot(\n","            history_df[\"epoch\"],\n","            training_values * multiplier,\n","            label=\"Training\",\n","            linewidth=2,\n","        )\n","\n","        axis.plot(\n","            history_df[\"epoch\"],\n","            validation_values * multiplier,\n","            label=\"Validation\",\n","            linestyle=\"--\",\n","            linewidth=2,\n","        )\n","\n","        if fine_tuning_start_epoch > 0:\n","            axis.axvline(\n","                fine_tuning_start_epoch + 0.5,\n","                linestyle=\":\",\n","                label=\"Fine-tuning starts\",\n","            )\n","\n","        axis.set_title(\n","            f\"{model_name}: {label}\"\n","        )\n","\n","        axis.set_xlabel(\"Epoch\")\n","        axis.set_ylabel(label)\n","\n","        axis.grid(\n","            alpha=0.25\n","        )\n","\n","        axis.legend()\n","\n","        figure.tight_layout()\n","\n","        figure.savefig(\n","            run_directory / f\"{metric}_curve.png\",\n","            dpi=300,\n","        )\n","\n","        plt.close(figure)\n","\n","\n","def plot_confusion(\n","    model_name,\n","    confusion_values,\n","    run_directory,\n","):\n","\n","    size = max(\n","        8,\n","        int(NUM_CLASSES * 1.2),\n","    )\n","\n","    figure, axis = plt.subplots(\n","        figsize=(size, size)\n","    )\n","\n","    ConfusionMatrixDisplay(\n","        confusion_matrix=confusion_values,\n","        display_labels=class_names,\n","    ).plot(\n","        ax=axis,\n","        cmap=\"Blues\",\n","        xticks_rotation=45,\n","        colorbar=False,\n","        values_format=\"d\",\n","    )\n","\n","    axis.set_title(\n","        f\"{model_name}: Test Confusion Matrix\"\n","    )\n","\n","    figure.tight_layout()\n","\n","    figure.savefig(\n","        run_directory / \"testing_confusion_matrix.png\",\n","        dpi=300,\n","    )\n","\n","    plt.close(figure)\n","\n","\n","def calculate_efficiency_metrics(\n","    model,\n","    weights_path,\n","):\n","\n","    trainable_parameters = int(\n","        sum(\n","            np.prod(weight.shape)\n","            for weight in model.trainable_weights\n"