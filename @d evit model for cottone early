    "# ============================================================\n",
    "# CELL 15 — EFFICIENCY, SAFE LATENCY AND SCIENTIFIC PLOTS\n",
    "# ============================================================\n",
    "\n",
    "plt.style.use('default')\n",
    "plt.rcParams.update(\n",
    "    {\n",
    "        'figure.dpi': 120,\n",
    "        'font.family': 'DejaVu Sans',\n",
    "        'font.size': 10,\n",
    "        'axes.titlesize': 14,\n",
    "        'axes.titleweight': 'bold',\n",
    "        'axes.labelsize': 11,\n",
    "        'axes.labelweight': 'bold',\n",
    "        'legend.frameon': False,\n",
    "        'axes.spines.top': False,\n",
    "        'axes.spines.right': False,\n",
    "        'grid.alpha': 0.25,\n",
    "        'savefig.dpi': 600,\n",
    "        'savefig.bbox': 'tight',\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "def calculate_efficiency_metrics(\n",
    "    model: Model,\n",
    "    model_name: str,\n",
    "    seed: int,\n",
    "):\n",
    "    run_directory = (\n",
    "        MODEL_DIR\n",
    "        / clean_model_name(model_name)\n",
    "        / f'seed_{seed}'\n",
    "    )\n",
    "\n",
    "    total_parameters = int(model.count_params())\n",
    "    trainable_parameters = int(\n",
    "        np.sum(\n",
    "            [\n",
    "                np.prod(weight.shape)\n",
    "                for weight in model.trainable_weights\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "    deployment_weights_path = (\n",
    "        run_directory\n",
    "        / 'deployment_weights.weights.h5'\n",
    "    )\n",
    "    model.save_weights(deployment_weights_path)\n",
    "\n",
    "    return {\n",
    "        'total_parameters': total_parameters,\n",
    "        'trainable_parameters': trainable_parameters,\n",
    "        'weights_size_mb': float(\n",
    "            deployment_weights_path.stat().st_size\n",
    "            / (1024 ** 2)\n",
    "        ),\n",
    "    }\n",
    "\n",
    "\n",
    "def measure_inference_latency_safe(\n",
    "    model: Model,\n",
    "    dataset: tf.data.Dataset,\n",
    "    number_of_images: int = 100,\n",
    "    warmup_batches: int = 10,\n",
    "    repetitions: int = 3,\n",
    ") -> float:\n",
    "    \"\"\"Measure median latency without allowing timing failure to stop results.\"\"\"\n",
    "    try:\n",
    "        benchmark_batches = list(\n",
    "            dataset\n",
    "            .unbatch()\n",
    "            .take(number_of_images)\n",
    "            .batch(BATCH_SIZE)\n",
    "        )\n",
    "\n",
    "        if not benchmark_batches:\n",
    "            return float('nan')\n",
    "\n",
    "        @tf.function(\n",
    "            reduce_retracing=True,\n",
    "            jit_compile=False,\n",
    "        )\n",
    "        def inference_step(images):\n",
    "            return model(images, training=False)\n",
    "\n",
    "        show_progress(\n",
    "            f'Latency warm-up: {warmup_batches} batches'\n",
    "        )\n",
    "\n",
    "        for warmup_index in range(warmup_batches):\n",
    "            images, _ = benchmark_batches[\n",
    "                warmup_index % len(benchmark_batches)\n",
    "            ]\n",
    "            outputs = inference_step(images)\n",
    "            _ = outputs.numpy()  # GPU synchronisation\n",
    "\n",
    "        measurements = []\n",
    "\n",
    "        for repetition in range(repetitions):\n",
    "            processed_images = 0\n",
    "            start_time = time.perf_counter()\n",
    "\n",
    "            for images, _ in benchmark_batches:\n",
    "                outputs = inference_step(images)\n",
    "                _ = outputs.numpy()\n",
    "                processed_images += int(images.shape[0])\n",
    "\n",
    "            elapsed = time.perf_counter() - start_time\n",
    "            measurements.append(\n",
    "                elapsed / processed_images * 1000.0\n",
    "            )\n",
    "\n",
    "            print(\n",
    "                f'Latency repetition {repetition + 1}/{repetitions}: '\n",
    "                f'{measurements[-1]:.3f} ms/image',\n",
    "                flush=True,\n",
    "            )\n",
    "\n",
    "        return float(np.median(measurements))\n",
    "\n",
    "    except Exception as error:\n",
    "        print(\n",
    "            'Latency measurement failed; classification results remain '\n",
    "            f'valid and execution will continue: {error!r}',\n",
    "            flush=True,\n",
    "        )\n",
    "        return float('nan')\n",
    "\n",
    "\n",
    "def plot_history(\n",
    "    model_name: str,\n",
    "    seed: int,\n",
    "    history_dataframe: pd.DataFrame,\n",
    "    fine_tuning_start_epoch: int,\n",
    "):\n",
    "    run_directory = (\n",
    "        MODEL_DIR\n",
    "        / clean_model_name(model_name)\n",
    "        / f'seed_{seed}'\n",
    "    )\n",
    "    epochs = history_dataframe['epoch']\n",
    "\n",
    "    plt.figure(figsize=(9, 6))\n",
    "    plt.plot(\n",
    "        epochs,\n",
    "        history_dataframe['accuracy'] * 100,\n",
    "        linewidth=2.2,\n",
    "        label='Training accuracy',\n",
    "    )\n",
    "    plt.plot(\n",
    "        epochs,\n",
    "        history_dataframe['val_accuracy'] * 100,\n",
    "        linewidth=2.2,\n",
    "        linestyle='--',\n",
    "        label='Validation accuracy',\n",
    "    )\n",
    "    if fine_tuning_start_epoch > 0:\n",
    "        plt.axvline(\n",
    "            fine_tuning_start_epoch + 0.5,\n",
    "            linestyle=':',\n",
    "            label='Fine-tuning begins',\n",
    "        )\n",
    "    plt.xlabel('Epoch')\n",
    "    plt.ylabel('Accuracy (%)')\n",
    "    plt.title(f'{model_name}: Training and Validation Accuracy')\n",
    "    plt.grid(linestyle='--')\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(\n",
    "        run_directory / 'accuracy_curve.png',\n",
    "        facecolor='white',\n",
    "    )\n",
    "    plt.close()\n",
    "\n",
