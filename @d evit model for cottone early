    "        tf.keras.mixed_precision.global_policy()\n",
    "    ),\n",
    "    'optimizer_options': tf.config.optimizer.get_experimental_options(),\n",
    "    'global_jit_enabled': bool(tf.config.optimizer.get_jit()),\n",
    "}\n",
