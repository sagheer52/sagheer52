,"        )\n","    )\n","\n","    lesion_vector = layers.GlobalAveragePooling1D()(\n","        lesion_tokens\n","    )\n","\n","    vit_vector = layers.GlobalAveragePooling1D()(\n","        vit_tokens\n","    )\n","\n","    context_vector = layers.GlobalAveragePooling2D()(\n","        context\n","    )\n","\n","    fused = BalancedConcatenation()([\n","        lesion_vector,\n","        context_vector,\n","        vit_vector,\n","    ])\n","\n","    outputs = shared_classifier_head(\n","        fused, \"evit_dap_caf\"\n","    )\n","\n","    return (\n","        Model(inputs, outputs, name=\"EVit_DAP_CAF\"),\n","        backbone,\n","        pretrained,\n","    )\n","\n","\n","# ============================================================\n","# PREVIOUS PROPOSED MODEL — EVIT-CAF-D2AF (V5)\n","# ============================================================\n","\n","def build_evit_caf_d2af():\n","\n","    inputs = layers.Input(\n","        shape=(224, 224, 3),\n","        name=\"evit_caf_d2af_input\",\n","    )\n","\n","    cnn, backbone, pretrained = build_projected_cnn(\n","        inputs,\n","        \"d2af\",\n","    )\n","\n","    lesion, context, disease_mask = (\n","        MultiScaleDiseaseAreaDecoupler(\n","            hidden_dim=DAP_HIDDEN_DIM,\n","            min_area=DAP_MIN_AREA,\n","            max_area=DAP_MAX_AREA,\n","            area_loss_weight=DAP_AREA_LOSS_WEIGHT,\n","            tv_loss_weight=DAP_TV_LOSS_WEIGHT,\n","            name=\"disease_area_decoupling\",\n","        )(cnn)\n","    )\n","\n","    lesion_tokens = layers.Reshape(\n","        (-1, PROJECTION_DIM),\n","        name=\"d2af_lesion_tokens\",\n","    )(lesion)\n","\n","    lesion_scores = layers.Reshape(\n","        (-1, 1),\n","        name=\"d2af_lesion_scores\",\n","    )(disease_mask)\n","\n","    context_vector = layers.GlobalAveragePooling2D(\n","        name=\"d2af_context_pool\",\n","    )(context)\n","\n","    vit_tokens = build_vit_tokens(\n","        inputs,\n","        