    "# ============================================================\n",
    "# CELL 14 — VISIBLE ONE-PASS TRAINING, VALIDATION AND TEST EVALUATION\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "def predict_dataset(\n",
    "    model: Model,\n",
    "    dataset: tf.data.Dataset,\n",
    "    verbose: int = 1,\n",
    "):\n",
    "    true_labels = np.concatenate(\n",
    "        [\n",
    "            labels.numpy()\n",
    "            for _, labels in dataset\n",
    "        ],\n",
    "        axis=0,\n",
    "    )\n",
    "\n",
    "    probabilities = model.predict(\n",
    "        dataset,\n",
    "        verbose=verbose,\n",
    "    )\n",
    "\n",
    "    predicted_labels = np.argmax(\n",
    "        probabilities,\n",
    "        axis=1,\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        true_labels,\n",
    "        predicted_labels,\n",
    "        probabilities,\n",
    "    )\n",
    "\n",
    "\n",
    "def calculate_split_metrics(\n",
    "    model: Model,\n",
    "    dataset: tf.data.Dataset,\n",
    "    split_name: str,\n",
    "):\n",
    "    show_progress(\n",
    "        f'Evaluating {split_name} split'\n",
    "    )\n",
    "\n",
    "    (\n",
    "        true_labels,\n",
    "        predicted_labels,\n",
    "        probabilities,\n",
    "    ) = predict_dataset(\n",
    "        model,\n",
    "        dataset,\n",
    "        verbose=1,\n",
    "    )\n",
    "\n",
    "    (\n",
    "        macro_precision,\n",
    "        macro_recall,\n",
    "        macro_f1,\n",
    "        _,\n",
    "    ) = precision_recall_fscore_support(\n",
    "        true_labels,\n",
    "        predicted_labels,\n",
    "        average='macro',\n",
    "        zero_division=0,\n",
    "    )\n",
    "\n",
    "    (\n",
    "        weighted_precision,\n",
    "        weighted_recall,\n",
    "        weighted_f1,\n",
    "        _,\n",
    "    ) = precision_recall_fscore_support(\n",
    "        true_labels,\n",
    "        predicted_labels,\n",
    "        average='weighted',\n",
    "        zero_division=0,\n",
    "    )\n",
    "\n",
    "    # This is classification cross-entropy only.\n",
    "    # It excludes DAP/fusion auxiliary losses and is therefore\n",
    "    # comparable across every architecture.\n",
    "    classification_losses = (\n",
    "        tf.keras.losses\n",
    "        .sparse_categorical_crossentropy(\n",
    "            true_labels,\n",
    "            probabilities,\n",
    "        )\n",
    "    )\n",
    "\n",
    "    classification_loss = float(\n",
    "        tf.reduce_mean(\n",
    "            classification_losses\n",
    "        ).numpy()\n",
    "    )\n",
    "\n",
    "    metrics = {\n",
    "        f'{split_name}_accuracy': float(\n",
    "            accuracy_score(\n",
    "                true_labels,\n",
    "                predicted_labels,\n",
    "            )\n",
    "        ),\n",
    "        f'{split_name}_macro_precision': float(\n",
    "            macro_precision\n",
    "        ),\n",
    "        f'{split_name}_macro_recall': float(\n",
    "            macro_recall\n",
    "        ),\n",
    "        f'{split_name}_macro_f1': float(\n",
    "            macro_f1\n",
    "        ),\n",
    "        f'{split_name}_weighted_precision': float(\n",
    "            weighted_precision\n",
    "        ),\n",
    "        f'{split_name}_weighted_recall': float(\n",
    "            weighted_recall\n",
    "        ),\n",
    "        f'{split_name}_weighted_f1': float(\n",
    "            weighted_f1\n",
    "        ),\n",
    "        f'{split_name}_loss': (\n",
    "            classification_loss\n",
    "        ),\n",
    "    }\n",
    "\n",
    "    show_progress(\n",
    "        f'{split_name} evaluation finished — '\n",
    "        f'accuracy='\n",
    "        f'{metrics[f\"{split_name}_accuracy\"]:.6f}, '\n",
    "        f'macro F1='\n",
    "        f'{metrics[f\"{split_name}_macro_f1\"]:.6f}'\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        metrics,\n",
    "        true_labels,\n",
    "        predicted_labels,\n",
    "        probabilities,\n",
    "    )\n",
    "\n",
    "\n",
    "def save_classification_outputs(\n",
    "    model_name: str,\n",
    "    seed: int,\n",
    "    split_name: str,\n",
    "    dataframe: pd.DataFrame,\n",
    "    true_labels,\n",
    "    predicted_labels,\n",
    "    probabilities,\n",
    "):\n",
    "    run_directory = (\n",
    "        MODEL_DIR\n",
    "        / clean_model_name(model_name)\n",
    "        / f'seed_{seed}'\n",
    "    )\n",
    "\n",
    "    report = classification_report(\n",
    "        true_labels,\n",
    "        predicted_labels,\n",
    "        labels=list(range(NUM_CLASSES)),\n",
    "        target_names=class_names,\n",
    "        output_dict=True,\n",
    "        zero_division=0,\n",
    "    )\n",
    "\n",
    "    report_dataframe = (\n",
    "        pd.DataFrame(report)\n",
    "        .transpose()\n",
    "    )\n",
    "\n",
    "    report_dataframe.to_csv(\n",
    "        run_directory\n",
    "        / f'{split_name}_classification_report.csv'\n",
    "    )\n",
    "\n",
    "    prediction_dataframe = dataframe.copy()\n",
    "\n",
    "    if len(prediction_dataframe) != len(\n",
    "        true_labels\n",
    "    ):\n",
    "        raise ValueError(\n",
    "            f'{split_name} dataframe length '\n",
    "            f'{len(prediction_dataframe)} does not match '\n",
    "            f'prediction length {len(true_labels)}.'\n",
    "        )\n",
    "\n",
    "    prediction_dataframe[\n",
    "        'true_label'\n",
    "    ] = true_labels\n",
    "\n",
    "    prediction_dataframe[\n",
    "        'predicted_label'\n",
    "    ] = predicted_labels\n",
    "\n",
    "    prediction_dataframe[\n",
    "        'predicted_class'\n",
    "    ] = [\n",
    "        class_names[index]\n",
    "        for index in predicted_labels\n",
    "    ]\n",
    "\n",
    "    prediction_dataframe[\n",
    "        'confidence'\n",
    "    ] = np.max(\n",
    "        probabilities,\n",
    "        axis=1,\n",
    "    )\n",
    "\n",
    "    prediction_dataframe[\n",
    "        'correct'\n",
    "    ] = (\n",
    "        true_labels\n",
    "        == predicted_labels\n",
    "    )\n",
    "\n",
    "    prediction_dataframe.to_csv(\n",
    "        run_directory\n",
    "        / f'{split_name}_predictions.csv',\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "    confusion_values = confusion_matrix(\n",
    "        true_labels,\n",
    "        predicted_labels,\n",
    "        labels=list(range(NUM_CLASSES)),\n",
    "    )\n",
    "\n",
    "    confusion_dataframe = pd.DataFrame(\n",
    "        confusion_values,\n",
    "        index=class_names,\n",
    "        columns=class_names,\n",
    "    )\n",
    "\n",
    "    confusion_dataframe.to_csv(\n",
    "        run_directory\n",
    "        / f'{split_name}_confusion_matrix.csv'\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        report_dataframe,\n",
    "        confusion_dataframe,\n",
    "    )\n",
    "\n",
    "\n",
    "save_cell_summary(\n",
    "    'cell_14_evaluation_functions',\n",
    "    {\n",
    "        'splits': [\n",
    "            'training',\n",
    "            'validation',\n",
    "            'testing',\n",
    "        ],\n",
    "        'one_prediction_pass_per_split': True,\n",
    "        'loss_is_comparable_classification_cross_entropy': True,\n",
    "        'metrics': [\n",
    "            'accuracy',\n",
    "            'macro precision',\n",
    "            'macro recall',\n",
    "            'macro F1',\n",
    "            'weighted precision',\n",
    "            'weighted recall',\n",
    "            'weighted F1',\n",
    "            'classification loss',\n",
    "        ],\n",
    "    },\n",
    ")"
   ]
