    "# ============================================================\n",
    "# CELL 14 — VISIBLE ONE-PASS TRAINING, VALIDATION AND TEST EVALUATION\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "def predict_dataset(\n",
    "    model: Model,\n",
    "    dataset: tf.data.Dataset,\n",
    "    verbose: int = 1,\n",
    "):\n",
    "    true_labels = np.concatenate(\n",
    "        [\n",
    "            labels.numpy()\n",
    "            for _, labels in dataset\n",
    "        ],\n",
    "        axis=0,\n",
    "    )\n",
    "\n",
    "    probabilities = model.predict(\n",
    "        dataset,\n",
    "        verbose=verbose,\n",
    "    )\n",
    "\n",
    "    predicted_labels = np.argmax(\n",
    "        probabilities,\n",
    "        axis=1,\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        true_labels,\n",
    "        predicted_labels,\n",
    "        probabilities,\n",
    "    )\n",
    "\n",
    "\n",
    "def calculate_split_metrics(\n",
    "    model: Model,\n",
    "    dataset: tf.data.Dataset,\n",
    "    split_name: str,\n",
    "):\n",
    "    show_progress(\n",
    "        f'Evaluating {split_name} split'\n",
    "    )\n",
    "\n",
    "    (\n",
    "        true_labels,\n",
    "        predicted_labels,\n",
    "        probabilities,\n",
    "    ) = predict_dataset(\n",
    "        model,\n",
    "        dataset,\n",
    "        verbose=1,\n",
    "    )\n",
    "\n",
    "    (\n",
    "        macro_precision,\n",
    "        macro_recall,\n",
    "        macro_f1,\n",
    "        _,\n",
    "    ) = precision_recall_fscore_support(\n",
    "        true_labels,\n",
    "        predicted_labels,\n",
    "        average='macro',\n",
    "        zero_division=0,\n",
    "    )\n",
    "\n",
    "    (\n",
    "        weighted_precision,\n",
    "        weighted_recall,\n",
    "        weighted_f1,\n",
    "        _,\n",
    "    ) = precision_recall_fscore_support(\n",
    "        true_labels,\n",
    "        predicted_labels,\n",
    "        average='weighted',\n",
    "        zero_division=0,\n",
    "    )\n",
    "\n",
    "    # This is classification cross-entropy only.\n",
    "    # It excludes DAP/fusion auxiliary losses and is therefore\n",
    "    # comparable across every architecture.\n",
    "    classification_losses = (\n",
    "        tf.keras.losses\n",
    "        .sparse_categorical_crossentropy(\n",
    "            true_labels,\n",
    "            probabilities,\n",
    "        )\n",
    "    )\n",
    "\n",
    "    classification_loss = float(\n",
    "        tf.reduce_mean(\n",
    "            classification_losses\n",
    "        ).numpy()\n",
    "    )\n",
    "\n",
    "    metrics = {\n",
    "        f'{split_name}_accuracy': float(\n",
    "            accuracy_score(\n",
    "                true_labels,\n",
    "                predicted_labels,\n",
    "            )\n",
    "        ),\n",
    "        f'{split_name}_macro_precision': float(\n",
    "            macro_precision\n",
    "        ),\n",
    "        f'{split_name}_macro_recall': float(\n",
    "            macro_recall\n",
    "        ),\n",
    "        f'{split_name}_macro_f1': float(\n",
    "            macro_f1\n",
    "        ),\n",
    "        f'{split_name}_weighted_precision': float(\n",
    "            weighted_precision\n",
    "        ),\n",
    "        f'{split_name}_weighted_recall': float(\n",
    "            weighted_recall\n",
    "        ),\n",
    "        f'{split_name}_weighted_f1': float(\n",
    "            weighted_f1\n",
    "        ),\n",
    "        f'{split_name}_loss': (\n",
    "            classification_loss\n",
    "        ),\n",
    "    }\n",
    "\n",
    "    show_progress(\n",
    "        f'{split_name} evaluation finished — '\n",
    "        f'accuracy='\n",
    "        f'{metrics[f\"{split_name}_accuracy\"]:.6f}, '\n",
    "        f'macro F1='\n",
    "        f'{metrics[f\"{split_name}_macro_f1\"]:.6f}'\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        metrics,\n",
    "        true_labels,\n",
    "        predicted_labels,\n",
    "        probabilities,\n",
    "    )\n",
    "\n",
    "\n",
    "def save_classification_outputs(\n",
