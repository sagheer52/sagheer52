.DataFrame(\n","        expert_weights,\n","        columns=expert_names,\n","    )\n","\n","    expert_df.insert(\n","        0,\n","        \"filepath\",\n","        test_df[\"filepath\"].to_numpy(),\n","    )\n","\n","    expert_df.insert(\n","        1,\n","        \"true_class\",\n","        test_df[\"class_name\"].to_numpy(),\n","    )\n","\n","    expert_df.to_csv(\n","        TABLE_DIR / \"v6_expert_fusion_weights.csv\",\n","        index=False,\n","    )\n","\n","    mean_expert_weights = (\n","        expert_df[expert_names]\n","        .mean()\n","    )\n","\n","    display(\n","        mean_expert_weights.to_frame(\n","            name=\"Mean Fusion Weight\"\n","        )\n","    )\n","\n","    figure, axis = plt.subplots(\n","        figsize=(8, 5)\n","    )\n","\n","    bars = axis.bar(\n","        expert_names,\n","        mean_expert_weights.to_numpy(),\n","    )\n","\n","    axis.set_ylabel(\n","        \"Mean Fusion Weight\"\n","    )\n","\n","    axis.set_title(\n","        \"Average Contribution of the Four Fusion Experts\"\n","    )\n","\n","    axis.set_ylim(\n","        0.0,\n","        max(\n","            0.4,\n","            float(mean_expert_weights.max()) + 0.1,\n","        ),\n","    )\n","\n","    for bar, value in zip(\n","        bars,\n","        mean_expert_weights,\n","    ):\n","\n","        axis.text(\n","            bar.get_x() + bar.get_width() / 2,\n","            bar.get_height(),\n","            f\"{value:.3f}\",\n","            ha=\"center\",\n","            va=\"bottom\",\n","        )\n","\n","    figure.tight_layout()\n","\n","    figure.savefig(\n","        FIGURE_DIR / \"v6_expert_fusion_weights.png\",\n","        dpi=300,\n","    )\n","\n","    plt.show()\n","\n","    del mask_model\n","    del fusion_model\n","    del proposed_model\n","    del proposed_backbone\n","\n","    tf.keras.backend.clear_session()\n","    gc.collect()\n","\n","else:\n","\n","    print(\n","        \"V6 weights not available. \"\n","        