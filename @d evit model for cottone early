    "# ============================================================\n",
    "# CELL 12 — STABLE CALLBACKS, HEARTBEAT AND RECOVERY\n",
    "# ============================================================\n",
    "import json\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "from typing import Any, Dict, List, Optional\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import tensorflow as tf\n",
    "from tensorflow.keras import Model, layers\n",
    "\n",
    "def clean_model_name(\n",
    "    model_name: str\n",
    ") -> str:\n",
    "\n",
    "    return (\n",
    "        model_name\n",
    "        .lower()\n",
    "        .replace(\" \", \"_\")\n",
    "        .replace(\"-\", \"_\")\n",
    "    )\n",
    "\n",
    "\n",
    "def _read_existing_rows(\n",
    "    path: Path\n",
    ") -> List[Dict[str, Any]]:\n",
    "\n",
    "    if not path.exists():\n",
    "        return []\n",
    "\n",
    "    try:\n",
    "\n",
    "        return (\n",
    "            pd.read_csv(path)\n",
    "            .to_dict(orient=\"records\")\n",
    "        )\n",
    "\n",
    "    except Exception:\n",
    "\n",
    "        return []\n",
    "\n",
    "\n",
    "class EpochMetricsSaver(\n",
    "    tf.keras.callbacks.Callback\n",
    "):\n",
    "    \"\"\"\n",
    "    Save all epoch-level metrics immediately to CSV and JSON.\n",
    "    Existing epoch records are retained during resumed training.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        output_path: Path\n",
    "    ):\n",
    "\n",
    "        super().__init__()\n",
    "\n",
    "        self.output_path = Path(\n",
    "            output_path\n",
    "        )\n",
    "\n",
    "        self.output_path.parent.mkdir(\n",
    "            parents=True,\n",
    "            exist_ok=True\n",
    "        )\n",
    "\n",
    "        self.rows = _read_existing_rows(\n",
    "            self.output_path\n",
    "        )\n",
    "\n",
    "\n",
    "    def on_epoch_end(\n",
    "        self,\n",
    "        epoch,\n",
    "        logs=None\n",
    "    ):\n",
    "\n",
    "        logs = logs or {}\n",
    "\n",
    "        row = {\n",
    "            \"epoch\":\n",
    "                int(epoch + 1),\n",
    "\n",
    "            \"timestamp_utc\":\n",
    "                utc_now()\n",
    "        }\n",
    "\n",
    "        for key, value in logs.items():\n",
    "\n",
    "            try:\n",
    "\n",
    "                row[str(key)] = float(\n",
    "                    value\n",
    "                )\n",
    "\n",
    "            except (\n",
    "                TypeError,\n",
    "                ValueError\n",
    "            ):\n",
    "\n",
    "                row[str(key)] = str(\n",
    "                    value\n",
    "                )\n",
    "\n",
    "\n",
    "        # Replace an existing record for the same epoch.\n",
    "        self.rows = [\n",
    "            previous_row\n",
    "\n",
    "            for previous_row\n",
    "            in self.rows\n",
    "\n",
    "            if int(\n",
    "                previous_row.get(\n",
    "                    \"epoch\",\n",
    "                    -1\n",
    "                )\n",
    "            )\n",
    "            != int(epoch + 1)\n",
    "        ]\n",
    "\n",
    "        self.rows.append(row)\n",
    "\n",
    "        self.rows = sorted(\n",
    "            self.rows,\n",
    "            key=lambda item:\n",
    "                int(item[\"epoch\"])\n",
    "        )\n",
    "\n",
    "\n",
    "        pd.DataFrame(\n",
    "            self.rows\n",
    "        ).to_csv(\n",
    "            self.output_path,\n",
    "            index=False\n",
    "        )\n",
    "\n",
    "\n",
    "        with open(\n",
    "            self.output_path.with_suffix(\n",
    "                \".json\"\n",
    "            ),\n",
    "            \"w\",\n",
    "            encoding=\"utf-8\"\n",
    "        ) as file:\n",
    "\n",
    "            json.dump(\n",
    "                make_json_serializable(\n",
    "                    self.rows\n",
    "                ),\n",
    "                file,\n",
    "                indent=2\n",
    "            )\n",
    "\n",
    "\n",
    "class TrainingHeartbeat(\n",
    "    tf.keras.callbacks.Callback\n",
    "):\n",
    "    \"\"\"\n",
    "    Write persistent training progress to JSON.\n",
    "\n",
    "    This makes it possible to distinguish:\n",
    "    - an active run,\n",
    "    - a frozen notebook display,\n",
    "    - an interrupted Kaggle runtime.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        heartbeat_path: Path,\n",
    "        print_every_batches: int = 25\n",
    "    ):\n",
    "\n",
    "        super().__init__()\n",
    "\n",
    "        self.heartbeat_path = Path(\n",
    "            heartbeat_path\n",
    "        )\n",
    "\n",
    "        self.print_every_batches = int(\n",
    "            print_every_batches\n",
    "        )\n",
    "\n",
    "        self.current_epoch = 0\n",
    "\n",
    "        self.heartbeat_path.parent.mkdir(\n",
    "            parents=True,\n",
    "            exist_ok=True\n",
    "        )\n",
    "\n",
    "\n",
    "    def _write_status(\n",
    "        self,\n",
    "        status: str,\n",
    "        batch=None,\n",
    "        logs=None\n",
    "    ):\n",
    "\n",
    "        logs = logs or {}\n",
    "\n",
    "        saved_metrics = {}\n",
    "\n",
    "        for key, value in logs.items():\n",
    "\n",
    "            try:\n",
    "\n",
    "                saved_metrics[\n",
    "                    str(key)\n",
    "                ] = float(value)\n",
    "\n",
    "            except (\n",
    "                TypeError,\n",
    "                ValueError\n",
    "            ):\n",
    "\n",
    "                saved_metrics[\n",
    "                    str(key)\n",
    "                ] = str(value)\n",
    "\n",
    "\n",
    "        record = {\n",
    "            \"status\":\n",
    "                status,\n",
    "\n",
    "            \"timestamp_utc\":\n",
    "                utc_now(),\n",
    "\n",
    "            \"epoch\":\n",
    "                int(\n",
    "                    self.current_epoch + 1\n",
    "                ),\n",
    "\n",
    "            \"batch\":\n",
    "                (\n",
    "                    None\n",
    "\n",
    "                    if batch is None\n",
    "\n",
    "                    else int(batch + 1)\n",
    "                ),\n",
    "\n",
    "            \"metrics\":\n",
    "                saved_metrics\n",
    "        }\n",
    "\n",
    "\n",
    "        temporary_path = (\n",
    "            self.heartbeat_path\n",
    "            .with_suffix(\".tmp\")\n",
    "        )\n",
    "\n",
    "\n",
    "        with open(\n",
    "            temporary_path,\n",
    "            \"w\",\n",
    "            encoding=\"utf-8\"\n",
    "        ) as file:\n",
    "\n",
    "            json.dump(\n",
    "                record,\n",
    "                file,\n",
    "                indent=2\n",
    "            )\n",
    "\n",
    "\n",
    "        temporary_path.replace(\n",
    "            self.heartbeat_path\n",
    "        )\n",
    "\n",
    "\n",
    "    def on_train_begin(\n",
    "        self,\n",
    "        logs=None\n",
    "    ):\n",
    "\n",
    "        print(\n",
    "            \"\\n[HEARTBEAT] Training started\",\n",
    "            flush=True\n",
    "        )\n",
    "\n",
    "        self._write_status(\n",
    "            \"training_started\",\n",
    "            logs=logs\n",
    "        )\n",
    "\n",
    "\n",
    "    def on_epoch_begin(\n",
    "        self,\n",
    "        epoch,\n",
    "        logs=None\n",
    "    ):\n",
    "\n",
    "        self.current_epoch = int(\n",
    "            epoch\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            f\"\\n[HEARTBEAT] \"\n",
    "            f\"Epoch {epoch + 1} started\",\n",
    "            flush=True\n",
    "        )\n",
    "\n",
    "        self._write_status(\n",
    "            \"epoch_started\",\n",
    "            logs=logs\n",
    "        )\n",
    "\n",
    "\n",
    "    def on_train_batch_end(\n",
    "        self,\n",
    "        batch,\n",
    "        logs=None\n",
    "    ):\n",
    "\n",
    "        if (\n",
    "            (batch + 1)\n",
    "            % self.print_every_batches\n",
    "            != 0\n",
    "        ):\n",
    "\n",
    "            return\n",
    "\n",
    "\n",
    "        logs = logs or {}\n",
    "\n",
    "        loss = float(\n",
    "            logs.get(\n",
    "                \"loss\",\n",
    "                np.nan\n",
    "            )\n",
    "        )\n",
    "\n",
    "        accuracy = float(\n",
    "            logs.get(\n",
    "                \"accuracy\",\n",
    "                np.nan\n",
    "            )\n",
    "        )\n",
    "\n",
    "        macro_f1 = float(\n",
    "            logs.get(\n",
    "                \"macro_f1\",\n",
    "                np.nan\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        print(\n",
    "            f\"[HEARTBEAT] \"\n",
    "            f\"Epoch {self.current_epoch + 1}, \"\n",
    "            f\"batch {batch + 1}: \"\n",
    "            f\"loss={loss:.5f}, \"\n",
    "            f\"accuracy={accuracy:.5f}, \"\n",
    "            f\"macro_f1={macro_f1:.5f}\",\n",
    "            flush=True\n",
    "        )\n",
    "\n",
    "\n",
    "        self._write_status(\n",
    "            \"training_batch_completed\",\n",
    "            batch=batch,\n",
    "            logs=logs\n",
    "        )\n",
    "\n",
    "\n",
    "    def on_epoch_end(\n",
    "        self,\n",
    "        epoch,\n",
    "        logs=None\n",
    "    ):\n",
    "\n",
    "        print(\n",
    "            f\"[HEARTBEAT] \"\n",
    "            f\"Epoch {epoch + 1} completed\",\n",
    "            flush=True\n",
    "        )\n",
    "\n",
    "        self._write_status(\n",
    "            \"epoch_completed\",\n",
    "            logs=logs\n",
    "        )\n",
    "\n",
    "\n",
    "    def on_train_end(\n",
    "        self,\n",
    "        logs=None\n",
    "    ):\n",
    "\n",
    "        print(\n",
    "            \"[HEARTBEAT] Training call completed\",\n",
    "            flush=True\n",
    "        )\n",
    "\n",
    "        self._write_status(\n",
    "            \"training_completed\",\n",
    "            logs=logs\n",
    "        )\n",
    "\n",
    "\n",
    "def create_optimizer(\n",
    "    learning_rate: float\n",
    "):\n",
    "\n",
    "    try:\n",
    "\n",
    "        return tf.keras.optimizers.AdamW(\n",
    "            learning_rate=learning_rate,\n",
    "            weight_decay=WEIGHT_DECAY,\n",
    "            clipnorm=1.0\n",
    "        )\n",
    "\n",
    "    except AttributeError:\n",
    "\n",
    "        return tf.keras.optimizers.Adam(\n",
    "            learning_rate=learning_rate,\n",
    "            clipnorm=1.0\n",
    "        )\n",
    "\n",
    "\n",
    "def compile_model(\n",
    "    model: Model,\n",
    "    learning_rate: float\n",
    ") -> None:\n",
    "\n",
    "    model.compile(\n",
    "        optimizer=create_optimizer(\n",
    "            learning_rate\n",
    "        ),\n",
    "\n",
    "        loss=SparseLabelSmoothingCrossentropy(\n",
    "            num_classes=NUM_CLASSES,\n",
    "            label_smoothing=LABEL_SMOOTHING\n",
    "        ),\n",
    "\n",
    "        metrics=[\n",
    "            tf.keras.metrics\n",
    "            .SparseCategoricalAccuracy(\n",
    "                name=\"accuracy\"\n",
    "            ),\n",
    "\n",
    "            SparseMacroF1(\n",
    "                num_classes=NUM_CLASSES,\n",
    "                name=\"macro_f1\"\n",
    "            )\n",
    "        ],\n",
    "\n",
    "        # One compiled batch at a time.\n",
    "        steps_per_execution=1,\n",
    "\n",
    "        # Do not use XLA for these custom hybrid layers.\n",
    "        jit_compile=False\n",
    "    )\n",
    "\n",
    "\n",
    "def create_backup_and_restore_callback(\n",
    "    backup_directory: Path\n",
    "):\n",
    "\n",
    "    backup_directory = Path(\n",
    "        backup_directory\n",
    "    )\n",
    "\n",
    "    backup_directory.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "    # Current Keras versions support integer save_freq and\n",
    "    # double_checkpoint. The fallbacks support older versions.\n",
    "    try:\n",
    "\n",
    "        return tf.keras.callbacks.BackupAndRestore(\n",
    "            backup_dir=backup_directory,\n",
    "\n",
    "            # Save training state every 50 batches.\n",
    "            save_freq=50,\n",
    "\n",
    "            # Keep both current and previous recovery states.\n",
    "            double_checkpoint=True,\n",
    "\n",
    "            # Keep recovery state after interrupted execution.\n",
    "            delete_checkpoint=False\n",
    "        )\n",
    "\n",
    "    except TypeError:\n",
    "\n",
    "        try:\n",
    "\n",
    "            return tf.keras.callbacks.BackupAndRestore(\n",
    "                backup_dir=backup_directory,\n",
    "                save_freq=50,\n",
    "                delete_checkpoint=False\n",
    "            )\n",
    "\n",
    "        except TypeError:\n",
    "\n",
    "            return tf.keras.callbacks.BackupAndRestore(\n",
    "                backup_dir=backup_directory,\n",
    "                save_freq=\"epoch\"\n",
    "            )\n",
    "\n",
    "\n",
    "def create_callbacks(\n",
    "    model_name: str,\n",
    "    seed: int,\n",
    "    stage_name: str\n",
    "):\n",
    "\n",
    "    run_directory = (\n",
    "        MODEL_DIR\n",
    "        / clean_model_name(\n",
    "            model_name\n",
    "        )\n",
    "        / f\"seed_{seed}\"\n",
    "    )\n",
    "\n",
    "    run_directory.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "    checkpoint_path = (\n",
    "        run_directory\n",
    "        / f\"best_{stage_name}.weights.h5\"\n",
    "    )\n",
    "\n",
    "\n",
    "    history_path = (\n",
    "        run_directory\n",
    "        / f\"{stage_name}_history.csv\"\n",
    "    )\n",
    "\n",
    "\n",
    "    epoch_autosave_path = (\n",
    "        run_directory\n",
    "        / f\"{stage_name}_epoch_autosave.csv\"\n",
    "    )\n",
    "\n",
    "\n",
    "    heartbeat_path = (\n",
    "        run_directory\n",
    "        / f\"{stage_name}_heartbeat.json\"\n",
    "    )\n",
    "\n",
    "\n",
    "    backup_directory = (\n",
    "        run_directory\n",
    "        / f\"{stage_name}_backup\"\n",
    "    )\n",
    "\n",
    "\n",
    "    tensorboard_directory = (\n",
    "        LOG_DIR\n",
    "        / clean_model_name(\n",
    "            model_name\n",
    "        )\n",
    "        / f\"seed_{seed}\"\n",
    "        / stage_name\n",
    "    )\n",
    "\n",
    "\n",
    "    callbacks = [\n",
    "        TrainingHeartbeat(\n",
    "            heartbeat_path=heartbeat_path,\n",
    "            print_every_batches=25\n",
    "        ),\n",
    "\n",
    "        tf.keras.callbacks.ModelCheckpoint(\n",
    "            filepath=checkpoint_path,\n",
    "            monitor=\"val_macro_f1\",\n",
    "            mode=\"max\",\n",
    "            save_best_only=True,\n",
    "            save_weights_only=True,\n",
    "            verbose=1\n",
    "        ),\n",
    "\n",
    "        tf.keras.callbacks.EarlyStopping(\n",
    "            monitor=\"val_macro_f1\",\n",
    "            mode=\"max\",\n",
    "            patience=EARLY_STOPPING_PATIENCE,\n",
    "            min_delta=1e-4,\n",
    "            restore_best_weights=True,\n",
    "            verbose=1\n",
    "        ),\n",
    "\n",
    "        tf.keras.callbacks.ReduceLROnPlateau(\n",
    "            monitor=\"val_macro_f1\",\n",
    "            mode=\"max\",\n",
    "            factor=0.3,\n",
    "            patience=3,\n",
    "            min_lr=1e-7,\n",
    "            verbose=1\n",
    "        ),\n",
    "\n",
    "        # append=True is required for resumed training.\n",
    "        tf.keras.callbacks.CSVLogger(\n",
    "            filename=history_path,\n",
    "            append=True\n",
    "        ),\n",
    "\n",
    "        EpochMetricsSaver(\n",
    "            epoch_autosave_path\n",
    "        ),\n",
    "\n",
    "        tf.keras.callbacks.TensorBoard(\n",
    "            log_dir=tensorboard_directory,\n",
    "            histogram_freq=0,\n",
    "            write_graph=False,\n",
    "            update_freq=\"epoch\"\n",
    "        ),\n",
    "\n",
    "        create_backup_and_restore_callback(\n",
    "            backup_directory\n",
    "        ),\n",
    "\n",
    "        tf.keras.callbacks.TerminateOnNaN()\n",
    "    ]\n",
    "\n",
    "\n",
    "    # Keep the same four return values expected by Cell 13.\n",
    "    return (\n",
    "        callbacks,\n",
    "        checkpoint_path,\n",
    "        history_path,\n",
    "        backup_directory\n",
    "    )\n",
    "\n",
    "\n",
    "save_cell_summary(\n",
    "    \"cell_12_stable_callbacks\",\n",
    "    {\n",
    "        \"native_streaming_macro_f1\":\n",
    "            True,\n",
    "\n",
    "        \"second_validation_prediction_removed\":\n",
    "            True,\n",
    "\n",
    "        \"steps_per_execution\":\n",
    "            1,\n",
    "\n",
    "        \"weight_only_checkpoints\":\n",
    "            True,\n",
    "\n",
    "        \"early_stopping_metric\":\n",
    "            \"val_macro_f1\",\n",
    "\n",
    "        \"epoch_csv_and_json_autosave\":\n",
    "            True,\n",
    "\n",
    "        \"batch_recovery_frequency\":\n",
    "            50,\n",
    "\n",
    "        \"persistent_heartbeat\":\n",
    "            True,\n",
    "\n",
    "        \"csv_resume_append\":\n",
    "            True\n",
    "    }\n",
    ")"
   ]
