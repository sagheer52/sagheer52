    "# ============================================================\n",
    "# CELL 12 — NATIVE MACRO-F1, WEIGHT CHECKPOINTS AND AUTOSAVE\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "def clean_model_name(model_name: str) -> str:\n",
    "    return (\n",
    "        model_name\n",
    "        .lower()\n",
    "        .replace(' ', '_')\n",
    "        .replace('-', '_')\n",
    "    )\n",
    "\n",
    "\n",
    "def _read_existing_rows(path: Path) -> List[Dict[str, Any]]:\n",
    "    if not path.exists():\n",
    "        return []\n",
    "\n",
    "    try:\n",
    "        return pd.read_csv(path).to_dict(orient='records')\n",
    "    except Exception:\n",
    "        return []\n",
    "\n",
    "\n",
    "class EpochMetricsSaver(tf.keras.callbacks.Callback):\n",
    "    \"\"\"Save epoch logs to CSV and JSON immediately after every epoch.\"\"\"\n",
    "\n",
    "    def __init__(self, output_path: Path):\n",
    "        super().__init__()\n",
    "        self.output_path = output_path\n",
    "        self.rows = _read_existing_rows(output_path)\n",
    "\n",
    "    def on_epoch_end(self, epoch, logs=None):\n",
    "        logs = logs or {}\n",
    "        row = {\n",
    "            'epoch': int(epoch + 1),\n",
    "            'timestamp_utc': utc_now(),\n",
    "        }\n",
    "        row.update(\n",
    "            {\n",
    "                str(key): float(value)\n",
    "                for key, value in logs.items()\n",
    "                if np.isscalar(value)\n",
    "            }\n",
    "        )\n",
    "\n",
    "        self.rows = [\n",
    "            previous\n",
    "            for previous in self.rows\n",
    "            if int(previous.get('epoch', -1)) != int(epoch + 1)\n",
    "        ]\n",
    "        self.rows.append(row)\n",
    "        self.rows = sorted(\n",
    "            self.rows,\n",
    "            key=lambda item: int(item['epoch']),\n",
    "        )\n",
    "\n",
    "        pd.DataFrame(self.rows).to_csv(\n",
    "            self.output_path,\n",
    "            index=False,\n",
    "        )\n",
    "\n",
    "        with open(\n",
    "            self.output_path.with_suffix('.json'),\n",
    "            'w',\n",
    "            encoding='utf-8',\n",
    "        ) as file:\n",
    "            json.dump(\n",
    "                make_json_serializable(self.rows),\n",
    "                file,\n",
    "                indent=2,\n",
    "            )\n",
    "\n",
    "\n",
    "def create_optimizer(learning_rate: float):\n",
    "    try:\n",
    "        return tf.keras.optimizers.AdamW(\n",
    "            learning_rate=learning_rate,\n",
    "            weight_decay=WEIGHT_DECAY,\n",
    "            clipnorm=1.0,\n",
    "        )\n",
    "    except AttributeError:\n",
    "        return tf.keras.optimizers.Adam(\n",
    "            learning_rate=learning_rate,\n",
    "            clipnorm=1.0,\n",
    "        )\n",
    "\n",
    "\n",
    "def compile_model(model: Model, learning_rate: float) -> None:\n",
    "    model.compile(\n",
    "        optimizer=create_optimizer(learning_rate),\n",
    "        loss=SparseLabelSmoothingCrossentropy(\n",
    "            num_classes=NUM_CLASSES,\n",
    "            label_smoothing=LABEL_SMOOTHING,\n",
    "        ),\n",
    "        metrics=[\n",
    "            tf.keras.metrics.SparseCategoricalAccuracy(\n",
    "                name='accuracy'\n",
    "            ),\n",
    "            SparseMacroF1(\n",
    "                num_classes=NUM_CLASSES,\n",
    "                name='macro_f1',\n",
    "            ),\n",
    "        ],\n",
    "        # One batch per compiled execution prevents the 168/163 display\n",
    "        # artifact and makes progress/callback behaviour transparent.\n",
    "        steps_per_execution=1,\n",
    "        jit_compile=False,\n",
    "    )\n",
    "\n",
    "\n",
    "def create_backup_and_restore_callback(backup_directory: Path):\n",
    "    try:\n",
    "        return tf.keras.callbacks.BackupAndRestore(\n",
    "            backup_dir=backup_directory,\n",
    "            save_freq='epoch',\n",
    "            delete_checkpoint=True,\n",
    "        )\n",
    "    except TypeError:\n",
    "        return tf.keras.callbacks.BackupAndRestore(\n",
    "            backup_dir=backup_directory,\n",
    "            save_freq='epoch',\n",
    "        )\n",
    "\n",
    "\n",
    "def create_callbacks(\n",
    "    model_name: str,\n",
    "    seed: int,\n",
    "    stage_name: str,\n",
    "):\n",
    "    run_directory = (\n",
    "        MODEL_DIR\n",
    "        / clean_model_name(model_name)\n",
    "        / f'seed_{seed}'\n",
    "    )\n",
    "    run_directory.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    checkpoint_path = (\n",
    "        run_directory\n",
    "        / f'best_{stage_name}.weights.h5'\n",
    "    )\n",
    "    history_path = (\n",
    "        run_directory\n",
    "        / f'{stage_name}_history.csv'\n",
    "    )\n",
    "    epoch_autosave_path = (\n",
    "        run_directory\n",
    "        / f'{stage_name}_epoch_autosave.csv'\n",
    "    )\n",
    "    backup_directory = (\n",
    "        run_directory\n",
    "        / f'{stage_name}_backup'\n",
    "    )\n",
    "    tensorboard_directory = (\n",
    "        LOG_DIR\n",
    "        / clean_model_name(model_name)\n",
    "        / f'seed_{seed}'\n",
    "        / stage_name\n",
    "    )\n",
    "\n",
    "    callbacks = [\n",
    "        tf.keras.callbacks.ModelCheckpoint(\n",
    "            filepath=checkpoint_path,\n",
    "            monitor='val_macro_f1',\n",
    "            mode='max',\n",
    "            save_best_only=True,\n",
    "            save_weights_only=True,\n",
    "            verbose=1,\n",
    "        ),\n",
    "        tf.keras.callbacks.EarlyStopping(\n",
    "            monitor='val_macro_f1',\n",
    "            mode='max',\n",
    "            patience=EARLY_STOPPING_PATIENCE,\n",
    "            min_delta=1e-4,\n",
    "            restore_best_weights=True,\n",
    "            verbose=1,\n",
    "        ),\n",
    "        tf.keras.callbacks.ReduceLROnPlateau(\n",
    "            monitor='val_macro_f1',\n",
    "            mode='max',\n",
    "            factor=0.3,\n",
    "            patience=3,\n",
    "            min_lr=1e-7,\n",
    "            verbose=1,\n",
    "        ),\n",
    "        tf.keras.callbacks.CSVLogger(\n",
    "            filename=history_path,\n",
    "            append=False,\n",
    "        ),\n",
    "        EpochMetricsSaver(epoch_autosave_path),\n",
    "        tf.keras.callbacks.TensorBoard(\n",
    "            log_dir=tensorboard_directory,\n",
    "            histogram_freq=0,\n",
    "            write_graph=False,\n",
    "        ),\n",
    "        create_backup_and_restore_callback(\n",
    "            backup_directory\n",
    "        ),\n",
    "        tf.keras.callbacks.TerminateOnNaN(),\n",
    "    ]\n",
    "\n",
    "    return (\n",
    "        callbacks,\n",
    "        checkpoint_path,\n",
    "        history_path,\n",
    "        backup_directory,\n",
    "    )\n",
    "\n",
    "\n",
    "save_cell_summary(\n",
    "    'cell_12_stable_callbacks',\n",
    "    {\n",
